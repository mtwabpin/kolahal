---
/**
 * Starlight Hero override: the title, tagline and actions open the home page's scroll tour
 * (HomeTour), with the simulated phone beside them.
 */
import { LinkButton } from '@astrojs/starlight/components';
import HomeTour from './HomeTour.astro';
import { APK, DIRECT_DOWNLOADS, PLAY_APK, VERSION } from '../release';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
// Action links are written site-absolute (`/reference/commands/`), like the Markdown links.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (href.startsWith('/') && !href.startsWith('//') ? base + href : href);
---

<div class="hero">
	<HomeTour>
		<div class="stack" slot="intro">
			<div class="copy">
				<p class="kicker">── a launcher for Android ──</p>
				<h1 id="_top" data-page-title set:html={title} />
				{tagline && <div class="tagline" set:html={tagline} />}
			</div>
			<div class="get">
				<div class="actions">
					{DIRECT_DOWNLOADS ? (
						<LinkButton href={APK} icon="download" iconPlacement="start">Download the APK</LinkButton>
					) : (
						<LinkButton href={withBase('/getting-started/play-testing/')} icon="right-arrow">Join the alpha test</LinkButton>
					)}
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton href={withBase(href)} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
						</LinkButton>
					))}
				</div>
				{DIRECT_DOWNLOADS ? (
					<p class="note">
						Kolahal {VERSION} · Android 9 or newer · the <a href={PLAY_APK}>Play build</a> if Play Protect blocks this one
					</p>
				) : (
					<p class="note">Kolahal {VERSION} · Android 9 or newer · in alpha testing on Google Play</p>
				)}
			</div>
		</div>
	</HomeTour>
</div>

<style>
	.stack {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}
	.copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: flex-start;
	}
	/* Like the log's "── 2 new since you left ──" */
	.kicker {
		font-family: var(--sl-font-mono);
		font-weight: 700;
		color: var(--k-prompt);
		font-size: var(--sl-text-sm);
		margin: 0;
	}
	h1 {
		font-family: var(--sl-font-mono);
		font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 4.5vw), 3.5rem);
		line-height: 1.12;
		font-weight: 700;
		letter-spacing: -0.04em;
		color: var(--sl-color-white);
		margin: 0;
		text-wrap: balance;
	}
	/* The prompt's caret after the title. */
	h1::after {
		content: '';
		display: inline-block;
		width: 0.5em;
		height: 0.95em;
		margin-inline-start: 0.15em;
		vertical-align: -0.1em;
		background: var(--k-prompt);
		animation: blink 1.2s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-1);
		max-width: 34ch;
	}
	.actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.get {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.note {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin: 0;
	}
	.note a {
		color: var(--k-link);
	}
	@media (min-width: 50rem) and (max-width: 72rem) {
		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 3.4vw), 3rem);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		h1::after {
			animation: none;
		}
	}
</style>
