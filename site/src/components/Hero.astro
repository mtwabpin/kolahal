---
/**
 * Starlight Hero override: the title, tagline and actions beside the demo of Kolahal's home screen.
 */
import { LinkButton } from '@astrojs/starlight/components';
import TerminalDemo from './TerminalDemo.astro';
import { APK, PLAY_APK, VERSION } from '../release';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
// Action links are written site-absolute (`/reference/commands/`), like the Markdown links.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (href.startsWith('/') && !href.startsWith('//') ? base + href : href);
---

<div class="hero">
	<div class="demo"><TerminalDemo /></div>
	<div class="stack">
		<div class="copy">
			<p class="kicker">── a launcher for Android ──</p>
			<h1 id="_top" data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		<div class="get">
			<div class="actions">
				<LinkButton href={APK} icon="download" iconPlacement="start">Download the APK</LinkButton>
				{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
					<LinkButton href={withBase(href)} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
						{text}
					</LinkButton>
				))}
			</div>
			<p class="note">
				Kolahal {VERSION} · Android 9 or newer · the <a href={PLAY_APK}>Play build</a> if Play Protect blocks this one
			</p>
		</div>
	</div>
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: 100%;
		align-items: center;
		gap: 2.5rem;
		padding-block: 1rem 2rem;
	}
	.stack {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		text-align: center;
	}
	.copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}
	/* Like the log's "── 2 new since you left ──" */
	.kicker {
		font-family: var(--sl-font-mono);
		font-weight: 700;
		color: var(--k-prompt);
		font-size: var(--sl-text-sm);
		margin: 0;
	}
	h1 {
		font-family: var(--sl-font-mono);
		font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 4.5vw), 3.5rem);
		line-height: 1.12;
		font-weight: 700;
		letter-spacing: -0.04em;
		color: var(--sl-color-white);
		margin: 0;
	}
	.tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-1);
		max-width: 46ch;
	}
	.actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.get {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.note {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		margin: 0;
	}
	.note a {
		color: var(--k-link);
	}
	.demo {
		order: 2;
	}
	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: 6fr 5fr;
			gap: 3rem;
			padding-block: clamp(2.5rem, calc(1rem + 6vmin), 5rem);
		}
		.stack {
			text-align: start;
			order: 1;
		}
		.copy {
			align-items: flex-start;
		}
		.actions {
			justify-content: flex-start;
		}
	}
</style>
