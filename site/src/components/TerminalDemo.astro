---
/**
 * Kolahal's home screen, drawn the way the app draws it (ui/LogView.kt, LogLineText.kt,
 * RichText.kt, SuggestionList.kt, Prompt.kt), in the site's theme: the app's green theme, dark or
 * light. The defaults of 0.5: no header, the suggestion list with icons, `log.time groups`.
 *
 * The HTML is the last frame: what you see without JavaScript or with reduced motion.
 * The script plays it step by step: typing, suggestions, Enter, the answer in the log.
 *
 * What it shows is what the app does:
 * - `ma`: Maps is the best match (bottom row, with the bar and ↵), then the `maps` command, then
 *   Gmail. Enter opens Maps and logs "Launched Maps".
 * - `= 5 km in mi`: the answer row shows while typing; the log shows it as a big number.
 * - `weather` (a library script command): its title, then big numbers (`fmt.stats`).
 * - `lobsters` on its timer: links, tags, muted points, a small gap between items.
 * Older groups dim when a new command runs (`log.dim`).
 */

// Icons from the app's drawables (24 × 24 viewport).
const TERMINAL = 'M5,7 L10,12 L5,17 M12,17 L19,17';
const CODE = 'M9.4,16.6L4.8,12l4.6,-4.6L8,6l-6,6 6,6 1.4,-1.4zM14.6,16.6l4.6,-4.6 -4.6,-4.6L16,6l6,6 -6,6 -1.4,-1.4z';
const RETURN = 'M19 7v4H5.83l3.58-3.59L8 6l-6 6 6 6 1.41-1.41L5.83 13H21V7z';
const CLOSE = 'M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z';
const KEYBOARD =
	'M20,5H4c-1.1,0 -1.99,0.9 -1.99,2L2,17c0,1.1 0.9,2 2,2h16c1.1,0 2,-0.9 2,-2V7c0,-1.1 -0.9,-2 -2,-2zM11,8h2v2h-2V8zM11,11h2v2h-2v-2zM8,8h2v2H8V8zM8,11h2v2H8v-2zM7,13H5v-2h2v2zM7,10H5V8h2v2zM16,17H8v-2h8v2zM16,13h-2v-2h2v2zM16,10h-2V8h2v2zM19,13h-2v-2h2v2zM19,10h-2V8h2v2z';

/**
 * Suggestion rows for each text in the prompt (Completer.suggestions). The first row is the
 * bottom one, nearest the thumb; `enter` marks the row that Enter acts on.
 * kind: app (its icon), cmd (the terminal icon), script (the code icon).
 */
type Row = { label: string; kind: 'app' | 'cmd' | 'script'; icon?: string; help?: string; enter?: boolean };
const maps: Row = { label: 'Maps', kind: 'app', icon: 'maps', enter: true };
const weatherHelp = 'Current weather: weather [city] (default: its city option, or your location)';
const lists: { for: string[]; rows: Row[] }[] = [
	{
		for: ['m'],
		rows: [
			maps,
			{ label: 'maps', kind: 'cmd', help: 'Find a place in your maps app' },
			{ label: 'media', kind: 'cmd', help: 'Now playing, or control it (needs notification access)' },
			{ label: 'mp', kind: 'cmd', help: 'Play / pause media' },
			{ label: 'Messages', kind: 'app', icon: 'messages' },
			{ label: 'Gmail', kind: 'app', icon: 'mail' },
		],
	},
	{
		for: ['ma'],
		rows: [maps, { label: 'maps', kind: 'cmd', help: 'Find a place in your maps app' }, { label: 'Gmail', kind: 'app', icon: 'mail' }],
	},
	{ for: ['= 5 km in m'], rows: [{ label: '5 km = 5,000 m', kind: 'cmd', help: 'the answer · tap to continue from it' }] },
	{ for: ['= 5 km in mi'], rows: [{ label: '5 km = 3.1069 mi', kind: 'cmd', help: 'the answer · tap to continue from it' }] },
	{
		for: ['w'],
		rows: [
			{ label: 'WhatsApp', kind: 'app', icon: 'chat', enter: true },
			{ label: 'weather', kind: 'script', help: weatherHelp },
			{ label: 'wallpaper', kind: 'cmd', help: "match: set the home screen wallpaper to this theme's colour" },
			{ label: 'widget', kind: 'cmd', help: 'Pick a widget to add to the widgets page' },
		],
	},
	{ for: ['we', 'wea', 'weat', 'weath', 'weathe'], rows: [{ label: 'weather', kind: 'script', help: weatherHelp }] },
	{ for: ['weather'], rows: [{ label: 'weather', kind: 'script', help: weatherHelp, enter: true }] },
];

/** Plain app icons (not the real apps' logos): a colour and a shape. */
const APP_ICONS: Record<string, { bg: string; path: string }> = {
	maps: { bg: '#2e9e5b', path: 'M12 5.5a4.5 4.5 0 0 0-4.5 4.5c0 3.4 4.5 8.5 4.5 8.5s4.5-5.1 4.5-8.5A4.5 4.5 0 0 0 12 5.5zm0 6.2a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4z' },
	mail: { bg: '#d4493f', path: 'M6 7.5h12a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1zm.6 1.6v.3L12 13l5.4-3.6v-.3L12 12.6z' },
	messages: { bg: '#3d7be0', path: 'M6.5 6.5h11a1.5 1.5 0 0 1 1.5 1.5v6.5a1.5 1.5 0 0 1-1.5 1.5H10l-3.5 2.5V16h0a1.5 1.5 0 0 1-1.5-1.5V8a1.5 1.5 0 0 1 1.5-1.5z' },
	chat: { bg: '#2fae62', path: 'M12 5.5a6.5 6.5 0 0 0-5.6 9.8L5.5 18.5l3.3-.9A6.5 6.5 0 1 0 12 5.5z' },
};
---

<figure class="kd" data-kd>
	<div class="kd-phone" aria-hidden="true">
		<svg width="0" height="0" class="kd-defs">
			<symbol id="kd-terminal" viewBox="0 0 24 24"><path d={TERMINAL} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></symbol>
			<symbol id="kd-code" viewBox="0 0 24 24"><path d={CODE} fill="currentColor"></path></symbol>
			<symbol id="kd-return" viewBox="0 0 24 24"><path d={RETURN} fill="currentColor"></path></symbol>
			<symbol id="kd-close" viewBox="0 0 24 24"><path d={CLOSE} fill="currentColor"></path></symbol>
			<symbol id="kd-keyboard" viewBox="0 0 24 24"><path d={KEYBOARD} fill="currentColor"></path></symbol>
			{Object.entries(APP_ICONS).map(([name, { bg, path }]) => (
				<symbol id={`kd-app-${name}`} viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill={bg}></circle><path d={path} fill="#fff"></path></symbol>
			))}
		</svg>

		<div class="kd-status"><span data-kd-clock>8:03</span><span class="kd-sys"><i class="kd-wifi"></i><i class="kd-bat"></i>82%</span></div>

		<div class="kd-screen">
			<div class="kd-log">
				<!-- A background run of hn, from before you came back: unread, with the divider. -->
				<div class="kd-group dim" data-step="0">
					<div class="kd-unread">── 2 new since you left ──</div>
					<div class="kd-ln script">
						<span class="kd-x kd-hang"><b class="kd-bul">• </b><span class="link">Show HN: A terminal launcher for Android</span><span class="mu"> · 214 points · </span><span class="link u">88 comments</span><span class="mu"> · hn</span></span>
						<span class="kd-t">7:58</span>
					</div>
					<div class="kd-ln script gap">
						<span class="kd-x kd-hang"><b class="kd-bul">• </b><span class="link">Lua 5.4 in 200 lines</span><span class="mu"> · 132 points · </span><span class="link u">41 comments</span></span>
					</div>
				</div>

				<div class="kd-group dim" data-step="1">
					<div class="kd-ln"><span class="kd-x"><b class="kd-p">$ </b><b>ma</b></span><span class="kd-t">8:02</span></div>
					<div class="kd-ln"><span class="kd-x info">Launched Maps</span></div>
				</div>

				<div class="kd-group dim" data-step="2">
					<div class="kd-ln"><span class="kd-x"><b class="kd-p">$ </b><b>= 5 km in mi</b></span><span class="kd-t">8:02</span></div>
					<div class="kd-ln">
						<span class="kd-x"><span class="kd-stats"><span><b>3.1069 mi</b><small>5 km</small></span></span></span>
					</div>
				</div>

				<div class="kd-group" data-step="3">
					<div class="kd-ln"><span class="kd-x"><b class="kd-p">$ </b><b>weather</b></span><span class="kd-t">8:03</span></div>
					<div class="kd-ln script" data-step="3.5">
						<span class="kd-x">
							<b class="script">Pune</b>
							<span class="kd-stats">
								<span><b>27°C</b><small>☀️ Sunny</small></span>
								<span><b>36%</b><small>humidity</small></span>
								<span><b>← 9 km/h</b><small>wind</small></span>
								<span><b>3</b><small>UV</small></span>
							</span>
						</span>
					</div>
				</div>

				<!-- lobsters on its timer: it arrives after the last command, so it isn't dimmed. -->
				<div class="kd-group" data-step="4">
					<div class="kd-ln script">
						<span class="kd-x"><span class="link">Zig 0.15 released</span> <span class="kd-tag">zig</span> <span class="kd-tag">release</span><span class="mu"> · 37 points · </span><span class="link u">12 comments</span><span class="mu"> · lobsters</span></span>
						<span class="kd-t">8:03</span>
					</div>
					<div class="kd-ln script gap">
						<span class="kd-x"><span class="link">Writing a tiny Lua sandbox</span> <span class="kd-tag">lua</span><span class="mu"> · 21 points · </span><span class="link u">4 comments</span></span>
					</div>
				</div>
			</div>

			<div class="kd-suggestions">
				{lists.map((list) => (
					<div class="kd-list" data-for={JSON.stringify(list.for)} hidden>
						{list.rows.map((row) => (
							<div class:list={['kd-row', { enter: row.enter }]}>
								{row.kind === 'app' ? (
									<svg class="kd-icon"><use href={`#kd-app-${row.icon}`} /></svg>
								) : (
									<svg class="kd-icon kd-accent"><use href={row.kind === 'script' ? '#kd-code' : '#kd-terminal'} /></svg>
								)}
								<span class="kd-label">{row.label}</span>
								{row.help && <span class="kd-help">{row.help}</span>}
								{row.enter && <svg class="kd-ret"><use href="#kd-return" /></svg>}
							</div>
						))}
					</div>
				))}
			</div>

			<div class="kd-prompt">
				<b class="kd-p">$</b>
				<span class="kd-input"><span data-kd-typed></span><span class="kd-cursor"></span></span>
				<svg class="kd-btn" data-kd-clear hidden><use href="#kd-close" /></svg>
				<svg class="kd-btn"><use href="#kd-keyboard" /></svg>
			</div>

			<!-- Maps opening over home, for a moment, after Enter. -->
			<div class="kd-app" data-kd-app><svg><use href="#kd-app-maps" /></svg></div>
		</div>
		<div class="kd-handle"></div>
	</div>

	<figcaption class="kd-caption">
		<span class="kd-step" data-kd-step></span>
		<span class="kd-text" data-kd-text>Type, press Enter, and the answer lands in the log.</span>
		<button type="button" class="kd-pause" data-kd-pause hidden aria-pressed="false">Pause</button>
	</figcaption>
	<p class="sr-only">
		An animation of Kolahal's home screen. Typing "ma" lists Maps, the maps command and Gmail above the prompt;
		Enter opens Maps. Typing "= 5 km in mi" shows the answer, 3.1069 mi, as a big number. The weather command
		shows Pune at 27°C with humidity, wind and UV. New Lobsters stories arrive with their tags.
	</p>
</figure>

<script>
	/*
	 * Plays the demo. Each step types into the prompt, shows the suggestion list for each text,
	 * presses Enter, then shows the step's lines in the log. It pauses off screen, in a hidden tab
	 * and with the Pause button. With reduced motion, it doesn't run: the last frame stays.
	 */
	const SCRIPT: { caption: string; type?: string; after?: string; run?: string[]; open?: boolean; wait?: string; then?: string[] }[] = [
		{ caption: 'Type a few letters of an app. Suggestions appear above the prompt.', type: 'ma', after: 'The best match is at the bottom, nearest your thumb. Enter opens it.', run: ['1'], open: true },
		{ caption: '= is a calculator and a unit converter. The answer shows as you type.', type: '= 5 km in mi', after: 'Enter puts the answer in the log, large.', run: ['2'] },
		{ caption: 'Script commands complete like built-in ones.', type: 'weather', after: 'weather.lua asks wttr.in…', run: ['3'], wait: 'Its answer: a title and big numbers (fmt.stats).', then: ['3.5'] },
		{ caption: 'Scripts on timers post in the background: links, tags, a small gap between items.', then: ['4'] },
	];

	for (const root of document.querySelectorAll<HTMLElement>('[data-kd]')) play(root);

	function play(root: HTMLElement) {
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const typed = $<HTMLElement>('[data-kd-typed]');
		const clear = $<SVGElement>('[data-kd-clear]');
		const clock = $<HTMLElement>('[data-kd-clock]');
		const app = $<HTMLElement>('[data-kd-app]');
		const stepLabel = $<HTMLElement>('[data-kd-step]');
		const text = $<HTMLElement>('[data-kd-text]');
		const pause = $<HTMLButtonElement>('[data-kd-pause]');
		const lists = [...root.querySelectorAll<HTMLElement>('.kd-list')];
		const parts = [...root.querySelectorAll<HTMLElement>('[data-step]')];

		let paused = false;
		let visible = true;
		pause.hidden = false;
		pause.addEventListener('click', () => {
			paused = !paused;
			pause.textContent = paused ? 'Play' : 'Pause';
			pause.setAttribute('aria-pressed', String(paused));
		});
		new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);

		/** Waits [ms] of playing time: the clock stops while paused, hidden or off screen. */
		async function wait(ms: number) {
			while (ms > 0) {
				await new Promise((r) => setTimeout(r, 50));
				if (!paused && visible && !document.hidden) ms -= 50;
			}
		}

		function say(n: number, caption: string) {
			stepLabel.textContent = `${n}/${SCRIPT.length}`;
			text.textContent = caption;
		}

		function setPrompt(value: string) {
			typed.textContent = value;
			clear.toggleAttribute('hidden', value === '');
			for (const list of lists) list.hidden = !(JSON.parse(list.dataset.for!) as string[]).includes(value);
		}

		/** Shows the lines of step [id]. A command dims every group above it, as log.dim does. */
		function show(id: string, command: boolean) {
			const part = parts.find((p) => p.dataset.step === id)!;
			if (command) for (const p of parts) if (p.classList.contains('shown') && p.classList.contains('kd-group')) p.classList.add('dim');
			part.classList.add('shown', 'enter');
			part.classList.remove('dim');
		}

		function reset() {
			for (const p of parts) p.classList.remove('shown', 'dim', 'enter');
			show('0', false);
			clock.textContent = '8:02';
			setPrompt('');
		}

		async function type(value: string) {
			for (let i = 1; i <= value.length; i++) {
				setPrompt(value.slice(0, i));
				// A person types in bursts: a little slower after a space.
				await wait(value[i - 1] === ' ' ? 210 : 95 + Math.random() * 80);
			}
		}

		async function enter() {
			const row = lists.find((l) => !l.hidden)?.querySelector('.kd-row.enter');
			row?.classList.add('pressed');
			await wait(220);
			row?.classList.remove('pressed');
			setPrompt('');
		}

		async function loop() {
			root.classList.add('playing');
			for (;;) {
				reset();
				await wait(1600);
				for (const [i, step] of SCRIPT.entries()) {
					say(i + 1, step.caption);
					if (step.type) {
						await wait(500);
						await type(step.type);
						if (step.after) say(i + 1, step.after);
						await wait(1700);
						await enter();
					}
					if (i === 2) clock.textContent = '8:03';
					for (const id of step.run ?? []) show(id, true);
					if (step.open) {
						app.classList.add('open');
						await wait(1100);
						app.classList.remove('open');
						say(i + 1, 'Back home, the log keeps a line for it.');
					}
					if (step.then) {
						if (step.wait) say(i + 1, step.wait);
						await wait(step.run ? 900 : 1200);
						for (const id of step.then) show(id, false);
					}
					await wait(2600);
				}
				await wait(2500);
				root.classList.add('fading');
				await wait(500);
				root.classList.remove('fading');
			}
		}
		loop();
	}
</script>

<style>
	/*
	 * Sizes follow the app at font size 14 sp, scaled to a 12.5 px font (× 0.89): a line is at least
	 * 22 dp tall, a suggestion row 44 dp, the prompt 40 dp.
	 */
	.kd {
		margin: 0;
		/* Less than the full width: the phone's 8 px frame stays inside the page. */
		width: min(100% - 1.25rem, 22.5rem);
		margin-inline: auto;
		text-align: start;
	}
	.kd-phone {
		position: relative;
		background: var(--k-bg);
		color: var(--k-fg);
		font-family: var(--sl-font-mono);
		font-size: 12.5px;
		line-height: 1.36;
		border-radius: 2rem;
		padding: 0.7rem 0 0.4rem;
		box-shadow:
			0 0 0 0.5rem var(--k-surface),
			0 0 0 calc(0.5rem + 1px) color-mix(in srgb, var(--k-dim) 30%, transparent),
			0 2rem 4rem -2rem rgb(0 0 0 / 0.55);
		overflow: hidden;
		transition: opacity 0.5s;
	}
	.kd.fading .kd-phone {
		opacity: 0;
	}
	.kd-defs {
		position: absolute;
	}

	/* Android's status bar */
	.kd-status {
		display: flex;
		justify-content: space-between;
		padding: 0 1.4rem 0.5rem;
		font: 600 11px/1 var(--sl-font-system);
	}
	.kd-sys {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.kd-wifi {
		width: 0.7rem;
		height: 0.6rem;
		background: currentColor;
		clip-path: polygon(0 0, 100% 0, 50% 100%);
	}
	.kd-bat {
		width: 0.45rem;
		height: 0.75rem;
		border-radius: 1.5px;
		background: linear-gradient(to top, currentColor 82%, color-mix(in srgb, currentColor 35%, transparent) 82%);
	}

	/* The screen has a fixed height: the suggestions take room from the log, as on the phone. */
	.kd-screen {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 27rem;
	}
	/* The log keeps its newest line at the bottom; older lines leave at the top. */
	.kd-log {
		flex: 1;
		min-height: 0;
		padding-inline: 12px;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		overflow: hidden;
	}
	/* log.spacing: 5 dp above each group */
	.kd-group {
		padding-top: 4.5px;
	}
	/* The app dims to 0.62 (log.dim). In the small demo, muted text then fades out, so dim less. */
	.kd-group.dim {
		opacity: 0.8;
	}
	.playing [data-step]:not(.shown) {
		display: none;
	}
	.playing .enter {
		animation: kd-in 0.18s ease-out;
	}
	@keyframes kd-in {
		from {
			opacity: 0;
		}
	}

	/* One log line: the 2 dp gutter bar at 45 %, 10 dp of room, the time on the right. */
	.kd-ln {
		position: relative;
		display: flex;
		gap: 7px;
		min-height: 19.5px;
		padding: 2.5px 0 2.5px 9px;
	}
	.kd-ln::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: 2px;
		background: color-mix(in srgb, var(--kd-gutter, var(--k-prompt)) 45%, transparent);
	}
	.kd-ln.script {
		--kd-gutter: var(--k-script);
	}
	/* log.item-spacing: the gap is inside the line, so the bar runs through it. */
	.kd-ln.gap {
		padding-top: calc(2.5px + 4.5px);
	}
	.kd-x {
		flex: 1;
		min-width: 0;
	}
	/* Wrapped lines start under the text, past the bullet. */
	.kd-hang {
		padding-inline-start: 2ch;
		text-indent: -2ch;
	}
	.kd-t {
		color: var(--k-dim);
		font-size: 0.857em;
		padding-top: 0.12em;
	}
	.kd-p {
		color: var(--k-prompt);
	}
	.kd-bul {
		color: var(--k-prompt);
	}
	.kd-unread {
		color: var(--k-prompt);
		font-weight: 700;
		font-size: 0.93em;
		padding: 12px 0 2px;
	}
	b {
		font-weight: 700;
	}
	.info {
		color: var(--k-info);
	}
	.link {
		color: var(--k-link);
	}
	.u {
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.mu {
		color: var(--k-dim);
	}
	.script {
		color: var(--k-script);
	}
	/* fmt.tag: bold, 0.82 em, on a chip of its colour (24 % dark, 14 % light) */
	.kd-tag {
		font-weight: 700;
		font-size: 0.82em;
		color: var(--k-dim);
		background: color-mix(in srgb, var(--k-dim) var(--k-chip), transparent);
		border-radius: 4px;
		padding: 0 3px;
	}
	/* fmt.stats: the first value 1.9 ×, the others 1.3 ×, labels in the phone's font */
	.kd-stats {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 5px 16px;
		padding: 3.5px 0 2px;
	}
	.kd-stats b {
		display: block;
		color: var(--k-fg);
