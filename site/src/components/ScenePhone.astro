---
/**
 * The stand-in for the hero's phone until its capture is there (CAPTURES.md, shots/hero/): Kolahal's
 * home over a scene, drawn in HTML. Props: `scene`, a tall render of the shader (assets/scenes/);
 * `name`, the shader's name, which the last command turned on; `light`, whether the app is in the
 * light version of its theme.
 *
 * It is drawn from the app's code: a screen 360 dp across, and the app's sizes in dp (14 sp text,
 * 22 dp log lines with the 2 dp bar, 5 dp between groups, the 40 dp prompt; ui/home/LogView.kt,
 * Prompt.kt, TerminalHeader.kt). The keyboard is down, as it is when you look at a scene, so the
 * prompt has no caret. The colors are the app's rose-pine theme (ui/theme/Theme.kt, Palettes.rosePine
 * and rosePineLight).
 */
import { getImage } from 'astro:assets';

interface Props {
	scene: ImageMetadata;
	name: string;
	light?: boolean;
}
const { scene, name, light = false } = Astro.props;
const sceneImg = await getImage({ src: scene, width: 720, format: 'webp' });

/** A log group: the command, its time (on a group's first line), and its output. */
type Group = { cmd: string; time: string; out: string[]; stat?: [string, string] };
const GROUPS: Group[] = [
	{ cmd: 'ma', time: '4:07', out: ['<span class="i">Launched Maps</span>'] },
	{ cmd: '= 5 km in mi', time: '4:07', out: [], stat: ['3.1069 mi', '5 km'] },
	{ cmd: 'remind 6pm call home', time: '4:08', out: ['Reminder set: call home', '<span class="d">6:00 PM, in 1h 52m</span>'] },
	{ cmd: `shader ${name}`, time: '4:08', out: [`Shader: ${name}`, `<span class="d">'shader off' turns it off</span>`] },
];
---


<div class:list={['sp-phone', { light }]} style={`--scene:url(${sceneImg.src})`}>
	<div class="sp-screen" role="img" aria-label={`Kolahal's home screen over the ${name} scene: a few commands and their answers in the log, and the prompt`}>
		<div class="sp-sbar" aria-hidden="true">
			<span class="sp-side"><b>4:08 PM</b><span class="d">Wed 4 Nov</span></span>
			<span class="sp-side">
				<span class="sp-part"><svg class="d" viewBox="0 0 24 24"><path d="M12 20.5a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15zM12 9v4l2.5 2M5.5 3.5l-3 2.5M18.5 3.5l3 2.5" /></svg><b>7:00</b></span>
				<span class="sp-part"><svg class="d" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><b>2</b></span>
				<span class="sp-part a">
					<svg class="sp-bat" viewBox="0 0 26 14"><rect x="1" y="1.5" width="21" height="11" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6" /><rect x="3.2" y="3.7" width="13.8" height="6.6" rx="1" fill="currentColor" /><rect x="23" y="5" width="2" height="4" rx="1" fill="currentColor" /></svg><b>82%</b>
				</span>
			</span>
		</div>
		<div class="sp-log" aria-hidden="true">
			{
				GROUPS.map((g, i) => (
					<div class:list={['sp-g', { dim: i < GROUPS.length - 1 }]}>
						<div class="sp-ln">
							<span>
								<b class="ps">$</b> <b>{g.cmd}</b>
							</span>
							<span class="sp-time">{g.time}</span>
						</div>
						{g.stat && (
							<div class="sp-o">
								<span class="sp-stat">
									<b>{g.stat[0]}</b>
									<small>{g.stat[1]}</small>
								</span>
							</div>
						)}
						{g.out.map((o) => <div class="sp-o" set:html={o} />)}
					</div>
				))
			}
		</div>
		<div class="sp-prompt" aria-hidden="true">
			<b class="ps">$</b>
			<svg class="sp-kbtn" viewBox="0 0 24 24"><path fill="currentColor" d="M20,5H4c-1.1,0 -1.99,0.9 -1.99,2L2,17c0,1.1 0.9,2 2,2h16c1.1,0 2,-0.9 2,-2V7c0,-1.1 -0.9,-2 -2,-2zM11,8h2v2h-2V8zM11,11h2v2h-2v-2zM8,8h2v2H8V8zM8,11h2v2H8v-2zM7,13H5v-2h2v2zM7,10H5V8h2v2zM16,17H8v-2h8v2zM16,13h-2v-2h2v2zM16,10h-2V8h2v2zM19,13h-2v-2h2v2zM19,10h-2V8h2v2z" /></svg>
		</div>
	</div>
</div>

<style>
	/* The frame: 0.465 as wide as tall, the screen inside a 2.6 % rim. */
	.sp-phone {
		--pw: 17.5rem;
		/* The shadow under a phone (no token yet). */
		--phone-shadow: rgb(0 0 0 / 0.8);
		width: var(--pw);
		max-width: 100%;
		aspect-ratio: 0.465;
		box-sizing: border-box;
		padding: calc(var(--pw) * 0.026);
		border-radius: calc(var(--pw) * 0.09);
		border: 1px solid var(--s-phone-edge);
		background: var(--s-phone);
		box-shadow: 0 36px 70px -28px var(--phone-shadow);
		container-type: inline-size;
	}
	:global(:root[data-theme='light']) .sp-phone {
		--phone-shadow: color-mix(in srgb, var(--s-ink) 60%, transparent);
	}
	.sp-screen {
		/* One dp: the screen is 360 dp across. The app's rose-pine theme, dark (Palettes.rosePine). */
		--dp: calc(100cqw / 360);
		--bg: #191724;
		--fg: #e0def4;
		--dim: #908caa;
		--accent: #ebbcba;
		--info: #9ccfd8;
		height: 100%;
		box-sizing: border-box;
		border-radius: calc(var(--pw) * 0.064);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		background: var(--bg) var(--scene) center / cover no-repeat;
		color: var(--fg);
		font-family: var(--s-font-mono);
		font-size: calc(14 * var(--dp));
		line-height: 1.36;
		font-variant-ligatures: none;
		text-align: start;
		user-select: none;
	}
	/* Rosé Pine Dawn (Palettes.rosePineLight), over a scene drawn in the light theme. */
	.light .sp-screen {
		--bg: #faf4ed;
		--fg: #464261;
		--dim: #6f6b89;
		--accent: #9c5e5b;
		--info: #45767f;
	}
	.sp-screen svg {
		flex: none;
	}
	.d {
		color: var(--dim);
	}
	.a {
		color: var(--accent);
	}
	.sp-screen :global(.i) {
		color: var(--info);
	}
	.sp-screen :global(.d) {
		color: var(--dim);
	}
	b {
		font-weight: 700;
	}
	.ps {
		color: var(--accent);
	}
	/* The header (TerminalHeader.kt): 13 sp, 6 dp above; time and date, then alarm, todos and battery. */
	.sp-sbar {
		flex: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: calc(30 * var(--dp));
		margin-top: calc(6 * var(--dp));
		padding: 0 calc(8 * var(--dp));
		font-size: calc(13 * var(--dp));
		white-space: nowrap;
	}
	.sp-side {
		display: flex;
		align-items: center;
		gap: calc(6 * var(--dp));
		padding: 0 calc(3 * var(--dp));
	}
	.sp-part {
		display: flex;
		align-items: center;
		gap: calc(3 * var(--dp));
		padding: 0 calc(3 * var(--dp));
	}
	.sp-part svg {
		width: calc(15 * var(--dp));
		height: calc(15 * var(--dp));
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.sp-part .sp-bat {
		width: calc(24 * var(--dp));
		height: calc(13 * var(--dp));
		stroke: none;
	}
	/* The log (TerminalScreen.kt): 12 dp at the sides, the newest line at the bottom. */
	.sp-log {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: calc(6 * var(--dp)) calc(12 * var(--dp));
	}
	/* A group: 5 dp above it (log.spacing); older groups dim (log.dim). */
	.sp-g {
		margin-top: calc(5 * var(--dp));
	}
	.sp-g.dim {
		opacity: 0.62;
	}
	/* Lines are at least 22 dp, with the 2 dp bar in the accent at 45 % and 10 dp after it. */
	.sp-ln,
	.sp-o {
		position: relative;
		min-height: calc(22 * var(--dp));
		padding: calc(1.5 * var(--dp)) 0 calc(1.5 * var(--dp)) calc(10 * var(--dp));
		box-sizing: border-box;
	}
	.sp-ln::before,
	.sp-o::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: calc(2 * var(--dp));
		background: color-mix(in srgb, var(--accent) 45%, transparent);
	}
	.sp-ln {
		display: flex;
		justify-content: space-between;
		gap: calc(8 * var(--dp));
	}
	.sp-ln > span:first-child {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.sp-time {
		color: var(--dim);
		font-size: calc(12 * var(--dp));
		padding-top: calc(2 * var(--dp));
	}
	/* fmt.stats: the value 1.9 × the text, semibold; what it answers under it, in the phone's font. */
	.sp-stat {
		display: inline-flex;
		flex-direction: column;
		white-space: nowrap;
	}
	.sp-stat b {
		font-size: calc(26.6 * var(--dp));
		line-height: 1.1;
		font-weight: 600;
	}
	.sp-stat small {
		font: calc(12 * var(--dp)) / 1.4 Roboto, var(--sl-font-system);
		color: var(--dim);
	}
	/* The prompt (Prompt.kt): 40 dp, `$` at 16 sp, then the key bar's toggle. */
	.sp-prompt {
		flex: none;
		display: flex;
		align-items: center;
		height: calc(40 * var(--dp));
		margin-bottom: calc(8 * var(--dp));
		padding-left: calc(12 * var(--dp));
		font-size: calc(16 * var(--dp));
	}
	.sp-prompt .ps {
		margin-right: calc(9.6 * var(--dp));
	}
	.sp-kbtn {
		margin-left: auto;
		box-sizing: content-box;
		width: calc(20 * var(--dp));
		height: calc(20 * var(--dp));
		padding: 0 calc(12 * var(--dp)) 0 calc(8 * var(--dp));
		color: var(--dim);
	}
</style>
