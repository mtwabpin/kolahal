---
/**
 * The built-in themes on the home page, each in its dark and light version, with the colors from the
 * app (ui/theme/Theme.kt, Palettes), as src/data/themes.json has them (tools/export-themes.mjs makes it
 * from the app's sources).
 *
 * Each half is a piece of home in that palette: a few commands and their answers as the log draws
 * them (ui/home/LogView.kt: the bar beside each line in the accent at 45 %, the script color beside a
 * script's lines and the error color beside an error; the time in the muted color; a profile's tag
 * bold in its color). Under each half, a strip of that version's colors in the theme builder's order
 * (ui/settings/ThemeBuilder.kt), the same on every card so they compare down the page.
 *
 * - A color in the strip says its name and value to a screen reader, and on hover. A strip takes
 *   focus (and a tap): it then lists every color with its value over the sample.
 * - A color gets a ring in the site's rule color where it is close to the card under it, in the site's
 *   dark or light theme (under 1.8:1 against --s-sheet, read from tokens.css).
 * - `NOTES` has a word or two after a theme's command.
 * - material-you takes its colors from the phone's wallpaper. It is drawn here in Material's
 *   standard colors, which Android 9 to 11 show (ui/theme/MaterialYouPalettes.kt).
 */
import data from '../data/themes.json';
import tokens from '../styles/tokens.css?raw';

type Palette = Record<string, string>;

/** The strip: the theme builder's order, without surface, muted text, info and personal apps. */
const COLORS: [role: string, name: string][] = [
	['background', 'Background'],
	['text', 'Text'],
	['accent', 'Accent'],
	['link', 'Links'],
	['script', 'Script output'],
	['error', 'Errors'],
	['good', 'Good'],
	['warn', 'Warning'],
	['work', 'Work apps'],
	['private', 'Private space'],
];

const NOTES: Record<string, string> = { [data.default]: 'default', 'material-you': "your wallpaper's colors" };

/** The card's color in the site's dark theme (:root) and light theme, from tokens.css. */
const sheets = [...tokens.matchAll(/--s-sheet:\s*(#[0-9a-f]{6})/gi)].map((m) => m[1]);
const [sheetDark, sheetLight] = sheets;

const lum = (hex: string) => {
	const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
	return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const contrast = (a: string, b: string) => {
	const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
	return (x + 0.05) / (y + 0.05);
};
const NEAR = 1.8;
const ringClass = (hex: string) => ({ 'near-dark': contrast(hex, sheetDark) < NEAR, 'near-light': contrast(hex, sheetLight) < NEAR });

const vars = (c: Palette) =>
	[
		['bg', c.background],
		['fg', c.text],
		['dim', c.muted],
		['accent', c.accent],
		['info', c.info],
		['link', c.link],
		['script', c.script],
		['error', c.error],
		['good', c.good],
		['warn', c.warn],
		['work', c.work],
		['private', c.private],
	]
		.map(([k, v]) => `--t-${k}:${v}`)
		.join(';');

const THEMES = Object.entries(data.themes as Record<string, { dark: Palette; light: Palette }>).map(([name, t]) => ({
	name,
	note: NOTES[name],
	versions: [
		{ key: 'dark', label: 'Dark', c: t.dark },
		{ key: 'light', label: 'Light', c: t.light },
	],
}));
---

<p class="legend not-content">
	The strip under each half is that version's colors, from the left: background, text, accent, links, script output,
	errors, good, warning, work apps and private space.
</p>
<ul class="themes not-content">
	{
		THEMES.map((t) => (
			<li class="card">
				<p class="name">
					<code>theme {t.name}</code>
					{t.note && <span class="note">{t.note}</span>}
				</p>
				<div class="view">
					<div class="pair" aria-hidden="true">
						{t.versions.map((v) => (
							<div class="half" style={vars(v.c)}>
								<div class="g">
									<div class="ln">
										<span><b class="p">$</b> <b>slack</b></span>
										<span class="tm">9:41</span>
									</div>
									<div class="ln i">
										<span>Launched Slack <b class="tag w">[W]</b></span>
									</div>
								</div>
								<div class="g">
									<div class="ln">
										<span><b class="p">$</b> <b>bank</b></span>
										<span class="tm">9:42</span>
									</div>
									<div class="ln i">
										<span>Launched Bank <b class="tag s">[S]</b></span>
									</div>
								</div>
								<div class="g">
									<div class="ln">
										<span><b class="p">$</b> <b>crypto</b></span>
										<span class="tm">9:44</span>
									</div>
									<div class="ln sc">
										<span><span class="l">BTC</span> 64,210 <span class="ok">▲ 2.1%</span></span>
									</div>
								</div>
								<div class="g">
									<div class="ln">
										<span><b class="p">$</b> <b>aqi lisbon</b></span>
										<span class="tm">9:45</span>
									</div>
									<div class="ln sc">
										<span>PM2.5 61 <span class="wn">Moderate</span></span>
									</div>
								</div>
								<div class="g">
									<div class="ln">
										<span><b class="p">$</b> <b>open mpas</b></span>
										<span class="tm">9:46</span>
									</div>
									<div class="ln er">
										<span>No app matches 'mpas'</span>
									</div>
								</div>
							</div>
						))}
					</div>
					{t.versions.map((v) => (
						<div class:list={['panel', v.key]} aria-hidden="true">
							<p>{v.label}</p>
							<ul>
								{COLORS.map(([role, name]) => (
									<li>
										<i class:list={ringClass(v.c[role])} style={`--swatch:${v.c[role]}`} />
										<span>{name}</span>
										<span class="hex">{v.c[role]}</span>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
				<div class="rows">
					{t.versions.map((v) => (
						<ul class:list={['strip', v.key]} tabindex="0" aria-label={`${t.name}, ${v.key}: its colors`}>
							{COLORS.map(([role, name]) => (
								<li class:list={ringClass(v.c[role])} style={`--swatch:${v.c[role]}`} data-tip={`${name} ${v.c[role]}`}>
									<span class="sr-only">
										{name} {v.c[role]}
									</span>
								</li>
							))}
						</ul>
					))}
				</div>
			</li>
		))
	}
</ul>

<style>
	.legend {
		max-width: 42em;
		margin: -0.75rem 0 0;
		font-size: 1rem;
		color: var(--s-ink-soft);
	}
	.themes {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr));
		gap: 1.25rem;
	}
	.card {
		margin: 0;
		padding: 1rem 1rem 0.5rem;
		border-radius: var(--s-radius-l);
		background: var(--s-sheet);
		box-shadow: 0 0 0 1px var(--s-rule);
		color: var(--s-muted);
		font-size: var(--sl-text-sm);
		min-width: 0;
	}
	.name {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.625rem;
		margin: 0 0 0.75rem 0.25rem;
	}
	.name code {
		font-family: var(--s-font-mono);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--s-ink);
	}
	.note {
		color: var(--s-muted);
	}
	.view {
		position: relative;
	}
	.pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-radius: var(--s-radius-m);
		overflow: hidden;
		box-shadow: 0 0 0 1px var(--s-rule);
	}
	/* The log (LogView.kt): lines of at least 22 dp with the 2 dp bar, 5 dp between groups. */
	.half {
		min-width: 0;
		background: var(--t-bg);
		color: var(--t-fg);
		font: 0.75rem/1.55 var(--s-font-mono);
		font-variant-ligatures: none;
		padding: 0.5rem 0.75rem 0.625rem;
		white-space: nowrap;
	}
	.g {
		margin-top: 0.3rem;
	}
	.ln {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.05rem 0 0.05rem 0.5rem;
		border-inline-start: 2px solid color-mix(in srgb, var(--t-accent) 45%, transparent);
	}
	.ln > span:first-child {
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.p {
		color: var(--t-accent);
	}
	.tm {
		flex: none;
		color: var(--t-dim);
		font-size: 0.92em;
	}
	.i {
		color: var(--t-info);
	}
	.tag {
		font-size: 0.86em;
	}
	.w {
		color: var(--t-work);
	}
	.s {
		color: var(--t-private);
	}
	.sc {
		color: var(--t-script);
		border-inline-start-color: color-mix(in srgb, var(--t-script) 45%, transparent);
	}
	.l {
		color: var(--t-link);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.ok {
		color: var(--t-good);
	}
	.wn {
		color: var(--t-warn);
	}
	.er {
		color: var(--t-error);
		border-inline-start-color: color-mix(in srgb, var(--t-error) 45%, transparent);
	}

	/* The strips: one under each half, as wide as its half and inset as its log. */
	.rows {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	/* Ten colors side by side with small gaps, the ends rounded. */
	.strip {
		--inset: 0.75rem;
		list-style: none;
		margin: 0;
		padding: 0 var(--inset);
		min-height: 2.75rem;
		display: flex;
		align-items: center;
		gap: 2px;
		border-radius: var(--s-radius-s);
		min-width: 0;
	}
	.strip li {
		position: relative;
		flex: 1;
		margin: 0;
		height: 1.125rem;
		border-radius: 0.1875rem;
		background: var(--swatch);
	}
	.strip li:first-child {
		border-radius: 0.5625rem 0.1875rem 0.1875rem 0.5625rem;
	}
	.strip li:last-child {
		border-radius: 0.1875rem 0.5625rem 0.5625rem 0.1875rem;
	}
	.strip:focus {
		outline: none;
	}
	.strip:focus-visible {
		outline: 2px solid var(--s-link);
		outline-offset: -2px;
	}
	/* A ring where the color is close to the card: in the site's dark theme, then its light one. */
	.near-dark {
		box-shadow: 0 0 0 1px var(--s-rule);
	}
	:global(:root[data-theme='light']) .near-dark {
		box-shadow: none;
	}
	:global(:root[data-theme='light']) .near-light {
		box-shadow: 0 0 0 1px var(--s-rule);
	}
	/* A color's name and value on hover: over it, toward the middle of its strip. */
	.strip li::after {
		content: attr(data-tip);
		display: none;
		position: absolute;
		bottom: calc(100% + 0.5rem);
		z-index: 2;
		padding: 0.25rem 0.5rem;
		border-radius: 0.375rem;
		background: var(--s-ink);
		color: var(--s-sheet);
		font: 600 0.75rem/1.3 var(--s-font-mono);
		white-space: nowrap;
		pointer-events: none;
	}
	.strip li:nth-child(-n + 5)::after {
		left: -0.25rem;
	}
	.strip li:nth-child(n + 6)::after {
		right: -0.25rem;
	}
	.strip li:hover::after {
		display: block;
	}
	.strip:focus li::after {
		display: none;
	}

	/* With a row focused (or tapped), its colors listed over the sample. */
	.panel {
		display: none;
		position: absolute;
		inset: 0;
		z-index: 1;
		padding: 0.625rem 0.875rem;
		border-radius: var(--s-radius-m);
		background: var(--s-sheet);
		box-shadow: 0 0 0 1px var(--s-rule-strong);
		color: var(--s-ink);
		font: 0.8125rem/1.4 var(--s-font-mono);
		overflow: hidden;
	}
	.card:has(.strip.dark:focus) .panel.dark,
	.card:has(.strip.light:focus) .panel.light {
		display: block;
	}
	.panel p {
		margin: 0 0 0.375rem;
		font-family: var(--s-font-text);
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--s-ink);
	}
	.panel ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: repeat(5, auto);
		grid-auto-flow: column;
		gap: 0.375rem 1.25rem;
	}
	.panel li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		min-width: 0;
		white-space: nowrap;
	}
	.panel li span:first-of-type {
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.panel .hex {
		margin-left: auto;
		color: var(--s-muted);
	}
	.panel i {
		flex: none;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background: var(--swatch);
	}

	@media (max-width: 30rem) {
		.card {
			padding: 0.75rem 0.625rem 0.25rem;
		}
		.half {
			font-size: 0.6875rem;
			padding-inline: 0.5rem;
		}
		.tm {
			display: none;
		}
		.strip {
			--inset: 0.5rem;
		}
		.panel {
			padding: 0.5rem 0.625rem;
			font-size: 0.75rem;
		}
		.panel ul {
			grid-template-columns: 1fr;
			grid-template-rows: none;
			grid-auto-flow: row;
			gap: 0;
		}
	}
</style>
