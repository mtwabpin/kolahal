---
/**
 * "Next steps" on the home page: one rounded row per place to go, its name and a line about it,
 * with an arrow at the end (↗ for another site). It reads on the page's ground and on a sheet.
 */
import { DIRECT_DOWNLOADS } from '../release';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ROWS: { name: string; text: string; href: string; external?: boolean }[] = [
	{ name: 'Install', text: DIRECT_DOWNLOADS ? 'Download and install; the tour opens the first time' : 'Join the alpha test on Google Play; the tour opens the first time', href: `${base}/getting-started/install/` },
	{ name: 'Basics', text: 'Suggestions, the key bar, tap and long-press, shortcuts', href: `${base}/getting-started/basics/` },
	{ name: 'Scripts', text: 'The scripting overview, the API and the library', href: `${base}/scripting/overview/` },
	{ name: 'Commands', text: 'Every built-in command', href: `${base}/reference/commands/` },
	{ name: 'Discord', text: 'Ask a question', href: 'https://discord.gg/3D25w6gXR5', external: true },
	{ name: 'GitHub', text: 'Report a bug or ask for a feature', href: 'https://github.com/mtwabpin/kolahal/issues/new/choose', external: true },
	{ name: 'Security', text: 'Report a security problem privately', href: `${base}/reference/security/` },
];
---

<nav class="next not-content" aria-label="Next steps">
	<ul>
		{ROWS.map((r) => (
			<li>
				<a href={r.href}>
					<span class="name">{r.name}</span>
					<span class="text">{r.text}</span>
					<span class="go" aria-hidden="true">{r.external ? '↗' : '→'}</span>
					{r.external && <span class="sr-only">(opens another site)</span>}
				</a>
			</li>
		))}
	</ul>
</nav>

<style>
	.next {
		max-width: 46rem;
		margin-top: 1rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.25rem;
	}
	li + li {
		margin: 0;
	}
	a {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		min-height: 2.75rem;
		padding: 0.75rem 1rem;
		border-radius: var(--s-radius-s);
		color: var(--s-ink);
		text-decoration: none;
	}
	a:hover {
		background: color-mix(in srgb, var(--s-current) 70%, transparent);
	}
	a:focus-visible {
		outline: 2px solid var(--s-link);
		outline-offset: 2px;
	}
	.name {
		min-width: 7.5rem;
		font-weight: 700;
	}
	.text {
		flex: 1;
		color: var(--s-muted);
	}
	.go {
		color: var(--s-muted);
	}
	a:hover .go {
		color: var(--s-ink);
	}
	@media (max-width: 40rem) {
		a {
			flex-wrap: wrap;
			row-gap: 0.125rem;
		}
		.name {
			min-width: 0;
			flex: 1;
		}
		.text {
			order: 3;
			flex-basis: 100%;
		}
	}
</style>
