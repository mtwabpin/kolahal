											<span class="t-torch r1"><i class="s-cookie9"><svg><use href="#t-torch" /></svg></i>torch</span>
											<span class="r2"><i class="s-clover4"><svg><use href="#t-moon" /></svg></i>dnd</span>
											<span class="r3"><i class="s-sunny"><svg><use href="#t-check" /></svg></i>todo</span>
											<span class="r1"><i class="s-wavy"><svg><use href="#t-place" /></svg></i>maps</span>
										</div>
										<!-- Todos in Split, 2×2: a tile with the name, then a tile for each row -->
