		<div class="t-copy">
			{BEATS.map((b, i) => (
				<section class="t-beat" id={`tour-${b.id}`} style={`--len:${b.len};--bar:${b.bar}`}>
					<div class="t-card">
						<p class="t-cmd"><span><b>$</b> {b.cmd}</span><i>{i + 1} / {BEATS.length}</i></p>
						<h2>{b.title}</h2>
						{b.text.map((t) => <p set:html={t} />)}
						{b.cmds && (
							<ul class="t-cmds">
								{b.cmds.map((c) => <li><code>{c}</code></li>)}
							</ul>
						)}
