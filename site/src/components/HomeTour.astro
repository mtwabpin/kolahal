					<div class="t-ov t-ed">
						<div class="t-edh">
							<b>water.lua</b>
							<svg><use href="#t-search" /></svg><svg><use href="#t-help" /></svg><svg><use href="#t-save" /></svg><svg class="t-run"><use href="#t-run" /></svg><svg><use href="#t-close" /></svg>
						</div>
						<pre class="t-code"></pre>
						<div class="t-edbar">
							<svg><use href="#t-undo" /></svg><svg><use href="#t-redo" /></svg><svg><use href="#t-tab" /></svg><i>(</i><i>)</i><i>{'{'}</i><i>{'}'}</i><i>[</i><i>]</i>
