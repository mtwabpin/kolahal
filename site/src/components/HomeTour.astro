							<circle cx="41" cy="150" r="3" fill="var(--link)" />
							<circle cx="74" cy="66" r="4.2" fill="var(--error)" />
							<circle cx="74" cy="66" r="1.5" fill="var(--bg)" />
						</svg>
						<div class="t-appbar"><svg><use href="#t-app-maps" /></svg>Search here</div>
					</div>
					<div class="t-ov t-app t-photos">
						<div class="t-appbar plain">Photos</div>
						<div class="t-tiles">{Array.from({ length: 18 }, () => <i />)}</div>
