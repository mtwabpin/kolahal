				</section>
			))}
		</div>
	</div>

	<section class="t-end">
		<h2>Get Kolahal.</h2>
		{DIRECT_DOWNLOADS ? (
			<p>For Android 9 and newer. Install it, make it your home app, and start typing.</p>
		) : (
			<p>For Android 9 and newer, in alpha testing on Google Play. Join the test, install it from the Play Store, make it your home app, and start typing.</p>
		)}
		<div class="t-btns">
			{DIRECT_DOWNLOADS ? (
				<LinkButton href={APK} icon="download" iconPlacement="start">Download the APK</LinkButton>
			) : (
				<LinkButton href={withBase('/getting-started/play-testing/')} icon="right-arrow">Join the alpha test</LinkButton>
			)}
			<LinkButton href={withBase('/getting-started/install/')} variant="secondary" icon="right-arrow">Guide</LinkButton>
			<LinkButton href={withBase('/reference/commands/')} variant="secondary">Command reference</LinkButton>
			<LinkButton href="#_top" variant="minimal">Back to top</LinkButton>
		</div>
	</section>

	<nav class="t-chapters" aria-label="Tour">
		{BEATS.map((b) => <a href={`#tour-${b.id}`}>{b.cmd}</a>)}
	</nav>
</div>

<script>
	/*
	 * The engine. One requestAnimationFrame loop reads the scroll position, finds the current beat
	 * (chapter) and how far into it the reading line is (0–1), and renders the phone from those two
	 * numbers alone. Scrolling back plays everything backwards.
	 */
	import { createBackdrop } from './tour-backdrop';

	const tour = document.querySelector<HTMLElement>('[data-tour]');
	if (tour) run(tour);

	function run(T: HTMLElement) {
		const doc = document;
		const root = doc.documentElement;
		const $ = <E extends Element = HTMLElement>(s: string, el: ParentNode = T) => el.querySelector<E>(s)!;
		const $$ = <E extends Element = HTMLElement>(s: string, el: ParentNode = T) => [...el.querySelectorAll<E>(s)];
		const mqRM = matchMedia('(prefers-reduced-motion: reduce)');
		const mqSmall = matchMedia('(max-width: 859px)');
		let RM = mqRM.matches;
		let SMALL = mqSmall.matches;

		const clamp = (x: number, a: number, b: number) => (x < a ? a : x > b ? b : x);
		/** 0 before a, 1 after b, linear between; with reduced motion, a step in the middle. */
		const ramp = (p: number, a: number, b: number) => (RM ? (p >= (a + b) / 2 ? 1 : 0) : clamp((p - a) / (b - a), 0, 1));
		const ease = (t: number) => t * t * (3 - 2 * t);
		const bump = (p: number, a: number, b: number) => (RM ? 0 : Math.sin(clamp((p - a) / (b - a), 0, 1) * Math.PI));
		const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
		type C = HTMLElement & { _c?: Record<string, string>; _k?: Record<string, boolean>; _t?: string };
		/** Writes a style only when it changes. */
		function st(el: Element, k: string, v: string) {
			const e = el as C;
			const c = e._c || (e._c = {});
			if (c[k] !== v) {
				c[k] = v;
				e.style.setProperty(k, v);
			}
		}
		function cls(el: Element, name: string, on: boolean) {
			const e = el as C;
			const c = e._k || (e._k = {});
			if (c[name] !== on) {
				c[name] = on;
				e.classList.toggle(name, on);
			}
		}
		function text(el: Element, v: string) {
			const e = el as C;
			if (e._t !== v) {
				e._t = v;
				e.textContent = v;
			}
		}
		function html(el: Element, v: string) {
			const e = el as C;
			if (e._t !== v) {
				e._t = v;
				e.innerHTML = v;
			}
		}

		/* ---------- content ---------- */
		/** The screen's width in dp: the app's sizes, drawn about 14 % larger than on a 412 dp phone (CSS --dp). */
		const DP_ACROSS = 360;
		const NAMES = ['launch', 'apps', 'answers', 'log', 'widgets', 'scripts', 'themes'];
		const CLOCK = ['4:07 PM', '4:07 PM', '4:07 PM', '4:08 PM', '4:09 PM', '4:10 PM', '4:11 PM', '4:12 PM', '4:12 PM'];
		// The palettes of ThemeCards.astro (ui/Theme.kt): bg, fg, dim, prompt, info, link.
		const TH: Record<string, { d: string[]; l: string[] }> = {
			amber: { d: ['#0E0A05', '#FFCC80', '#A08256', '#FFB000', '#D9A25F', '#FFE0A3'], l: ['#FFF7E8', '#3D2A0C', '#7E6136', '#A05F00', '#8A5E22', '#7A4B00'] },
			dracula: { d: ['#282A36', '#F8F8F2', '#8A93C2', '#50FA7B', '#8BE9FD', '#8BE9FD'], l: ['#FFFBEB', '#1F1F1F', '#635D97', '#14710A', '#036A96', '#036A96'] },
			nord: { d: ['#2E3440', '#D8DEE9', '#929AAA', '#88C0D0', '#8FBCBB', '#81A1C1'], l: ['#ECEFF4', '#2E3440', '#616E88', '#357587', '#467473', '#4A7095'] },
			'rose-pine': { d: ['#191724', '#E0DEF4', '#908CAA', '#EBBCBA', '#9CCFD8', '#9CCFD8'], l: ['#FAF4ED', '#464261', '#6F6B89', '#9C5E5B', '#45767F', '#45767F'] },
		};
		const THEME_ORDER = ['amber', 'dracula', 'nord', 'rose-pine', 'green'];
		/** The looks the habit card goes through in beat 5, from Plain and back. */
		const LOOKS = ['bold', 'split', 'shape', 'plain', 'tonal'];
		const LOOK_NAMES: Record<string, string> = { plain: 'Plain', tonal: 'Tonal', bold: 'Bold', split: 'Split', shape: 'Shape' };

		/** fmt.stats as the log draws it: the value 1.9 times the text, what it answers under it (RichText.kt). */
		const stats = (value: string, of: string) => `<span class="t-stat"><b>${value}</b><small>${of}</small></span>`;
		const two = (a: string, b: string) => `<span class="t-two"><b>${a}</b><span class="d">${b}</span></span>`;
		type Type = { ch: number; a: number; b: number; at: number; t: string; time: string; out: string[]; theme?: string; lp?: boolean };
		/** Every typed command: its beat, typing from a to b, Enter at `at` (all in beat progress). */
		const TYPES: Type[] = [
			{ ch: 1, a: 0.1, b: 0.27, at: 0.4, t: 'ma', time: '4:07', out: ['<span class="i">Launched Maps</span>'] },
			{ ch: 3, a: 0.05, b: 0.19, at: 0.25, t: '= 5 km in mi', time: '4:08', out: [stats('3.1069 mi', '5 km')] },
			{ ch: 3, a: 0.35, b: 0.48, at: 0.54, t: 'date tokyo london', time: '4:08', out: [two('Tokyo', '7:36 PM · 3h30 ahead'), two('London', '10:36 AM · 5h30 behind')] },
			{ ch: 3, a: 0.64, b: 0.78, at: 0.84, t: 'todo add call the bank', time: '4:08', out: [' 3. [ ] call the bank', '3 open'] },
			{
				ch: 4, a: 0.05, b: 0.12, at: 0.17, t: 'notifs', time: '4:09',
				out: ['<span class="d">Messages</span> Asha: Running 10 minutes late', '<span class="d">Calendar</span> Dentist at 4:30 PM', '<span class="d">Files</span> Download complete'],
			},
			{
				ch: 4, a: 0.24, b: 0.32, at: 0.37, t: 'feed read', time: '4:09', lp: true,
				out: [
					'<span class="l">Basil on a windowsill</span><span class="d"> · Field Notes</span>',
					'<span class="l">Why plain text lasts</span><span class="d"> · Daily Byte</span>',
					'<span class="l">Ten easy trails</span><span class="d"> · Trail Weekly</span>',
				],
			},
		];
		THEME_ORDER.forEach((name, i) => {
			const a = 0.1 + i * 0.165;
			TYPES.push({ ch: 7, a, b: a + 0.07, at: a + 0.11, t: 'theme ' + name, time: '4:12', out: [], theme: name });
		});

		/** Suggestion rows for a text in the prompt, best match first (drawn at the bottom). Apps alone for an app's name. */
		type Row = { label: string; app?: string; big?: [string, string]; best?: boolean };
		const SUG: Record<string, Row[]> = {
			m: [{ label: 'Maps', app: 'maps', best: true }, { label: 'Music' }, { label: 'Messages', app: 'messages' }, { label: 'Mail', app: 'mail' }],
			ma: [{ label: 'Maps', app: 'maps', best: true }, { label: 'Mail', app: 'mail' }, { label: 'Messages', app: 'messages' }, { label: 'Camera', app: 'camera' }],
			'= 5 km in m': [{ label: '', big: ['5,000 m', '5 km · tap to continue'] }],
			'= 5 km in mi': [{ label: '', big: ['3.1069 mi', '5 km · tap to continue'] }],
		};

		const APPS: [string, string, string?][] = [
			['B', 'Books'], ['B', 'Browser'], ['C', 'Calculator'], ['C', 'Calendar'], ['C', 'Calendar', 'W'], ['C', 'Camera'],
			['C', 'Clock'], ['C', 'Contacts'], ['D', 'Drive'], ['F', 'Files'], ['H', 'Health'], ['K', 'Kolahal'], ['M', 'Mail'],
			['M', 'Mail', 'W'], ['M', 'Maps'], ['M', 'Messages'], ['M', 'Music'], ['N', 'Notes'], ['P', 'Phone'], ['P', 'Photos'],
			['P', 'Podcasts'], ['S', 'Settings'], ['T', 'Tasks'], ['T', 'Translate'], ['W', 'Wallet'], ['W', 'Weather'],
		];
		const PICK_ROW = APPS.findIndex((a) => a[1] === 'Photos');
		/** The selector's sections: each letter's first row and its number of apps. */
		const SECTIONS: { l: string; first: number; n: number }[] = [];
		APPS.forEach(([l], i) => {
			const last = SECTIONS[SECTIONS.length - 1];
			if (last && last.l === l) last.n++;
			else SECTIONS.push({ l, first: i, n: 1 });
		});
		// Browsing by apps: each letter gets room on the strip by the square root of its app count.
		const WEIGHTS = SECTIONS.map((s) => Math.sqrt(s.n));
		const WSUM = WEIGHTS.reduce((a, b) => a + b, 0);
		const WSTART = WEIGHTS.map((_, i) => WEIGHTS.slice(0, i).reduce((a, b) => a + b, 0) / WSUM);
		const sectionOf = (row: number) => SECTIONS.findIndex((s) => row >= s.first && row < s.first + s.n);

		/** A plain app icon: the known ones drawn, the others a colored circle with the first letter. */
		const ICON_COLORS = ['#3d7be0', '#2e9e5b', '#d4493f', '#c98a14', '#7a5cc4', '#13878f', '#b8527a', '#5f6b7a'];
		function appIcon(name: string, cls = 't-ic') {
			const known = name.toLowerCase();
			if (['maps', 'mail', 'messages', 'camera'].includes(known)) return `<svg class="${cls}"><use href="#t-app-${known}"/></svg>`;
			const c = ICON_COLORS[[...name].reduce((a, ch) => a + ch.charCodeAt(0), 0) % ICON_COLORS.length];
			return `<span class="${cls} t-lic" style="--c:${c}">${name.charAt(0)}</span>`;
		}

		const CODE = [
			'-- @title Water',
			'-- @widget progress 2x1',
			'',
			'local today = os.date("%Y-%m-%d")',
			'local n = tonumber(store.get(today) or "0")',
			'if event and event.name == "action"',
			'    and args[1] == "add" then',
			'  n = n + 1',
			'  store.set(today, tostring(n))',
			'end',
			'',
			'widget.show{',
			'  kind = "progress",',
			'  value = n, max = 8,',
			'  text = n .. " / 8",',
			'  tap = { args = "add", label = "add a glass" },',
			'}',
		].join('\n');
		/** A class for each character: comment, string, keyword, number. */
		const CODE_CLS: string[] = new Array(CODE.length).fill('');
		{
			const re = /(--[^\n]*)|("(?:[^"\\\n]|\\.)*")|\b(local|if|then|end|and|or|not|return|function|nil|true|false)\b|\b(\d+)\b/g;
			for (let m; (m = re.exec(CODE)); ) {
				const k = m[1] ? 'c' : m[2] ? 's' : m[3] ? 'k' : 'n';
				for (let i = m.index; i < m.index + m[0].length; i++) CODE_CLS[i] = k;
			}
		}

		/* ---------- elements ---------- */
		const bgEl = $('.t-bg-in');
		const beats = $$('.t-beat');
		const screen = $('.t-screen');
		const clockEl = $('[data-clock]');
		const todosEl = $('[data-todos]');
		const logEl = $('.t-log');
		const hintEl = $('.t-hint0');
		const suggEl = $('.t-sugg');
		const typedEl = $('.t-typed');
		const clearEl = $('.t-clear');
		const kbdEl = $('.t-kbd');
		const pagesEl = $('.t-pages');
		const mapsEl = $('.t-maps');
		const photosEl = $('.t-photos');
		const selEl = $('.t-sel');
		const slistEl = $('.t-slist');
		const railEl = $('.t-rail');
		const bubbleEl = $('.t-bubble');
		const edEl = $('.t-ed');
		const codeEl = $('.t-code');
		const runEl = $('.t-run');
		const sheetEl = $('.t-sheetwrap');
		const touchEl = $('.t-touch');
		const wview = $('.t-wview');
		const wgrid = $('.t-wgrid');
		const wplus = $('.t-wplus');
		const torch = $('.t-torch');
		const todo1 = $('.t-todo1');
		const habit = $('.w-habit');
		const streakEl = $('.t-streak');
		const waterCard = $('.w-water');
		const waterEl = $('.t-water');
		const waterLevel = $('.w-level', waterCard);
		const lookName = $('.t-lookname');
		const wpage = $('.t-wpage');
		const wbar = $('.t-wbar');
		const lookEls = $$('.t-looks i');
		const chapters = $$('.t-chapters a');
		const progSegs = $$('.t-prog i b');
		const capEl = $('.t-cap');

		/* ---------- build: log groups ---------- */
		const groups: { el: HTMLElement; ch: number; at: number; on: boolean }[] = [];
		let lpLine: HTMLElement | null = null;
		for (const t of TYPES) {
			const el = doc.createElement('div');
			el.className = 't-g';
			el.innerHTML =
				`<div class="t-ln"><span><b class="ps">$</b> <b>${esc(t.t)}</b></span><span class="t-time">${t.time}</span></div>` +
				t.out.map((o) => `<div class="t-o">${o}</div>`).join('');
			if (t.lp) lpLine = el.children[1] as HTMLElement;
			logEl.appendChild(el);
			groups.push({ el, ch: t.ch, at: t.at, on: false });
		}

		/* ---------- build: the keyboard (Android's, as Gboard draws it) ---------- */
		const keys: Record<string, HTMLElement> = {};
		{
			const icon = (id: string) => `<svg><use href="#t-${id}"/></svg>`;
			let h = '<div class="r1">';
			[...'qwertyuiop'].forEach((c, i) => (h += `<i data-k="${c}"><sup>${(i + 1) % 10}</sup>${c}</i>`));
			h += '</div><div class="r2">';
			for (const c of 'asdfghjkl') h += `<i data-k="${c}">${c}</i>`;
			h += `</div><div class="r3"><i class="fn w15" data-k="shift">${icon('shift')}</i>`;
			for (const c of 'zxcvbnm') h += `<i data-k="${c}">${c}</i>`;
			h += `<i class="fn w15" data-k="del">${icon('back')}</i></div>`;
			h += `<div class="r4"><i class="fn w15 sym" data-k="sym">?123</i><i class="fn" data-k=",">,</i><i class="fn">${icon('globe')}</i><i class="space" data-k=" "></i><i class="fn" data-k=".">.</i><i class="enter w15" data-k="enter">${icon('ret')}</i></div>`;
			h += '<div class="t-kpop"></div><span class="t-navpill"></span>';
			kbdEl.innerHTML = h;
			for (const k of $$('i', kbdEl)) if (k.dataset.k) keys[k.dataset.k] = k;
		}
		const kpop = $('.t-kpop', kbdEl);
		const keyFor = (c: string) => (!c ? null : keys[c] || keys.sym);

		/* ---------- build: suggestion rows (SuggestionList.kt) ---------- */
		function rowsHtml(rows: Row[]) {
			return rows
				.map(
					(r) =>
						`<div class="t-row${r.best ? ' best' : ''}${r.big ? ' tall' : ''}"><i class="t-bar"></i>` +
						(r.big ? '<svg class="t-ic a"><use href="#t-terminal"/></svg>' : appIcon(r.label)) +
						(r.big ? stats(r.big[0], r.big[1]) : `<span class="t-lab">${esc(r.label)}</span>`) +
						(r.best ? '<svg class="t-ret"><use href="#t-ret"/></svg>' : '') +
						'</div>',
				)
				.join('');
		}

		/* ---------- build: app selector (AppSelector.kt) ---------- */
		slistEl.innerHTML = APPS.map(
			([l, name, tag], i) =>
				`<div class="t-sr" data-i="${i}">` +
				(i === PICK_ROW ? '<span class="t-fill"></span>' : '') +
				`<span class="t-sl">${SECTIONS.some((s) => s.first === i) || i === PICK_ROW ? l : ''}</span>` +
				appIcon(name, 't-sic') +
				`<span class="t-sn">${tag ? `<span class="t-tag">[${tag}]</span> ` : ''}${name}</span></div>`,
		).join('');
		railEl.innerHTML = SECTIONS.map((s) => `<i>${s.l}</i>`).join('');
		const srows = $$('.t-sr', slistEl);
		const railLetters = $$('i', railEl);
		const fillEl = $('.t-fill', slistEl);

		/* ---------- the background ---------- */
		const backdrop = createBackdrop(T, bgEl);

		/* ---------- themes: on the tour's own element ---------- */
		let curTheme = '';
		let curLight: boolean | null = null;
		const VARS = ['--bg', '--fg', '--dim', '--accent', '--info', '--link'];
		function applyTheme(name: string) {
			const light = root.dataset.theme === 'light';
			if (name === curTheme && light === curLight) return;
			curTheme = name;
			curLight = light;
			if (name === 'green') {
				for (const v of VARS) T.style.removeProperty(v);
				T.style.removeProperty('--surface');
			} else {
				const c = TH[name][light ? 'l' : 'd'];
				VARS.forEach((v, i) => T.style.setProperty(v, c[i]));
				T.style.setProperty('--surface', `color-mix(in srgb, ${c[1]} 6%, ${c[0]})`);
			}
		}

		/* ---------- measure ---------- */
		/** The selector's box: the log's area, which changes with the keyboard. */
		function measureSel() {
			const sr = screen.getBoundingClientRect();
			const r = selEl.getBoundingClientRect();
			selW = r.width;
			selH = r.height;
			selTop = r.top - sr.top;
		}
		let navH = 56;
		let dp = 1;
		let selW = 0;
		let selH = 0;
		let selTop = 0;
		function measure() {
			SMALL = mqSmall.matches;
			RM = mqRM.matches;
			const header = doc.querySelector('header.header');
			navH = header ? header.getBoundingClientRect().height : 56;
			// The background spans the window: its width without the scrollbar, from the window's left edge.
			T.style.setProperty('--vw', `${root.clientWidth}px`);
			T.style.setProperty('--bgl', `${-$('.t-story').getBoundingClientRect().left}px`);
			backdrop.layout(SMALL, navH);
			dp = screen.clientWidth / DP_ACROSS || 1;
			measureSel();
			S.dirty = true;
			S.wshift = -1;
		}

		/* ---------- render: everything is a function of (beat, progress) ---------- */
		const S = { ch: -1, p: 0, txt: '', key: '', dirty: true, sy: -1, code: -1, look: '', water: -1, wshift: -1, kbd: true, arrange: false };

		/** The middle of [el] in the screen's coordinates. */
		function center(el: Element) {
			const r = el.getBoundingClientRect();
			const s = screen.getBoundingClientRect();
			return [r.left - s.left + r.width / 2, r.top - s.top + r.height / 2];
		}
		/** The touch mark (like Android's "Show taps"): at x, y in the screen, with opacity o. */
		function touch(x: number, y: number, o: number, scale = 1) {
			st(touchEl, 'opacity', o.toFixed(2));
			if (o > 0) st(touchEl, 'transform', `translate(${x.toFixed(1)}px,${y.toFixed(1)}px) scale(${scale.toFixed(2)})`);
		}
		function show(el: HTMLElement, o: number) {
			st(el, 'visibility', o > 0.001 ? 'visible' : 'hidden');
		}

		function renderCode(n: number) {
			let h = '';
			let line = 1;
			let cur = '';
			let run = '';
			const flush = () => {
				if (run) h += cur ? `<span class="${cur}">${esc(run)}</span>` : esc(run);
				run = '';
			};
			h += '<span class="t-ln-n">1</span>';
			for (let i = 0; i < n; i++) {
				const ch = CODE[i];
				if (ch === '\n') {
					flush();
					line++;
					h += `\n<span class="t-ln-n">${line}</span>`;
					continue;
				}
				if (CODE_CLS[i] !== cur) {
					flush();
					cur = CODE_CLS[i];
				}
				run += ch;
			}
			flush();
			codeEl.innerHTML = h + (n < CODE.length ? '<span class="t-caret"></span>' : '');
		}

		/* SelectorMath: a bell that is 1 at 0 and falls to 0 at ±reach, and its integral. */
		const bell = (x: number, reach = 3) => (Math.abs(x) >= reach ? 0 : (1 + Math.cos((Math.PI * x) / reach)) / 2);
		const bellInt = (x: number, reach = 3) => {
			const a = Math.min(Math.abs(x), reach);
			return (Math.sign(x) * (a + (reach / Math.PI) * Math.sin((Math.PI * a) / reach))) / 2;
		};

		/**
		 * The app selector, beat 2 (browse by apps, the default): the thumb slides down the strip on
		 * the right edge, the list follows it with the focused app level with the thumb, and the
		 * letter's bubble and its wave of letters come out from the edge. Then the thumb slides onto
		 * the list: the fisheye magnifies the rows around it, and the held row fills until Photos opens.
		 */
		function renderSel(ch: number, p: number) {
			const W = selW;
			const H = selH;
			const rowH = 50 * dp;
			const stripH = Math.min(H - 16 * dp, 400 * dp);
			const stripTop = H - stripH - 8 * dp;
			const y0 = stripTop + 0.04 * stripH;
			const usable = stripH * 0.92;
			const mids = SECTIONS.map((_, i) => y0 + usable * (WSTART[i] + WEIGHTS[i] / WSUM / 2));
			const yOf = (pos: number) => {
				const s = Math.max(0, sectionOf(Math.min(APPS.length - 1, Math.floor(pos))));
				const sec = SECTIONS[s];
				return y0 + usable * (WSTART[s] + (((pos - sec.first) / sec.n) * WEIGHTS[s]) / WSUM);
			};
			// The bubble's place: between the strip and the list (AppSelector: bubbleFromEdge).
			const touchW = Math.max(W * 0.55, Math.min(200 * dp, W - 44 * dp));
			const gap = W - touchW - 36 * dp;
			const bubbleFrom = Math.max(24 * dp, Math.min(36 * dp + gap / 2, 36 * dp + gap - 24 * dp));
			st(selEl, '--row-w', `${(W - bubbleFrom - 24 * dp).toFixed(1)}px`);

			const active = ch === 2 && p < 0.8;
			const sliding = active && p < 0.58;
			const waveIn = active ? ease(ramp(p, 0.12, 0.16)) * (1 - ease(ramp(p, 0.57, 0.61))) : 0;
			const pos = RM ? PICK_ROW + 0.5 : 0.5 + ease(ramp(p, 0.14, 0.55)) * PICK_ROW;
			const thumbY = yOf(pos);
			const focus = Math.min(APPS.length - 1, Math.floor(pos));
			const sec = Math.max(0, sectionOf(focus));
			const c = mids[sec];
			const unit = usable / SECTIONS.length;
			const spread = Math.max(0, ((38 * dp) / unit - 1) / bellInt(1));
			const rest = 6 * dp;
			const clear = (20 + 6) * dp * waveIn;

			// The letters: at rest along the edge (8 sp), in a wave around the bubble while sliding.
			const ys: number[] = [];
			const outs: number[] = [];
			SECTIONS.forEach((_, i) => {
				const x = (mids[i] - c) / unit;
				ys.push(c + unit * (x + spread * waveIn * bellInt(x)));
				outs.push(bell(x) * waveIn);
			});
			const shown = SECTIONS.map(() => false);
			for (const step of [-1, 1]) {
				let last = NaN;
				for (let i = sec + step; i >= 0 && i < SECTIONS.length; i += step) {
					const off = Math.abs(ys[i] - ys[sec]) >= clear;
					const apart = isNaN(last) || Math.abs(ys[i] - last) >= 10 * dp * (1 + 0.6 * outs[i]);
					if (off && apart) {
						shown[i] = true;
						last = ys[i];
					}
				}
			}
			const restShown = !S.kbd && ch === 2;
			railLetters.forEach((el, i) => {
				const from = rest + (bubbleFrom - rest) * outs[i];
				const scale = (8 / 13) * (1 - waveIn) + waveIn * (1 + 0.6 * outs[i]);
				st(el, 'transform', `translate(${(W - from).toFixed(1)}px,${(waveIn ? ys[i] : mids[i]).toFixed(1)}px) scale(${scale.toFixed(3)})`);
				const a = waveIn > 0 ? (i === sec || !shown[i] ? 0 : waveIn * (0.55 + 0.45 * outs[i])) : restShown ? 0.8 : 0;
				st(el, 'opacity', a.toFixed(2));
				st(el, '--mix', `${Math.round(outs[i] * 100)}%`);
			});
			st(bubbleEl, 'transform', `translate(${(W - (rest + (bubbleFrom - rest) * waveIn)).toFixed(1)}px,${c.toFixed(1)}px) scale(${waveIn.toFixed(3)})`);
			st(bubbleEl, 'opacity', waveIn.toFixed(2));
			text(bubbleEl, SECTIONS[sec].l);
			if (!active) return;

			// The list: the focused app level with the thumb. Off the edge, it holds still.
			const listY = thumbY - pos * rowH;
			st(slistEl, 'transform', `translateY(${listY.toFixed(1)}px)`);
			const lens = sliding ? 0 : ease(ramp(p, 0.58, 0.63));
			srows.forEach((el, i) => {
				const d = i + 0.5 - pos;
				const s = 1 + 0.2 * bell(d) * lens;
				st(el, 'transform', `translateY(${(0.2 * bellInt(d) * rowH * lens).toFixed(1)}px) scale(${s.toFixed(3)})`);
				cls(el, 'hot', lens > 0 && i === PICK_ROW);
			});
			st(fillEl, 'transform', `scaleX(${ramp(p, 0.66, 0.79).toFixed(3)})`);
			const tx = W - 10 * dp - ease(ramp(p, 0.57, 0.62)) * (W * 0.62);
			touch(tx, thumbY + selTop, !RM && p >= 0.12 ? 1 : 0);
		}

		/** Whether the keyboard is up: all the time the phone is on home, down while it is anywhere else. */
		function keyboardUp(ch: number, p: number) {
			if (ch === 1) return p < 0.42 || p >= 0.9;
			if (ch === 2) return p < 0.04 || p >= 0.97;
			if (ch === 5) return p < 0.05;
			if (ch === 6) return false;
			if (ch === 7) return p >= 0.07;
			return true;
		}

		function render(ch: number, p: number) {
			if (ch !== S.ch) {
				S.ch = ch;
				bgEl.dataset.ch = String(ch);
				beats.forEach((b, k) => b.classList.toggle('active', k + 1 === ch));
				chapters.forEach((a, k) => (k + 1 === ch ? a.setAttribute('aria-current', 'step') : a.removeAttribute('aria-current')));
				T.classList.toggle('in', ch >= 1 && ch <= 7);
				capEl.textContent = ch === 0 ? 'scroll' : ch > 7 ? 'done' : `${ch} / 7 ${NAMES[ch - 1]}`;
			}
			let touched = false;

			/* header: the clock, and the open todos */
			text(clockEl, CLOCK[Math.min(ch, 8)]);
			const added = ch > 3 || (ch === 3 && p >= 0.84);
			const ticked = ch > 5 || (ch === 5 && p >= 0.31);
			text(todosEl, String(2 + (added ? 1 : 0) - (ticked ? 1 : 0)));

			/* the log: empty at first; the newest command's group is bright, the older ones dim */
			let lastOn = -1;
			groups.forEach((g, i) => {
				const on = g.ch < ch || (g.ch === ch && p >= g.at);
				if (on !== g.on) {
					g.on = on;
					g.el.classList.toggle('on', on);
				}
				if (on) lastOn = i;
			});
			groups.forEach((g, i) => cls(g.el, 'dim', i !== lastOn));
			cls(hintEl, 'off', lastOn >= 0);

			/* the keyboard: up on home */
			const kbd = keyboardUp(ch, p);
			if (kbd !== S.kbd) {
				S.kbd = kbd;
				cls(screen, 'kb', kbd);
				measureSel();
				S.wshift = -1;
			}

			/* prompt, suggestions, keys */
			let txt = '';
			let key = '';
			for (const t of TYPES) {
				if (t.ch === ch && p >= t.a && p < t.at) {
					const n = Math.ceil(ramp(p, t.a, t.b) * t.t.length);
					txt = t.t.slice(0, n);
					key = p >= t.b ? (p >= (t.b + t.at) / 2 ? 'enter' : '') : n ? t.t.charAt(n - 1) : '';
					break;
				}
			}
			if (txt !== S.txt) {
				S.txt = txt;
				typedEl.textContent = txt;
				cls(clearEl, 'on', txt !== '');
				html(suggEl, SUG[txt] ? rowsHtml(SUG[txt]) : '');
			}
			if (key !== S.key) {
				keyFor(S.key)?.classList.remove('hit');
				const k = keyFor(key);
				k?.classList.add('hit');
				S.key = key;
				// The key preview over a letter, as Android shows it.
				const letter = k && /^[a-z]$/.test(key) ? k : null;
				cls(kpop, 'on', !!letter && !RM);
				if (letter) {
					kpop.textContent = key;
					st(kpop, 'left', `${letter.offsetLeft + letter.offsetWidth / 2}px`);
					st(kpop, 'top', `${letter.offsetTop + letter.offsetHeight}px`);
					st(kpop, '--kw', `${letter.offsetWidth}px`);
				}
			}

			/* beat 1: Maps opens, then home again */
			let o = ch === 1 ? ease(ramp(p, 0.42, 0.5)) * (1 - ease(ramp(p, 0.8, 0.9))) : 0;
			show(mapsEl, o);
			st(mapsEl, 'opacity', o.toFixed(3));
			st(mapsEl, 'transform', `scale(${(0.9 + 0.1 * o).toFixed(3)})`);

			/* beat 2: the app selector (the log fades out behind its list), then Photos opens */
			o = ch === 2 && p < 0.8 ? ease(ramp(p, 0.06, 0.12)) : 0;
			st(selEl, '--o', o.toFixed(3));
			cls(selEl, 'open', o > 0.001);
			st(logEl, 'opacity', (1 - o).toFixed(3));
			renderSel(ch, p);
			if (ch === 2 && p >= 0.12 && p < 0.8) touched = true;
			o = ch === 2 ? ease(ramp(p, 0.8, 0.84)) * (1 - ease(ramp(p, 0.92, 0.97))) : 0;
			show(photosEl, o);
			st(photosEl, 'opacity', o.toFixed(3));
			st(photosEl, 'transform', `scale(${(0.9 + 0.1 * o).toFixed(3)})`);

			/* beat 4: long-press a feed line, and its action sheet */
			if (lpLine) cls(lpLine, 'held', ch === 4 && p >= 0.52 && p < 0.93);
			o = ch === 4 ? ease(ramp(p, 0.62, 0.66)) * (1 - ease(ramp(p, 0.91, 0.95))) : 0;
			show(sheetEl, o);
			st(sheetEl, '--o', o.toFixed(3));
			if (ch === 4 && lpLine && p >= 0.46 && p < 0.64 && !RM) {
				const [x, y] = center(lpLine);
				touch(x - lpLine.offsetWidth * 0.2, y, ramp(p, 0.46, 0.5) * (1 - ramp(p, 0.6, 0.64)), 0.8 + 0.4 * ramp(p, 0.5, 0.62));
				touched = true;
			}

			/* the widgets page: beat 5 swipes to it, beat 7 back */
			const swipe = ch < 5 ? 0 : ch === 5 ? ease(ramp(p, 0.05, 0.2)) : ch === 6 ? 1 : ch === 7 ? 1 - ease(ramp(p, 0.01, 0.07)) : 0;
			st(pagesEl, 'transform', `translateX(${(-swipe * 50).toFixed(2)}%)`);
			if (ch === 5 && p >= 0.04 && p < 0.21 && !RM) {
				const w = screen.clientWidth;
				touch(w * (0.82 - 0.64 * ramp(p, 0.05, 0.2)), screen.clientHeight * 0.45, ramp(p, 0.04, 0.05) * (1 - ramp(p, 0.2, 0.21)));
				touched = true;
			}

			/* beat 5: a shortcut pressed, a todo ticked, the habit done, then the looks */
			cls(torch, 'pressed', ch === 5 && p >= 0.23 && p < 0.27);
			cls(todo1, 'done', ticked);
			const habitDone = ch > 5 || (ch === 5 && p >= 0.42);
			cls(habit, 'done', habitDone);
			text(streakEl, habitDone ? '5' : '4');
			const arrange = ch === 5 && p >= 0.53 && p < 0.92;
			cls(habit, 'picked', arrange);
			cls(wbar, 'on', arrange);
			if (arrange !== S.arrange) {
				S.arrange = arrange;
				S.wshift = -1;
			}
			let look = 'tonal';
			if (ch === 5 && p >= 0.6) look = LOOKS[Math.min(4, Math.floor((p - 0.6) / 0.06))];
			if (look !== S.look) {
				S.look = look;
				habit.dataset.look = look;
				lookEls.forEach((el) => el.classList.toggle('on', el.dataset.look === look));
				text(lookName, LOOK_NAMES[look]);
			}
			if (ch === 5 && !touched && !RM) {
				let target: Element | null = null;
				let tp = 0;
				if (p >= 0.22 && p < 0.28) [target, tp] = [torch, bump(p, 0.22, 0.28)];
				else if (p >= 0.28 && p < 0.35) [target, tp] = [$('.w-box', todo1), bump(p, 0.28, 0.35)];
				else if (p >= 0.37 && p < 0.46) [target, tp] = [$('.w-hd', habit), bump(p, 0.37, 0.46)];
				else if (p >= 0.47 && p < 0.55) [target, tp] = [$('.w-hv', habit), ramp(p, 0.47, 0.49) * (1 - ramp(p, 0.53, 0.55))];
				else if (p >= 0.57 && p < 0.87) {
					// Each look is tapped just before it shows (at 0.6, 0.66, … 0.84).
					const k = Math.min(4, Math.floor((p - 0.57) / 0.06));
					target = lookEls.find((el) => el.dataset.look === LOOKS[k]) || null;
					tp = bump(p, 0.57 + k * 0.06, 0.63 + k * 0.06);
				}
				if (target) {
					const [x, y] = center(target);
					touch(x, y, Math.min(1, tp * 2));
					touched = true;
				}
			}

			/* beat 6: the editor (the code goes in fast, as a paste); Run; back on the widgets page, + adds the Water widget; taps count */
			o = ch === 6 ? ease(ramp(p, 0.03, 0.1)) * (1 - ease(ramp(p, 0.56, 0.63))) : 0;
			show(edEl, o);
			st(edEl, 'transform', `translateY(${((1 - o) * 101).toFixed(2)}%)`);
			if (ch === 6) {
				const n = Math.round(ease(ramp(p, 0.12, 0.3)) * CODE.length);
				if (n !== S.code) {
					S.code = n;
					renderCode(n);
				}
				let target: Element | null = null;
				let tp = 0;
				if (p >= 0.45 && p < 0.54) [target, tp] = [runEl, bump(p, 0.45, 0.54)];
				else if (p >= 0.68 && p < 0.75) [target, tp] = [wplus, bump(p, 0.68, 0.75)];
				else if (p >= 0.8 && p < 0.86) [target, tp] = [waterCard, bump(p, 0.8, 0.86)];
				else if (p >= 0.89 && p < 0.95) [target, tp] = [waterCard, bump(p, 0.89, 0.95)];
				if (target && !RM) {
					const [x, y] = center(target);
					touch(x, y, Math.min(1, tp * 2));
					touched = true;
				}
			} else if (S.code !== CODE.length) {
				S.code = CODE.length;
				renderCode(CODE.length);
			}
			const water = ch > 6 ? 2 : ch === 6 ? (p >= 0.92 ? 2 : p >= 0.83 ? 1 : p >= 0.72 ? 0 : -1) : -1;
			if (water !== S.water) {
				S.water = water;
				cls(waterCard, 'on', water >= 0);
				text(waterEl, `${Math.max(0, water)} / 8`);
				st(waterLevel, 'height', `${(Math.max(0, water) / 8) * 100}%`);
				cls(waterCard, 'some', water > 0);
				S.wshift = -1;
			}
			if (S.wshift < 0) {
				// Like scrolling the page: the new card comes into view if it is below the edge.
				// While arranging, the chosen card stays clear of the toolbar, as the Widgets screen scrolls to it.
				const toolbar = S.arrange ? Math.max(0, habit.offsetTop + habit.offsetHeight + 12 * dp - (wpage.clientHeight - wbar.offsetHeight)) : 0;
				const over = Math.max(toolbar, water >= 0 ? Math.max(0, wgrid.offsetHeight - wview.clientHeight) : 0);
				S.wshift = over;
				st(wgrid, 'transform', `translateY(${-over}px)`);
			}

			if (!touched) touch(0, 0, 0);

			/* beat 7: the tour takes the phone's theme */
			let theme = 'green';
			if (ch === 7) for (const t of TYPES) if (t.theme && p >= t.at) theme = t.theme;
			applyTheme(theme);

			/* progress */
			for (let i = 0; i < 7; i++) {
				st(progSegs[i], 'transform', `scaleX(${i < ch - 1 ? 1 : i === ch - 1 ? clamp(p, 0, 1).toFixed(3) : 0})`);
			}
		}

		/* ---------- one loop ---------- */
		let raf = 0;
		function frame(now: number) {
			raf = 0;
			const sy = window.scrollY;
			if (sy !== S.sy || S.dirty) {
				S.sy = sy;
				S.dirty = false;
				const vh = window.innerHeight;
				const line = navH + (vh - navH) * (SMALL ? 0.8 : 0.6);
				let ch = 0;
				let p = 0;
				for (let i = 0; i < beats.length; i++) {
					const r = beats[i].getBoundingClientRect();
					if (r.top <= line) {
						ch = i + 1;
						p = (line - r.top) / r.height;
					} else break;
				}
				if (p >= 1) {
					ch = 8;
					p = 0;
				}
				render(ch, p);
			}
			// The background: parallax, decoding, and on large screens a slow sway while the tour is on screen.
			const tr = T.getBoundingClientRect();
			const visible = tr.bottom > 0 && tr.top < window.innerHeight;
			if (!visible || doc.hidden) return;
			const busy = backdrop.tick(now || performance.now(), sy, S.ch, RM);
			if (busy || (!RM && !SMALL)) kick();
		}
		function kick() {
			if (!raf) raf = requestAnimationFrame(frame);
		}
		function dirty() {
			S.dirty = true;
			kick();
		}
		const remeasure = () => {
			measure();
			kick();
		};

		addEventListener('scroll', kick, { passive: true });
		addEventListener('resize', remeasure);
		addEventListener('load', remeasure);
		doc.addEventListener('visibilitychange', kick);
		mqRM.addEventListener('change', remeasure);
		mqSmall.addEventListener('change', remeasure);
		new MutationObserver(() => {
			curTheme = '';
			dirty();
		}).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
		doc.fonts?.ready.then(remeasure);

		T.classList.add('js');
		measure();
		frame(0);
	}
</script>

<style is:global>
