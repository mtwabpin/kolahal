											<div class="w-tile w-th"><b>Todos</b></div>
											<div class="w-tile w-todo t-todo1"><i class="w-box"><svg><use href="#t-check" /></svg></i><span>Pay electricity bill</span></div>
											<div class="w-tile w-todo"><i class="w-box"><svg><use href="#t-check" /></svg></i><span>Book train tickets</span></div>
											<div class="w-tile w-todo"><i class="w-box"><svg><use href="#t-check" /></svg></i><span>call the bank</span></div>
										</div>
										<!-- water.lua (a progress), from the scripts beat, in Shape, 2×1: a clover filled to the level, the count in it -->
										<div class="w w21 w-water">
											<span class="w-clover"><i class="w-level"></i><b class="t-water">0 / 8</b></span>
											<span class="w-beside"><b class="w-small">Water</b><span>add a glass</span></span>
										</div>
									</div>
								</div>
								<!-- Arrange widgets' toolbar (WidgetsScreen.kt WidgetToolbar): the widget, Remove and Done; Look and Size as connected buttons. -->
								<div class="t-wbar">
									<div class="t-wb-head">
										<span class="t-wb-name"><b>Habit streak</b><span>2×2 · <span class="t-lookname">Tonal</span></span></span>
										<span class="t-wb-btn rm"><i><svg><use href="#t-delete" /></svg></i>Remove</span>
										<span class="t-wb-btn done"><i><svg><use href="#t-check" /></svg></i>Done</span>
									</div>
									<div class="t-wb-label">Look</div>
									<div class="t-cgroup t-looks"><i data-look="plain">Plain</i><i data-look="tonal" class="on">Tonal</i><i data-look="bold">Bold</i><i data-look="split">Split</i><i data-look="shape">Shape</i></div>
