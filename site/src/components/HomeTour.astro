---
/**
 * The home page's scroll tour: a simulated phone stays beside seven beats (launch, apps, answers,
 * log, widgets, scripts, themes) while the page scrolls.
 *
 * The phone is drawn from the app's code, at its proportions (about 14 % larger than a 412 dp phone, so it reads well); every
 * size is in dp (`--dp`), with the app's defaults (14 sp text, 22 dp log lines, 44 dp suggestion
 * rows, a 40 dp prompt and key bar; ui/LogView.kt, SuggestionList.kt, Prompt.kt, KeyBar.kt,
 * TerminalHeader.kt). The app selector follows ui/AppSelector.kt and SelectorMath.kt (browse by
 * apps, the wave of letters and the bubble, the fisheye and the hold fill). The widgets follow the
 * Material 3 Expressive cards (WidgetLayout: 12 columns, 8 dp gaps; ScriptWidgets.kt: 24/28 dp
 * corners; WidgetLooks.kt: the colors of each look; WidgetKinds.kt, WidgetKindLooks.kt,
 * WidgetDots.kt, WidgetControls.kt).
 *
 * Everything on the phone is a function of the scroll position: no timers, no scroll hijacking.
 * Behind it, Kolahal's log fills the free space as faint text that decodes into view and moves
 * slowly with the scroll; the current beat's lines are soft in the accent (tour-backdrop.ts). The themes beat recolors the tour only (its own element),
 * and the site's colors come back after it.
 *
 * - Reduced motion: no parallax, drift or typing; each state switches at once.
 * - Phone widths: the phone is a sticky panel at the top, one background column, no keyboard.
 * - Without JavaScript: the beats read as text, and the phone shows an empty home screen.
 *
 * The hero (title, tagline, buttons) comes in through the `intro` slot, from Hero.astro.
 */
import { LinkButton } from '@astrojs/starlight/components';
import { APK, DIRECT_DOWNLOADS } from '../release';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (href.startsWith('/') && !href.startsWith('//') ? base + href : href);

/** A round shape with [lobes] bumps, as a clip-path: an approximation of Material's shapes. */
function blob(lobes: number, depth: number, n = 120) {
	const pts: string[] = [];
	for (let i = 0; i < n; i++) {
		const t = (i / n) * Math.PI * 2;
		const r = 50 * (1 - (depth * (1 - Math.cos(lobes * t))) / 2);
		pts.push(`${(50 + r * Math.sin(t)).toFixed(2)}% ${(50 - r * Math.cos(t)).toFixed(2)}%`);
	}
	return `polygon(${pts.join(',')})`;
}
// Material shapes, as clip-paths with the same number of points, so one morphs into another.
const SHAPES = [
	`--cookie9:${blob(9, 0.13)}`,
	`--cookie12:${blob(12, 0.09)}`,
	`--clover4:${blob(4, 0.26)}`,
	`--sunny:${blob(8, 0.1)}`,
	`--wavy:${blob(14, 0.05)}`,
	`--circle:${blob(1, 0)}`,
].join(';');

