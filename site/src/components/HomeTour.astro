								<path d="M-5 106 L105 94" stroke-width="4" />
								<path d="M72 -5 L80 205" stroke-width="4" />
								<path d="M-5 30 L105 78" stroke-width="3" />
								<path d="M-5 140 L105 130" stroke-width="3" />
							</g>
