							<span class="t-part"><svg class="d"><use href="#t-alarm" /></svg><b>7:00</b></span>
							<span class="t-part"><svg class="d"><use href="#t-check" /></svg><b data-todos>2</b></span>
							<span class="t-part a">
								<svg class="t-bat" viewBox="0 0 26 14"><rect x="1" y="1.5" width="21" height="11" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6" /><rect x="3.2" y="3.7" width="13.8" height="6.6" rx="1" fill="currentColor" /><rect x="23" y="5" width="2" height="4" rx="1" fill="currentColor" /></svg><b>82%</b>
							</span>
						</span>
					</div>

					<div class="t-body">
						<div class="t-pages">
							<div class="t-page t-home">
								<div class="t-log">
									<div class="t-hint0">
										<div>Type an app name or a command</div>
										<div class="d">help lists everything<br />↑ recalls history<br />/ searches the log<br />Tap a line to use it, long-press for more<br />⚙ settings</div>
									</div>
								</div>
								<div class="t-sugg"></div>
								<div class="t-prompt">
									<b class="ps">$</b><span class="t-typed"></span><span class="t-caret"></span>
									<svg class="t-pbtn t-clear"><use href="#t-close" /></svg>
									<svg class="t-pbtn t-kbtn"><use href="#t-keyboard" /></svg>
								</div>
								<div class="t-sel">
									<div class="t-panel"><div class="t-slist"></div></div>
									<div class="t-rail"></div>
									<div class="t-bubble">B</div>
								</div>
							</div>

							<div class="t-page t-wpage">
								<div class="t-whead">
									<span>Widgets</span>
									<span class="t-wicons"><svg class="a t-wplus"><use href="#t-plus" /></svg><svg><use href="#t-pencil" /></svg></span>
								</div>
								<div class="t-wview">
									<div class="t-wgrid">
										<!-- countdown.lua in Bold, 2×2: the name small and the day, the days as big as they fit, a still wave -->
										<div class="w w22 w-count">
											<div class="w-top"><b class="w-small">Holidays</b><span>Fri 25 Dec</span></div>
											<div class="w-boldv a"><b>51</b><small>days</small></div>
											<span class="w-wave"><span class="on"><svg viewBox="0 0 160 10" preserveAspectRatio="none"><use href="#t-wave" /></svg></span><i></i></span>
										</div>
										<!-- habit.lua (a chart of dots) in Tonal, 2×2: the card whose look the Arrange toolbar changes -->
										<div class="w w22 w-habit" data-look="tonal">
											<div class="w-hv">
												<span class="w-title">Exercise</span>
												<span class="w-line"><span class="w-big t-streak">4</span><span class="w-lab">Days in a row</span></span>
											</div>
											<div class="w-hd">
												<div class="w-days">{DAYS.map((d, i) => <span class={i === 2 ? 'now' : undefined}>{d}</span>)}</div>
												<div class="w-dots">
													{HABIT.map((week, r) => (
														<div class={`w-week r${r}`}>
															{[...week].map((c) => (
																<i class={c}>{c === 't' && <b><svg><use href="#t-check" /></svg></b>}</i>
															))}
														</div>
													))}
												</div>
											</div>
											<i class="w-marks"><b class="h-end"></b><b class="h-bot"></b></i>
										</div>
										<!-- weather.lua (a stat) in Shape, 2×1: the temperature in a 12-sided cookie, the sky and the rest beside it -->
										<div class="w w21 w-wx">
											<span class="w-cookie"><b>27°C</b></span>
											<span class="w-beside"><b>Sunny</b><span>Pune · 62%</span></span>
										</div>
										<!-- aqi.js (a progress in the warning color) in Bold, 2×1: the card filled to the level, the value big -->
