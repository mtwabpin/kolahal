/*
 * The habit card's days (WidgetDots): four weeks from Monday, the last one this week. Today is
 * Wednesday. d: done, x: missed, t: today, l: later this week. The streak before today is 4.
 */
const HABIT = ['ddxdddd', 'dddxddd', 'ddddxdd', 'ddtllll'];
const DAYS = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
/** The touch key bar's default keys (Keys.kt DEFAULT_KEYBAR). */
const KEYBAR = ['/', '@', '|', '=', '+', '-', '*', 'up', 'down'];
const svg = (id: string) => `<svg><use href="#t-${id}"/></svg>`;
---

<div class="tour" data-tour style={SHAPES}>
	<svg width="0" height="0" class="t-defs" aria-hidden="true">
		{Object.entries(FILLED).map(([id, d]) => (
			<symbol id={`t-${id}`} viewBox="0 0 24 24"><path d={d} fill="currentColor" /></symbol>
		))}
		{Object.entries(STROKED).map(([id, d]) => (
			<symbol id={`t-${id}`} viewBox="0 0 24 24">
				<path d={d} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
			</symbol>
		))}
		{Object.entries(APP_ICONS).map(([name, { bg, path }]) => (
			<symbol id={`t-app-${name}`} viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill={bg} /><path d={path} fill="#fff" /></symbol>
		))}
		<symbol id="t-wave" viewBox="0 0 160 10" preserveAspectRatio="none">
			<path d="M2 5 q 5 -4 10 0 t 10 0 t 10 0 t 10 0 t 10 0 t 10 0 t 10 0 t 10 0 t 10 0 t 10 0 t 10 0" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
		</symbol>
	</svg>

	<div class="t-story">
		<div class="t-bg" aria-hidden="true">
			<div class="t-bg-in" data-ch="0"></div>
		</div>

		<section class="t-hero">
			<div class="t-intro"><slot name="intro" /></div>
			<p class="t-hint"><b aria-hidden="true">↓</b> Scroll down for a tour.</p>
		</section>

		<div class="t-stage">
			<div class="t-phone" role="img" aria-label="A simulated Kolahal home screen. It shows what the text beside it describes.">
				<div class="t-screen kb" aria-hidden="true">
					<div class="t-sbar">
						<span class="t-side"><b data-clock>4:07 PM</b><span class="d">Wed 4 Nov</span></span>
