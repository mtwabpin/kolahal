		font-family: var(--mono);
		font-size: 0.88em;
		background: color-mix(in srgb, var(--fg) 9%, var(--bg));
		color: var(--fg);
		padding: 0.1em 0.4em;
		border-radius: 0.25rem;
		white-space: nowrap;
		font-variant-ligatures: none;
	}
	.t-defs {
		position: absolute;
	}

	/* ---------- the background: a slow terminal log, behind the story only ---------- */
	.t-bg {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--bgl, 0);
		width: var(--vw, 100%);
		z-index: 0;
		overflow: clip;
		pointer-events: none;
	}
	.t-bg-in {
		/*
		 * The background stays behind: a line rests at --rest, the current beat's block at --hl,
		 * both well under the dimmest text in front. A far lane (--lane) is a little dimmer still.
		 */
		--rest: 0.09;
		--hl: 0.22;
		position: sticky;
		top: var(--nav);
		height: calc(100vh - var(--nav));
		overflow: hidden;
		mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 88%, transparent 100%);
	}
	:root[data-theme='light'] .t-bg-in {
		--rest: 0.1;
		--hl: 0.2;
	}
	/* The background's layer: tilted and a little smaller (tour-backdrop.ts sets its box and transform). */
	.t-bg-rot {
		position: absolute;
		transform-origin: 50% 50%;
	}
	/* The farthest lanes: a little soft. */
	.t-lane.t-far {
		filter: blur(0.45px);
	}
	.t-lane {
		position: absolute;
		top: 0;
		font-family: var(--mono);
		font-variant-ligatures: none;
		white-space: pre;
		overflow: hidden;
		will-change: transform;
		mask-image: linear-gradient(to right, #000 82%, transparent);
	}
	/*
	 * A group as the log draws it: the thin bar beside each line, the command a little heavier.
	 * Its colors are variables, so a glitch can borrow another theme's (amber, rose-pine).
	 */
	.t-lg {
		--ln-dim: var(--dim);
		--ln-fg: var(--fg);
		--ln-acc: var(--accent);
		position: absolute;
		left: 0;
		right: 0;
	}
	.t-lg .ln {
		position: relative;
		display: block;
		padding-left: 10px;
		overflow: hidden;
		color: var(--ln-dim);
		opacity: calc(var(--rest) * var(--u, 1) * var(--lane, 1));
		transition:
			opacity 0.8s ease,
			color 0.5s ease;
	}
	.t-lg .ln::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: 2px;
		background: color-mix(in srgb, var(--ln-acc) 60%, transparent);
		transition: background-color 0.5s ease;
	}
	.t-lg.k-div .ln::before {
		display: none;
	}
	.t-lg.k-script .ln::before {
		background: color-mix(in srgb, var(--ln-acc) 35%, var(--ln-dim));
	}
	.t-lg .ln.c {
		color: color-mix(in srgb, var(--ln-fg) 70%, var(--ln-dim));
		font-weight: 600;
	}
	/* Behind the hero, a card or the phone: thinner. */
	.t-lg .ln.u {
		--u: 0.25;
	}
	/* The current beat's block: a tint of the accent (in the themes beat, each theme's), still faint. */
	.t-bg-in[data-ch='0'] .t-lg[data-b='0'] .ln,
	.t-bg-in[data-ch='1'] .t-lg[data-b='1'] .ln,
	.t-bg-in[data-ch='2'] .t-lg[data-b='2'] .ln,
	.t-bg-in[data-ch='3'] .t-lg[data-b='3'] .ln,
	.t-bg-in[data-ch='4'] .t-lg[data-b='4'] .ln,
	.t-bg-in[data-ch='5'] .t-lg[data-b='5'] .ln,
	.t-bg-in[data-ch='6'] .t-lg[data-b='6'] .ln,
	.t-bg-in[data-ch='7'] .t-lg[data-b='7'] .ln {
		color: color-mix(in srgb, var(--ln-acc) 65%, var(--ln-dim));
		opacity: calc(var(--hl) * var(--u, 1) * var(--lane, 1));
	}
	/* Glitches: lines that borrow the amber or the rose-pine theme for a moment (Palettes: dim, fg, prompt). */
	.t-bg-in .g-amber {
		--ln-dim: #a08256;
		--ln-fg: #ffcc80;
		--ln-acc: #ffb000;
	}
	.t-bg-in .g-rose {
		--ln-dim: #908caa;
		--ln-fg: #e0def4;
		--ln-acc: #ebbcba;
	}
	:root[data-theme='light'] .t-bg-in .g-amber {
		--ln-dim: #7e6136;
		--ln-fg: #3d2a0c;
		--ln-acc: #a05f00;
	}
	:root[data-theme='light'] .t-bg-in .g-rose {
		--ln-dim: #6f6b89;
		--ln-fg: #464261;
		--ln-acc: #9c5e5b;
	}
	/* A glitched line shows its theme's accent (and the info color on its odd lines), not a dim gray. */
	.t-bg-in :is(.g-amber, .g-rose) .ln,
	.t-bg-in .ln:is(.g-amber, .g-rose) {
		color: color-mix(in srgb, var(--ln-acc) 75%, var(--ln-dim));
	}
	.t-bg-in .g-amber .ln:nth-child(even) {
		color: #d9a25f;
	}
	.t-bg-in .g-rose .ln:nth-child(even) {
		color: #9ccfd8;
	}
	:root[data-theme='light'] .t-bg-in .g-amber .ln:nth-child(even) {
		color: #8a5e22;
	}
	:root[data-theme='light'] .t-bg-in .g-rose .ln:nth-child(even) {
		color: #45767f;
	}
	/* A burst: a tiny sideways jitter, then still. */
	.t-bg-in .jit {
		animation: t-jit 0.22s steps(1) 1;
	}
	@keyframes t-jit {
		0% {
			transform: translateX(1.5px);
		}
		25% {
			transform: translateX(-1px);
		}
		50% {
			transform: translateX(2px);
		}
		75% {
			transform: translateX(-1.5px);
		}
		100% {
			transform: none;
		}
	}

	/* ---------- the story: the hero and the beats, the phone beside them ---------- */
	.t-story {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: clamp(28px, 5vw, 80px);
	}
	.t-hero {
		position: relative;
		z-index: 1;
		grid-column: 1;
		grid-row: 1;
		min-height: calc(100vh - var(--nav) - 3rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.75rem;
		padding-block: 1rem 3rem;
	}
	/* A soft backdrop, as behind the beats, so the background text stays behind the title. */
	.t-intro {
		background: var(--card);
		box-shadow: 0 0 46px 34px var(--card);
	}
	.t-hint {
		font-family: var(--mono);
		font-size: var(--sl-text-sm);
		color: var(--dim);
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.t-hint b {
		display: inline-grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border: 1px solid var(--line);
		border-radius: 0.375rem;
		color: var(--accent);
		font-weight: 500;
	}

	.t-copy {
		position: relative;
		z-index: 1;
		grid-column: 1;
		grid-row: 2;
	}
	.t-beat {
		min-height: calc(var(--len) * 1vh);
		padding-bottom: 22vh;
		scroll-margin-top: calc(var(--nav) + 18vh);
	}
	.t-card {
		position: sticky;
		top: calc(var(--nav) + 20vh);
		max-width: 31em;
		padding: 1.1rem 1.5rem 1.25rem 1.25rem;
		border-inline-start: 2px solid color-mix(in srgb, var(--bar) 70%, transparent);
		background: var(--card);
		box-shadow: 0 0 46px 34px var(--card);
		opacity: 0.4;
		transition:
			opacity 0.5s ease,
			background-color 0.6s ease,
			color 0.6s ease,
			border-color 0.6s ease;
	}
	.t-beat.active .t-card,
	.tour:not(.js) .t-card {
		opacity: 1;
	}
	.t-card > * {
		margin: 0;
	}
	.t-card > * + * {
		margin-top: 0.65rem;
	}
	.t-cmd {
		display: flex;
		justify-content: space-between;
		font-family: var(--mono);
		font-size: var(--sl-text-sm);
		color: var(--fg);
	}
	.t-cmd b {
		color: var(--accent);
	}
	.t-cmd i {
		font-style: normal;
		color: var(--dim);
	}
	.t-card h2 {
		font-family: var(--mono);
		font-weight: 700;
		font-size: clamp(1.375rem, 2.4vw, 2rem);
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--fg);
		text-wrap: balance;
	}
	.t-card p {
		line-height: 1.6;
	}
	.t-cmds {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.t-cmds li {
		margin: 0;
	}
	.t-cmds code {
		display: block;
		color: var(--info);
	}

	/* ---------- the stage and the phone ---------- */
	.t-stage {
		grid-column: 2;
		grid-row: 1 / span 2;
		position: sticky;
		top: var(--nav);
		align-self: start;
		height: calc(100vh - var(--nav));
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.9rem;
		z-index: 3;
	}
	.t-stage::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		width: 120%;
		height: 80%;
		transform: translate(-50%, -50%);
		background: radial-gradient(closest-side, var(--halo), transparent);
		pointer-events: none;
	}
	.t-phone {
		position: relative;
		width: var(--pw);
		height: var(--ph);
		flex: none;
		padding: calc(var(--pw) * 0.026);
		border-radius: calc(var(--pw) * 0.09);
		border: 1px solid var(--line);
		background: var(--surface);
		box-shadow: 0 40px 80px -36px var(--shadow);
		/* The screen's width is the phone's content box. */
		container-type: inline-size;
	}
	.t-screen {
		/*
		 * One dp. The sizes are the app's, for a 412 dp phone, drawn about 14 % larger so they read at
		 * the size of the drawing: the screen is 360 dp across (DP_ACROSS in the script). Every size on it is in dp.
		 */
		--dp: calc(100cqw / 360);
		position: relative;
		height: 100%;
		/* Concentric with the frame: its radius less the frame's padding. */
		border-radius: calc(var(--pw) * 0.064);
		background: var(--bg);
		color: var(--fg);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		font-family: var(--mono);
		font-size: calc(14 * var(--dp));
		line-height: 1.36;
		user-select: none;
		font-variant-ligatures: none;
		text-align: start;
	}
	.t-screen svg {
		width: calc(20 * var(--dp));
		height: calc(20 * var(--dp));
		flex: none;
	}
	.t-screen .d {
		color: var(--dim);
	}
	.t-screen .a {
		color: var(--accent);
	}
	.t-screen .i {
		color: var(--info);
	}
	.t-screen .l {
		color: var(--link);
	}
	.t-screen b {
		font-weight: 700;
	}
	.ps {
		color: var(--accent);
	}

	/* The header (TerminalHeader.kt): one line of 13 sp text with 6 dp above and below, time and date, then alarm, todos and battery. */
	.t-sbar {
		flex: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: calc(30 * var(--dp));
		margin-top: calc(6 * var(--dp));
		padding: 0 calc(8 * var(--dp));
		font-size: calc(13 * var(--dp));
		white-space: nowrap;
	}
	.t-side {
		display: flex;
		align-items: center;
		gap: calc(6 * var(--dp));
		padding: 0 calc(3 * var(--dp));
	}
	.t-part {
		display: flex;
		align-items: center;
		gap: calc(3 * var(--dp));
		padding: 0 calc(3 * var(--dp));
	}
	.t-screen .t-part svg {
		width: calc(15 * var(--dp));
		height: calc(15 * var(--dp));
	}
	.t-screen .t-part .t-bat {
		width: calc(24 * var(--dp));
		height: calc(13 * var(--dp));
	}

	.t-body {
		position: relative;
		flex: 1;
		min-height: 0;
		overflow: hidden;
	}
	.t-pages {
		display: flex;
		width: 200%;
		height: 100%;
		will-change: transform;
	}
	.t-page {
		position: relative;
		width: 50%;
		height: 100%;
		flex: none;
	}

	/* ---------- home: the log, the suggestion rows, the prompt ---------- */
	.t-home {
		display: flex;
		flex-direction: column;
	}
	/* The log (TerminalScreen.kt): 12 dp at the sides, 6 dp above and below, the newest line at the bottom. */
	.t-log {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: calc(6 * var(--dp)) calc(12 * var(--dp));
		mask-image: linear-gradient(to bottom, transparent 0, #000 calc(40 * var(--dp)));
	}
	/* An empty log: what to do, in the text color, then the other tips dim, one per line. */
	.t-hint0 {
		padding: calc(12 * var(--dp)) 0;
	}
	.t-hint0 .d {
		margin-top: calc(8 * var(--dp));
	}
	.t-hint0.off {
		display: none;
	}
	/* A group (log.spacing 5 dp above it). Lines are at least 22 dp, with the 2 dp gutter bar and 10 dp after it. */
	.t-g {
		display: none;
		flex: none;
		margin-top: calc(5 * var(--dp));
		transition: opacity 0.3s ease;
	}
	.t-g.on {
		display: block;
		animation: t-rise 0.3s ease-out;
	}
	.t-g.dim {
		opacity: 0.62;
	}
	@keyframes t-rise {
		from {
			opacity: 0;
			transform: translateY(0.7em);
		}
	}
	.t-ln,
	.t-o {
		position: relative;
		min-height: calc(22 * var(--dp));
		padding: calc(1.5 * var(--dp)) 0 calc(1.5 * var(--dp)) calc(10 * var(--dp));
	}
	.t-ln::before,
	.t-o::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: calc(2 * var(--dp));
		background: color-mix(in srgb, var(--accent) 45%, transparent);
	}
	.t-ln {
		display: flex;
		justify-content: space-between;
		gap: calc(8 * var(--dp));
	}
	.t-ln > span:first-child {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.t-time {
		color: var(--dim);
		font-size: calc(12 * var(--dp));
		padding-top: calc(2 * var(--dp));
	}
	.t-o {
		white-space: pre-wrap;
	}
	.t-o.held {
		background: var(--surface);
	}
	.t-two {
		display: grid;
		grid-template-columns: calc(80 * var(--dp)) 1fr;
		white-space: nowrap;
	}
	.t-o .l {
		text-decoration: underline;
		text-underline-offset: 0.18em;
		text-decoration-color: color-mix(in srgb, var(--link) 50%, transparent);
	}
	/* fmt.stats: the value 1.9 × the text, semibold; what it answers under it, 2 sp smaller, in the phone's font. */
	.t-stat {
		display: inline-flex;
		flex-direction: column;
		white-space: nowrap;
	}
	.t-stat b {
		font-size: calc(26.6 * var(--dp));
		line-height: 1.1;
		font-weight: 600;
	}
	.t-stat small {
		font: calc(12 * var(--dp)) / 1.4 var(--sans);
		color: var(--dim);
	}

	/* Suggestions (SuggestionList.kt): 44 dp rows, a 3 dp bar, 9 dp, a 24 dp icon, 8 dp, the name; the best match at the bottom. */
	.t-sugg {
		flex: none;
		display: flex;
		flex-direction: column-reverse;
		max-height: calc(4 * 44 * var(--dp));
		overflow: hidden;
	}
	.t-row {
		flex: none;
		display: flex;
		align-items: center;
		min-height: calc(44 * var(--dp));
		white-space: nowrap;
		animation: t-rise 0.2s ease-out;
	}
	.t-row.tall {
		padding: calc(4 * var(--dp)) 0;
	}
	.t-bar {
		align-self: stretch;
		width: calc(3 * var(--dp));
		margin-right: calc(9 * var(--dp));
	}
	.t-row.best {
		background: color-mix(in srgb, var(--accent) 16%, transparent);
		font-weight: 700;
	}
	.t-row.best .t-bar {
		background: var(--accent);
	}
	.t-screen .t-ic {
		width: calc(24 * var(--dp));
		height: calc(24 * var(--dp));
		margin-right: calc(8 * var(--dp));
	}
	.t-lic {
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--c);
		color: #fff;
		font: 700 calc(11 * var(--dp)) / 1 var(--sans);
	}
	.t-lab {
		flex: 1;
	}
	.t-row .t-stat {
		flex: 1;
	}
	.t-screen .t-ret {
		width: calc(17 * var(--dp));
		height: calc(17 * var(--dp));
		margin: 0 calc(12 * var(--dp));
		color: var(--dim);
	}
	/* The prompt (Prompt.kt): 40 dp, `$` and the text at 16 sp, then ✕ and the key bar's toggle. */
	.t-prompt {
		flex: none;
		display: flex;
		align-items: center;
		height: calc(40 * var(--dp));
		padding-left: calc(12 * var(--dp));
		font-size: calc(16 * var(--dp));
		white-space: pre;
	}
	.t-prompt .ps {
		margin-right: calc(9.6 * var(--dp));
	}
	.t-caret {
		display: inline-block;
		width: calc(2 * var(--dp));
		height: 1.25em;
		vertical-align: -0.25em;
		background: var(--accent);
		animation: t-blink 1s steps(1) infinite;
	}
	.t-prompt .t-caret {
		margin-right: auto;
	}
	@keyframes t-blink {
		50% {
			opacity: 0;
		}
	}
	.t-screen .t-pbtn {
		box-sizing: content-box;
		width: calc(20 * var(--dp));
		height: calc(20 * var(--dp));
		padding: 0 calc(12 * var(--dp)) 0 calc(8 * var(--dp));
	}
	.t-clear {
		color: var(--dim);
		visibility: hidden;
	}
	.t-clear.on {
		visibility: visible;
	}
	.t-kbtn {
		color: var(--dim);
	}
	.kb .t-kbtn {
		color: var(--accent);
	}

	/* The touch key bar (KeyBar.kt): 40 dp on the surface color, bold keys. Then Android's keyboard. */
	.t-keys {
		flex: none;
		display: none;
		flex-direction: column;
	}
	.kb .t-keys {
		display: flex;
		animation: t-up 0.25s ease-out;
	}
	@keyframes t-up {
		from {
			transform: translateY(40%);
		}
	}
	.t-kbar {
		display: flex;
		height: calc(40 * var(--dp));
		background: var(--surface);
	}
	.t-kbar i {
		flex: 1;
		display: grid;
		place-items: center;
		font-style: normal;
		font-weight: 700;
	}
	.t-screen .t-kbar svg {
		width: calc(18 * var(--dp));
		height: calc(18 * var(--dp));
	}
	/* Android's keyboard, drawn as Gboard draws it: rounded keys on a slightly darker panel. */
	.t-kbd {
		--key: color-mix(in srgb, var(--fg) 19%, var(--bg));
		--key-fn: color-mix(in srgb, var(--fg) 12%, var(--bg));
		--key-h: calc(44 * var(--dp));
		position: relative;
		display: flex;
		flex-direction: column;
		gap: calc(9 * var(--dp));
		padding: calc(9 * var(--dp)) calc(4 * var(--dp)) 0;
		background: color-mix(in srgb, var(--fg) 6%, var(--bg));
		font-family: var(--sans);
	}
	:root[data-theme='light'] .t-kbd {
		--key: color-mix(in srgb, #fff 80%, var(--bg));
		--key-fn: color-mix(in srgb, var(--fg) 14%, var(--bg));
		background: color-mix(in srgb, var(--fg) 8%, var(--bg));
	}
	.t-kbd > div:not(.t-kpop) {
		display: flex;
		gap: calc(6 * var(--dp));
	}
	.t-kbd .r2 {
		padding: 0 calc(20 * var(--dp));
	}
	.t-kbd i {
		position: relative;
		flex: 1 1 0;
		height: var(--key-h);
		display: grid;
		place-items: center;
		border-radius: calc(7 * var(--dp));
		background: var(--key);
		color: var(--fg);
		font-style: normal;
		font-size: calc(22 * var(--dp));
		line-height: 1;
	}
	.t-kbd i.w15 {
		flex-grow: 1.5;
	}
	.t-kbd i.fn {
		background: var(--key-fn);
	}
	.t-kbd i.sym {
		font-size: calc(14 * var(--dp));
		font-weight: 500;
	}
	.t-kbd i.space {
		flex-grow: 4.6;
	}
	.t-kbd i.enter {
		background: var(--accent);
		color: var(--bg);
		border-radius: calc(22 * var(--dp));
	}
	.t-screen .t-kbd i svg {
		width: calc(22 * var(--dp));
		height: calc(22 * var(--dp));
	}
	.t-kbd sup {
		position: absolute;
		top: calc(3 * var(--dp));
		right: calc(5 * var(--dp));
		font-size: calc(10 * var(--dp));
		color: var(--dim);
	}
	.t-kbd i.hit {
		background: color-mix(in srgb, var(--fg) 32%, var(--bg));
	}
	.t-kbd i.enter.hit {
		background: color-mix(in srgb, var(--accent) 70%, var(--fg));
	}
	/* The key preview: the letter, larger, in a balloon over the key. */
	.t-kpop {
		position: absolute;
		z-index: 2;
		width: calc(var(--kw, 36px) * 1.25);
		height: calc(58 * var(--dp));
		transform: translate(-50%, calc(-100% - 2 * var(--key-h) / 3));
		display: none;
		place-items: center;
		border-radius: calc(8 * var(--dp));
		background: color-mix(in srgb, var(--fg) 26%, var(--bg));
		box-shadow: 0 calc(4 * var(--dp)) calc(10 * var(--dp)) rgb(0 0 0 / 0.35);
		font-size: calc(30 * var(--dp));
		color: var(--fg);
	}
	.t-kpop.on {
		display: grid;
	}
	.t-kbd .t-navpill {
		align-self: center;
		margin: calc(10 * var(--dp)) 0 calc(10 * var(--dp));
	}

	/* ---------- overlays ---------- */
	.t-ov {
		position: absolute;
		inset: 0;
		background: var(--bg);
		visibility: hidden;
		will-change: transform;
		z-index: 4;
	}
	/* Another app: not Kolahal, so it has its own look. */
	.t-app {
		background: var(--surface);
		transform-origin: 50% 82%;
		font-family: var(--sans);
	}
	.t-app > svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.t-screen .t-app > svg {
		width: 100%;
		height: 100%;
	}
	.t-appbar {
		position: absolute;
		left: calc(16 * var(--dp));
		right: calc(16 * var(--dp));
		top: calc(40 * var(--dp));
		display: flex;
		align-items: center;
		gap: calc(10 * var(--dp));
		height: calc(48 * var(--dp));
		padding: 0 calc(16 * var(--dp)) 0 calc(10 * var(--dp));
		border-radius: calc(24 * var(--dp));
		background: var(--bg);
		color: var(--dim);
		font-size: calc(15 * var(--dp));
		box-shadow: 0 0.5em 1.4em -0.7em var(--shadow);
	}
	.t-screen .t-appbar svg {
		width: calc(26 * var(--dp));
		height: calc(26 * var(--dp));
	}
	.t-appbar.plain {
		position: static;
		margin: calc(40 * var(--dp)) calc(16 * var(--dp)) calc(16 * var(--dp));
		padding: 0;
		background: none;
		box-shadow: none;
		color: var(--fg);
		font-size: calc(22 * var(--dp));
	}
	.t-tiles {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2px;
	}
	.t-tiles i {
		aspect-ratio: 1;
		background: color-mix(in srgb, var(--info) 18%, var(--bg));
	}
	.t-tiles i:nth-child(3n + 1) {
		background: color-mix(in srgb, var(--link) 30%, var(--bg));
	}
	.t-tiles i:nth-child(4n + 2) {
		background: color-mix(in srgb, var(--warn) 26%, var(--bg));
	}
	.t-tiles i:nth-child(5n) {
		background: color-mix(in srgb, var(--accent) 34%, var(--bg));
	}
	.t-tiles i:nth-child(7n + 3) {
		background: color-mix(in srgb, var(--fg) 22%, var(--bg));
	}

	/*
	 * ---------- the app selector (AppSelector.kt) ----------
	 * The strip is on the right edge, 400 dp at the bottom of the log. The list opens on the left
	 * with no card: the log fades out behind it. Rows are 50 dp: the letter in a 26 dp gutter, the
	 * icon, the name in the phone's font. The wave of letters and the 40 dp bubble come out from the edge.
	 */
	.t-sel {
		position: absolute;
		inset: 0 0 calc(40 * var(--dp)) 0;
		pointer-events: none;
	}
	.t-panel {
		position: absolute;
		inset: 0 auto 0 0;
		width: var(--row-w, 60%);
		overflow: hidden;
		opacity: var(--o, 0);
		transform: translateX(calc((var(--o, 0) - 1) * 25%));
		visibility: hidden;
	}
	.t-sel.open .t-panel {
		visibility: visible;
	}
	.t-slist {
		will-change: transform;
	}
	.t-sr {
		position: relative;
		display: flex;
		align-items: center;
		height: calc(50 * var(--dp));
		padding-right: calc(12 * var(--dp));
		transform-origin: 0 50%;
		font-family: var(--sans);
		white-space: nowrap;
	}
	.t-sl {
		position: relative;
		flex: none;
		width: calc(26 * var(--dp));
		padding-left: calc(10 * var(--dp));
		font-size: calc(11 * var(--dp));
		color: color-mix(in srgb, var(--dim) 70%, transparent);
	}
	.t-screen .t-sic {
		position: relative;
		width: calc(32 * var(--dp));
		height: calc(32 * var(--dp));
		margin-right: calc(8 * var(--dp));
	}
	.t-sic.t-lic {
		font-size: calc(14 * var(--dp));
	}
	.t-sn {
		position: relative;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.t-tag {
		font-size: calc(12 * var(--dp));
		font-weight: 700;
		color: var(--work);
	}
	/* While picking: the row at the thumb has a mark (accent 14 %), its letter and name in the accent, bold. */
	.t-sr.hot {
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		border-radius: calc(6 * var(--dp));
	}
	.t-sr.hot :is(.t-sl, .t-sn) {
		color: var(--accent);
		font-weight: 700;
	}
	/* Holding still: the row fills from its start (accent 30 %), then the app opens. */
	.t-fill {
		position: absolute;
		inset: 0;
		border-radius: calc(6 * var(--dp));
		background: color-mix(in srgb, var(--accent) 30%, transparent);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}
	.t-rail {
		position: absolute;
		inset: 0;
	}
	.t-rail i {
		position: absolute;
		left: 0;
		top: 0;
		width: calc(16 * var(--dp));
		height: calc(16 * var(--dp));
		margin: calc(-8 * var(--dp)) 0 0 calc(-8 * var(--dp));
		display: grid;
		place-items: center;
		font: 500 calc(13 * var(--dp)) / 1 var(--sans);
		font-style: normal;
		color: color-mix(in srgb, var(--fg) var(--mix, 0%), var(--dim));
		opacity: 0;
		will-change: transform;
	}
	.t-bubble {
		position: absolute;
		left: 0;
		top: 0;
		width: calc(40 * var(--dp));
		height: calc(40 * var(--dp));
		margin: calc(-20 * var(--dp)) 0 0 calc(-20 * var(--dp));
		border-radius: 50%;
		background: var(--accent);
		color: var(--bg);
		display: grid;
		place-items: center;
		font: 700 calc(20 * var(--dp)) / 1 var(--sans);
		opacity: 0;
	}

	/* ---------- the long-press action sheet (ActionSheet.kt) ---------- */
	.t-sheetwrap {
		position: absolute;
		inset: 0;
		z-index: 5;
		visibility: hidden;
	}
	.t-scrim {
		position: absolute;
		inset: 0;
		background: rgb(0 0 0 / 0.5);
		opacity: var(--o, 0);
	}
	:root[data-theme='light'] .t-scrim {
		background: rgb(20 30 20 / 0.32);
	}
	.t-sheet {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		padding: calc(16 * var(--dp)) calc(20 * var(--dp)) calc(8 * var(--dp));
		border-radius: calc(28 * var(--dp)) calc(28 * var(--dp)) 0 0;
		background: var(--m-high);
		font-family: var(--sans);
		transform: translateY(calc((1 - var(--o, 0)) * 102%));
	}
	.t-sh-line {
		font-family: var(--mono);
		color: var(--dim);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.t-sh-time {
		font-family: var(--mono);
		font-size: calc(12 * var(--dp));
		color: var(--dim);
		margin: calc(2 * var(--dp)) 0 calc(6 * var(--dp));
	}
	.t-sheet i {
		font-style: normal;
		font-size: calc(16 * var(--dp));
		padding: calc(12 * var(--dp)) 0;
	}
	.t-sheet i.e {
		color: var(--error);
	}
	.t-sheet hr {
		border: 0;
		border-top: 1px solid var(--line);
		margin: calc(6 * var(--dp)) calc(-20 * var(--dp));
	}
	.t-navpill {
		align-self: center;
		width: calc(108 * var(--dp));
		height: calc(4 * var(--dp));
		border-radius: 1em;
		background: var(--fg);
		margin-top: calc(14 * var(--dp));
	}

	/*
	 * ---------- the widgets page: Material 3 Expressive cards in the phone's font ----------
	 * HostedWidgets.kt: a title row, then the grid 8 dp in from the sides, 12 columns with 8 dp gaps.
	 * A row is a quarter of the page wide, at least 88 dp (WidgetSizes.MIN_ROW_DP): on this 360 dp screen a 2×1 card is 168 × 88 dp, a 2×2
	 * 168 × 184, a 4×1 344 × 88. Corners are 28 dp (24 for a small box).
	 */
	.t-wpage {
		display: flex;
		flex-direction: column;
	}
	.t-whead {
		flex: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: calc(48 * var(--dp));
		padding: 0 calc(12 * var(--dp));
		color: var(--accent);
		font-weight: 700;
	}
	.t-wicons {
		display: flex;
	}
	.t-screen .t-wicons svg {
		box-sizing: content-box;
		width: calc(24 * var(--dp));
		height: calc(24 * var(--dp));
		padding: calc(12 * var(--dp));
		margin: 0 calc(-6 * var(--dp));
	}
	.t-wicons svg:last-child {
		color: var(--fg);
	}
	.t-wview {
		flex: 1;
		min-height: 0;
		overflow: hidden;
	}
	.t-wgrid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-auto-rows: calc(88 * var(--dp));
		gap: calc(8 * var(--dp));
		padding: calc(4 * var(--dp)) calc(8 * var(--dp));
		transition: transform 0.4s ease;
	}
	.w-count {
		grid-area: 1 / 1 / span 2 / 2;
	}
	.w-habit {
		grid-area: 1 / 2 / span 2 / 3;
	}
	.w-wx {
		grid-area: 3 / 1;
	}
	.w-aqi {
		grid-area: 3 / 2;
	}
	.w-sbtns {
		grid-area: 4 / 1 / 5 / 3;
	}
	.w-split {
		grid-area: 5 / 1 / span 2 / 2;
	}
	.w-water {
		grid-area: 5 / 2;
	}
	.w {
		position: relative;
		min-width: 0;
		border-radius: calc(28 * var(--dp));
		padding: calc(12 * var(--dp)) calc(16 * var(--dp));
		background: var(--m-high);
		color: var(--fg);
		font-family: var(--sans);
		font-size: calc(14 * var(--dp));
		line-height: 1.3;
		display: flex;
		flex-direction: column;
		justify-content: center;
		transition:
			background-color 0.35s ease,
			box-shadow 0.25s ease;
	}
	.w22 {
		grid-row: span 2;
		padding: calc(14 * var(--dp)) calc(16 * var(--dp));
		justify-content: flex-start;
	}
	.w41 {
		grid-column: span 2;
	}
	/* A value: extra bold and a little tight (asValue); headlineSmall in a wide card, titleLarge on a dots line. */
	.w-big {
		font-size: calc(24 * var(--dp));
		line-height: calc(32 * var(--dp));
		font-weight: 800;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.w-big small {
		margin-left: calc(4 * var(--dp));
		font-size: calc(16 * var(--dp));
		font-weight: 500;
		letter-spacing: 0;
		color: var(--dim);
	}
	.w-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: calc(12 * var(--dp));
	}
	.w-note {
		font-size: calc(12 * var(--dp));
		color: var(--dim);
		white-space: nowrap;
	}
	/* Bold: the card's name small (SmallTitle, 13 sp bold), the value in Bold's narrow black type. */
	.w-small {
		font-size: calc(13 * var(--dp));
		font-weight: 700;
	}
	.w-boldv {
		display: flex;
		align-items: baseline;
		gap: calc(4 * var(--dp));
		white-space: nowrap;
	}
	.w-boldv b {
		font-family: 'Roboto Condensed', 'Arial Narrow', var(--sans);
		font-stretch: condensed;
		font-weight: 900;
		line-height: 0.9;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}
	.w-boldv.a b {
		color: var(--accent);
	}
	.w-boldv small {
		font-weight: 800;
		color: var(--fg);
	}
	/* The countdown in Bold, 2×2: the name and the day, the days at 96 sp in the accent, a wave that stands still. */
	.w-count {
		justify-content: space-between;
	}
	.w-top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		font-size: calc(12 * var(--dp));
		color: var(--dim);
	}
	.w-top .w-small {
		color: var(--fg);
	}
	.w-count .w-boldv b {
		font-size: calc(80 * var(--dp));
	}
	.w-count .w-boldv small {
		font-size: calc(18 * var(--dp));
	}
	.w-wave {
		display: flex;
		align-items: center;
		gap: calc(4 * var(--dp));
		height: calc(10 * var(--dp));
		color: var(--accent);
	}
	.w-wave .on {
		flex: 0 0 66%;
		height: 100%;
	}
	.t-screen .w-wave svg {
		width: 100%;
		height: 100%;
	}
	.w-wave i {
		flex: 1;
		height: calc(4 * var(--dp));
		border-radius: 1em;
		background: color-mix(in srgb, var(--accent) 24%, transparent);
	}
	/* Shape beside, in a wide card: the main value in a shape at the start, as tall as the room; the rest beside it. */
	.w-wx,
	.w-water {
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
		padding: calc(8 * var(--dp)) calc(16 * var(--dp)) calc(8 * var(--dp)) calc(8 * var(--dp));
	}
	.w-cookie,
	.w-clover {
		position: relative;
		flex: none;
		display: grid;
		place-items: center;
		width: calc(72 * var(--dp));
		height: calc(72 * var(--dp));
		overflow: hidden;
	}
	.w-cookie {
		clip-path: var(--cookie12);
		background: var(--m-container);
	}
	.w-cookie b {
		font-size: calc(19 * var(--dp));
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.w-beside {
		display: flex;
		flex-direction: column;
		gap: calc(3 * var(--dp));
		min-width: 0;
		padding-left: calc(14 * var(--dp));
	}
	.w-beside > * {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.w-beside b {
		font-size: calc(14 * var(--dp));
	}
	.w-beside span {
		font-size: calc(12 * var(--dp));
		color: var(--dim);
	}
	/* Shape's level: a clover, empty in the highest surface, filled from the bottom in the accent. */
	.w-clover {
		clip-path: var(--clover4);
		background: var(--m-highest);
	}
	.w-level {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 0;
		background: var(--accent);
		transition: height 0.4s ease;
	}
	.w-clover b {
		position: relative;
		padding-top: calc(12 * var(--dp));
		font-size: calc(15 * var(--dp));
		font-weight: 800;
	}
	.w-water {
		display: none;
	}
	.w-water.on {
		display: flex;
		animation: t-rise 0.4s ease-out;
	}
	/* Bold's progress in the warning color: the card fills from the bottom to the level in the role's container. */
	.w-aqi {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		overflow: hidden;
		--role: var(--warn);
	}
	.w-fill {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 56%;
		background: color-mix(in srgb, var(--role) 30%, var(--bg));
	}
	.w-aqi > :not(.w-fill) {
		position: relative;
	}
	.w-aqi .w-boldv b {
		font-size: calc(46 * var(--dp));
	}
	.w-end {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		font-size: calc(12 * var(--dp));
		font-weight: 500;
		white-space: nowrap;
	}
	/* Todos in Split: no card; a 40 dp tile with the name, then a tile for each row, 4 dp apart, 28 dp outside corners, 8 dp inside. */
	.w-split {
		padding: 0;
		background: transparent;
		gap: calc(4 * var(--dp));
		justify-content: flex-start;
	}
	.w-tile {
		display: flex;
		align-items: center;
		flex: 1;
		min-height: 0;
		border-radius: calc(8 * var(--dp));
		background: var(--m-high);
		white-space: nowrap;
		overflow: hidden;
	}
	.w-th {
		flex: none;
		height: calc(40 * var(--dp));
		padding: 0 calc(18 * var(--dp));
		border-radius: calc(28 * var(--dp)) calc(28 * var(--dp)) calc(8 * var(--dp)) calc(8 * var(--dp));
		font-size: calc(14 * var(--dp));
	}
	.w-tile:last-child {
		border-radius: calc(8 * var(--dp)) calc(8 * var(--dp)) calc(28 * var(--dp)) calc(28 * var(--dp));
	}
	.w-todo {
		padding-right: calc(16 * var(--dp));
		font-weight: 600;
	}
	.w-todo span {
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* RowCheck: a rounded square, 18 dp; open, an outline in the quiet color; done, filled with a check. */
	.w-box {
		flex: none;
		display: grid;
		place-items: center;
		box-sizing: border-box;
		width: calc(18 * var(--dp));
		height: calc(18 * var(--dp));
		margin: 0 calc(10 * var(--dp)) 0 calc(6 * var(--dp));
		border: calc(2 * var(--dp)) solid var(--dim);
		border-radius: calc(5 * var(--dp));
		color: var(--m-high);
	}
	.w-todo .w-box {
		margin-left: calc(12 * var(--dp));
	}
	.t-screen .w-box svg {
		width: calc(14 * var(--dp));
		height: calc(14 * var(--dp));
		visibility: hidden;
	}
	.w-todo.done .w-box {
		background: var(--accent);
		border-color: var(--accent);
	}
	.w-todo.done .w-box svg {
		visibility: visible;
	}

	/* The habit (habit.lua: a chart of dots). Plain: the value and its label on one line, over the calendar. */
	.w-habit {
		gap: calc(4 * var(--dp));
	}
	.w-hv {
		position: relative;
	}
	.w-title {
		display: none;
		font-size: calc(13 * var(--dp));
		font-weight: 700;
	}
	.w-line {
		display: flex;
		align-items: baseline;
		gap: calc(6 * var(--dp));
		white-space: nowrap;
	}
	.w-habit .w-big {
		font-size: calc(22 * var(--dp));
		line-height: calc(28 * var(--dp));
	}
	.w-lab {
		color: var(--dim);
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.w-hd {
		flex: 1;
		display: flex;
		flex-direction: column;
		min-height: 0;
	}
	.w-days,
	.w-week {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		justify-items: center;
		align-items: center;
	}
	.w-days {
		height: calc(16 * var(--dp));
		font-size: calc(11 * var(--dp));
		font-weight: 500;
		color: var(--dim);
	}
	.w-days .now {
		color: var(--fg);
		font-weight: 700;
