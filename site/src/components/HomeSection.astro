---
/**
 * A section of the home page: its heading (with an id, for links), an optional link at the end of
 * the heading's line, an optional lead under it (the `lead` slot), then what the section shows,
 * and an optional note in the lead's style after it (the `foot` slot).
 */
interface Props {
	id: string;
	title: string;
	/** A link beside the heading, such as "All 33 shaders". Site-absolute, like the Markdown links. */
	link?: { href: string; text: string };
}
const { id, title, link } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (href.startsWith('/') && !href.startsWith('//') ? base + href : href);
---

<section class="s-sec not-content" aria-labelledby={id}>
	<div class="s-head">
		<h2 id={id}>{title}</h2>
		{
			link && (
				<a class="s-more" href={withBase(link.href)}>
					{link.text}
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M5 12h14M13 6l6 6-6 6" />
					</svg>
				</a>
			)
		}
	</div>
	{Astro.slots.has('lead') && <div class="s-lead"><slot name="lead" /></div>}
	<slot />
	{Astro.slots.has('foot') && <div class="s-lead s-foot"><slot name="foot" /></div>}
</section>

<style>
	.s-sec {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		margin-top: 5.5rem;
		color: var(--s-ink-soft);
		font-family: var(--s-font-text);
		font-size: 1.0625rem;
		line-height: 1.6;
	}
	.s-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1.5rem;
	}
	.s-sec h2 {
		margin: 0 auto 0 0;
		font-family: var(--s-font-display);
		font-weight: 700;
		font-size: clamp(1.875rem, 3.4vw, 2.25rem);
		line-height: 1.1;
		letter-spacing: -0.015em;
		color: var(--s-ink);
		scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
	}
	/* Only the section's own heading look: nothing the page puts before its headings. */
	.s-sec h2::before {
		content: none;
	}
	.s-more {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-height: 2.75rem;
		font-size: 1rem;
		font-weight: 600;
		color: var(--s-link);
		text-decoration: none;
	}
	.s-more:hover {
		color: var(--s-link-hover);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.s-more svg {
		width: 1.125rem;
		height: 1.125rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* Under the heading, closer to it than the rest. */
	.s-lead {
		max-width: 42em;
		margin-top: -0.75rem;
	}
	.s-foot {
		margin-top: 0;
	}
	.s-lead.s-foot {
		font-size: 1rem;
	}
	.s-lead :global(p) {
		margin: 0;
	}
	.s-lead :global(p + p) {
		margin-top: 0.75rem;
	}
	.s-lead :global(a) {
		color: var(--s-link);
		text-underline-offset: 0.2em;
	}
	.s-lead :global(a:hover) {
		color: var(--s-link-hover);
	}
	.s-lead :global(code) {
		font-family: var(--s-font-mono);
		font-size: 0.88em;
		padding: 0.1em 0.4em;
		border-radius: 0.375rem;
		background: var(--s-wash);
		color: var(--s-ink);
	}
	.s-sec :global(a:focus-visible) {
		outline: 2px solid var(--s-link);
		outline-offset: 3px;
	}
</style>
