---
/**
 * One to three captures of the app side by side, each with a short caption under it, taken by
 * name from `src/assets/` (shots.ts). A picture whose file isn't there yet shows its stand-in, or
 * nothing: the row is one picture shorter, and with none it isn't drawn at all.
 *
 * - `file`: the capture's path under `src/assets/` (`shots/typing/ma.png`). A `-light` twin beside
 *   it (`ma-light.png`) is shown in the site's light theme instead.
 * - `standIn`: an older picture shown until the capture is there.
 * - `alt` says what the capture shows; `caption` is the line under it.
 * - `wide`: pictures wider than tall (a page of the website), up to two to a row, one alone filling it.
 * - Text between the tags (Markdown) is one caption under the whole row: the row is then a figure.
 */
import { Image } from 'astro:assets';
import { hasShot, lightOf, shot } from '../shots';

interface Item {
	file: string;
	standIn?: string;
	alt: string;
	caption?: string;
}
interface Props {
	items: Item[];
	wide?: boolean;
}

const { wide } = Astro.props;
const items = Astro.props.items
	.map((it) => ({ ...it, src: shot(it.file, it.standIn), light: hasShot(it.file) ? lightOf(it.file) : undefined }))
	.filter((it) => it.src);
const width = wide ? 600 : 280;
const rowCaption = Astro.slots.has('default');
const Row = rowCaption ? 'figure' : 'div';
---

{
	items.length > 0 && (
		<Row class:list={['shots-row not-content', { wide, single: wide && items.length === 1 }]}>
			{items.map((it) => (
				<figure>
					<Image src={it.src!} alt={it.alt} width={width} densities={[1, 2]} class:list={{ 'for-dark': it.light }} />
					{it.light && <Image src={it.light} alt={it.alt} width={width} densities={[1, 2]} class="for-light" />}
					{it.caption && <figcaption set:html={it.caption} />}
				</figure>
			))}
			{rowCaption && (
				<figcaption class="row-caption">
					<slot />
				</figcaption>
			)}
		</Row>
	)
}

<style>
	.shots-row {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
		align-items: start;
		gap: 1.5rem 1.25rem;
		margin-block: 1.5rem;
	}
	figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		max-width: 17.5rem;
	}
	figure :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
		border-radius: var(--s-radius-m);
		border: 1px solid var(--s-phone-edge);
	}
	figure :global(.for-light) {
		display: none;
	}
	:global(:root[data-theme='light']) figure :global(.for-light) {
		display: block;
	}
	:global(:root[data-theme='light']) figure :global(.for-dark) {
		display: none;
	}
	figcaption {
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--s-ink-soft);
	}
	figure.shots-row {
		max-width: none;
	}
	.wide {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
	}
	.wide.single {
		grid-template-columns: 1fr;
	}
	.wide figure {
		max-width: none;
	}
	.row-caption {
		grid-column: 1 / -1;
		margin-top: -0.75rem;
	}
	.row-caption :global(p) {
		margin: 0;
	}
</style>
