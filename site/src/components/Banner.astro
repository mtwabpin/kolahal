---
/**
 * Starlight Banner override. During the alpha test (DIRECT_DOWNLOADS off, release.ts), every page but the alpha
 * test's own opens with one quiet line about it, with a small label. Otherwise, Starlight's banner.
 */
import Default from '@astrojs/starlight/components/Banner.astro';
import { DIRECT_DOWNLOADS } from '../release';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const show = !DIRECT_DOWNLOADS && Astro.locals.starlightRoute.id !== 'getting-started/play-testing';
---

{
	show ? (
		<p class="k-alpha" data-pagefind-ignore>
			<span class="tag">alpha</span>
			Kolahal is in alpha testing on Google Play. <a href={`${base}/getting-started/play-testing/`}>Join the test</a>
		</p>
	) : (
		<Default />
	)
}

<style>
	.k-alpha {
		margin: 0;
		padding: 1rem var(--sl-content-pad-x) 0;
		color: var(--s-ink-soft);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		text-align: center;
		text-wrap: balance;
	}
	/* A small upper-case label on a tinted, rounded chip. */
	.tag {
		display: inline-block;
		margin-inline-end: 0.5em;
		border-radius: 0.375rem;
		padding: 0.0625rem 0.5em;
		background: var(--s-wash);
		color: var(--s-ink);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}
	a {
		color: var(--s-link);
		font-weight: 600;
		white-space: nowrap;
		text-underline-offset: 0.2em;
	}
	a:hover {
		color: var(--s-link-hover);
	}
</style>
