<?xml version="1.0" encoding="utf-8"?>
<!--
  Kolahal Extras: what Google Play keeps out of Kolahal's Play build, for Kolahal alone.
  - READ_CONTACTS: people by name in call, sms and contacts.
  - READ_CALL_LOG: calls in Kolahal's log.
  - An accessibility service that only locks the screen.
  No INTERNET: the app that can read the contacts and the calls can reach no network.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Kolahal's release and debug packages: the screen says whether it is installed, and with which key. -->
    <queries>
        <package android:name="com.mtwabpin.kolahal" />
        <package android:name="com.mtwabpin.kolahal.debug" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Extras">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The one way in: it checks on every call that the caller is Kolahal, signed with this app's key. -->
        <provider
            android:name=".ExtrasProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true" />

        <!-- Locks the screen when Kolahal asks (performGlobalAction only; reads nothing). -->
        <service
            android:name=".LockService"
            android:exported="false"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>
    </application>
</manifest>
