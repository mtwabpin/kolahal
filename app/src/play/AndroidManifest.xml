<?xml version="1.0" encoding="utf-8"?>
<!--
  The play build type, for Google Play: the app without what Play's policy rules out, or would
  want a declaration and a video for.
  - No accessibility service: Play doesn't count a launcher as an accessibility tool. No
    double-tap lock, no `lock`.
  - No call log: Play allows it only to phone, SMS and assistant apps. No calls in the log, no `calls`.
  - No contacts: Play's Contacts policy wants the contact picker where it will do. `call`, `sms` and
    `contacts` open Android's contact picker and remember who you pick.
  The notification listener stays: `notifs enable` says what it reads and asks before Android's
  Notification access screen opens (Play's prominent disclosure).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALL_LOG" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove" />
  <uses-permission
    android:name="android.permission.REQUEST_INSTALL_PACKAGES"
    tools:node="remove" />

    <application>
        <service
            android:name=".gesture.LockService"
            tools:node="remove" />
      <provider
    android:name="androidx.core.content.FileProvider"
    tools:node="remove" />

<receiver
    android:name=".terminal.UpdateCleanupReceiver"
    tools:node="remove" />
    </application>
</manifest>
