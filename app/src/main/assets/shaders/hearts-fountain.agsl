// @name Hearts fountain
// @description Hearts burst from one point at the bottom, fan up and out, and fade near the top of their arcs
// @once 6
// @suits dark good, light good, wallpaper good, apps good
// @param amount 0.2..1.6 = 1.0 Number of hearts
//
// For four seconds a heart leaves the middle of the bottom edge every 0.15 s, to the left and to the right in
// turn. Each flies its own arc under one gravity: it pops out to its size, is drawn out while it is fast,
// tumbles, and fades a little past the top of its arc. Only the hearts in the air are tried, thirteen at most,
// and most of them are let go by their height alone.
// It is rated for other apps (apps good): there content is clear, and the hearts alone are returned, laid
// over the app as they are. Nothing is drawn between them: no veil, and no color of the page.

uniform shader content;
uniform float2 resolution;
uniform float progress;
uniform float amount;

// A number from 0 to 1 that looks random for each p (Dave Hoskins' hash without sine).
float hash(float2 p) {
    float3 q = fract(float3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

// How far p is from a heart about 1 high whose tip is at 0 and which points up (Inigo Quilez' distance).
float heart(float2 p) {
    p.x = abs(p.x);
    if (p.x + p.y > 1.0) {
        float2 d = p - float2(0.25, 0.75);
        return length(d) - 0.3535534;
    }
    float2 a = p - float2(0.0, 1.0);
    float m = 0.5 * max(p.x + p.y, 0.0);
    float2 b = p - float2(m, m);
    return sqrt(min(dot(a, a), dot(b, b))) * (p.x < p.y ? -1.0 : 1.0);
}

// How one heart looks at p, measured from its middle in units of its size, y down. d is heart() there, soft how
// wide its edge is in the same units, and tone, from 0 to 1, its own shade. It gives the color already multiplied
// by how much of the heart is there, and that amount.
half4 heartLook(float2 p, float d, float soft, float tone) {
    float shape = 1.0 - smoothstep(-soft, soft, d);
    if (shape <= 0.0) return half4(0.0);
    // Rose to red, lighter toward the upper left, with a small bright spot.
    float3 own = mix(float3(1.0, 0.42, 0.55), float3(0.91, 0.16, 0.30), tone);
    own += 0.16 * clamp(-p.x - p.y, -0.6, 0.8);
    own += 0.45 * (1.0 - smoothstep(0.04, 0.13, length(p - float2(-0.20, -0.24))));
    return half4(float4(clamp(own, 0.0, 1.0) * shape, shape));
}

// p turned by the angle a.
float2 turn(float2 p, float a) {
    return float2(p.x * cos(a) - p.y * sin(a), p.x * sin(a) + p.y * cos(a));
}

half4 main(float2 xy) {
    float4 here = float4(content.eval(xy));
    if (progress <= 0.0 || progress >= 1.0) return half4(here);

    // Seconds since it began, and one gravity for all, in pixels a second each second.
    float now = progress * 6.0;
    float g = 1.05 * resolution.y;
    float side = xy.x - 0.5 * resolution.x;
    // How often a heart leaves. None lasts more than 1.72 s, so the first that can be in the air is this one.
    float every = 0.15 / max(amount, 0.1);
    float first = floor((now - 1.82) / every - 0.6) + 1.0;

    float3 color = float3(0.0);
    float cover = 0.0;
    for (int i = 0; i < 21; i++) {
        // The hearts from the first on, until one hasn't left yet, or the last has.
        float k = first + float(i);
        if (k * every > now - 0.1 || k > 26.0 * amount) break;
        if (k < 0.0) continue;
        // They go left and right in turn, and one never crosses far over the middle.
        float right = mod(k, 2.0);
        if (abs(side) > 0.105 * resolution.x && (side > 0.0 ? 1.0 : 0.0) != right) continue;
        float r1 = hash(float2(k, 3.7));
        float age = now - 0.1 - every * (k + 0.6 * r1);
        if (age <= 0.0) continue;

        // How high it gets, and so how long it takes: it lasts a little past its top, where it starts to fall.
        float r2 = hash(float2(k, 11.3));
        float top = resolution.y * mix(0.48, 0.92, r2);
        float up = sqrt(2.0 * top / g);
        float t = age / (1.3 * up);
        if (t >= 1.0) continue;
        // Where it is, tried first with the largest size a heart has, then with its own.
        float path = resolution.y - g * up * age + 0.5 * g * age * age;
        float most = 0.11 * resolution.x;
        if (xy.y < path - 0.65 * most || xy.y > path + 1.45 * most) continue;
        float aim = (2.0 * right - 1.0) * (0.03 + 0.41 * fract(floor(0.5 * k) * 0.618 + 0.3));
        float across = 0.5 * resolution.x + aim * resolution.x * age / up;
        if (abs(xy.x - across) > 1.05 * most) continue;
        float r3 = hash(float2(k, 23.9));
        float size = resolution.x * mix(0.05, 0.11, r3 * r3);
        float high = path + 0.4 * size;
        if (abs(xy.y - high) > 1.05 * size || abs(xy.x - across) > 1.05 * size) continue;

        // It pops out past its size and settles, is drawn out along its way while it is fast, and tumbles.
        float grow = max(1.0 - exp(-9.0 * age) * cos(13.0 * age), 0.001);
        float fast = max(1.0 - age / up, 0.0);
        float pull = 1.0 + 0.25 * fast * fast;
        float2 p = turn(float2(xy.x - across, xy.y - high) / (size * grow), 0.9 * aim + (r1 - 0.5) * 1.1 * age);
        p = float2(p.x * pull, p.y / pull);
        if (abs(p.x) > 0.8 || abs(p.y) > 0.8) continue;

        float shown = (1.0 - smoothstep(0.66, 1.0, t)) * mix(0.80, 0.95, r3);
        float4 look = float4(heartLook(p, heart(float2(p.x, 0.55 - p.y)), 1.2 / (size * grow), r3)) * shown;
        color = color * (1.0 - look.a) + look.rgb;
        cover = cover * (1.0 - look.a) + look.a;
    }
    return half4(here * (1.0 - cover) + float4(color, cover));
}
