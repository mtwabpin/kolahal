// @name Rain
// @description A calm rain out of the window, away from you: short streaks that fall slowly, nearly straight down, and mist. A touch holds it off
// @suits dark good, light fair, wallpaper good
// @animated
// @param amount 0.0..2.0 = 1.0 Amount of rain
// @param speed 0.5..3.0 = 1.0 Speed of the rain
//
// A calm rain to leave on all day, seen out of a window: all of it some way off. Three far depths
// of short, thin, faint streaks, each about ten times as long as it is wide, that differ only a
// little in size and speed. At a speed of 1 they cross the screen in eleven to twelve seconds,
// nearly straight down with a slight lean. Amount sets how many drops there are and speed how fast
// they fall; neither changes the other. Slow waves of heavier and lighter rain dim and brighten it,
// and in a heavy rain light swells far off now and then. It only shows where the page does, so
// text stays as it is. Three steps a pixel at most, most of them ending early.

uniform shader content;
uniform float2 resolution;
uniform float2 cell;
uniform float time;
uniform float2 touch;
uniform float touchAge;
uniform float pressed;
uniform float dark;
layout(color) uniform half4 bg;
layout(color) uniform half4 surface;
layout(color) uniform half4 fg;
layout(color) uniform half4 info;
uniform float amount;
uniform float speed;

// A number from 0 to 1 that looks random for each p (Dave Hoskins' hash without sine).
float hash(float2 p) {
    float3 q = fract(float3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

// Smooth noise from 0 to 1: the hash at the corners of a square, blended.
float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + float2(1.0, 0.0)), f.x),
               mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), f.x), f.y);
}

half4 main(float2 xy) {
    float4 here = float4(content.eval(xy));
    // Not over text: a pixel that differs from the page is text or a line. Where it differs fully,
    // there is nothing to draw.
    float d = min(length(here.rgb - float3(bg.rgb) * here.a), length(here.rgb - float3(surface.rgb) * here.a));
    float clear = 1.0 - clamp(d * 5.0, 0.0, 1.0);
    if (clear <= 0.0) {
        return half4(here);
    }
    float2 size = resolution;
    // Time, wrapped once an hour, so the fall stays smooth when the shader is on for days.
    float t = mod(time, 3600.0);
    // The finest streak's half width, in pixels: about one on a phone, more on a sharper screen.
    float unit = max(1.0, cell.y / 44.0);

    // The air: very large sheets of heavier and lighter rain that drift slowly down and across, so
    // it comes in gentle waves: one passes down the screen in about half a minute.
    float sheet = noise(float2(xy.x / size.x * 1.1 + t * 0.015, xy.y / size.y * 0.75 - t * 0.025));

    // The wind's slant: how far the rain goes sideways for each pixel it falls. A fixed one, so the
    // whole field never shifts at once.
    float slant = 0.05;

    // What grows a little from one depth to the next: the width of a streak, the room each streak
    // has across, the room between two drops down a streak, and the speed. All three depths are far
    // off, so they differ only a little. At a speed of 1 the rain crosses the screen in eleven to
    // twelve seconds on average.
    float scale = 1.0;
    float width = size.x / 100.0;
    float gap = size.y * 0.045;
    float fall = size.y * 0.08 * speed;
    // A streak's length: a short stroke, about ten times as long as it is wide, at every speed.
    float stroke = unit * 18.0;

    float rain = 0.0;
    for (int i = 0; i < 3; i++) {
        // Each depth after the first: a little wider, with a little more room and speed.
        if (i > 0) {
            scale *= 1.12;
            width *= 1.25;
            gap *= 1.2;
            fall *= 1.08;
        }
        // How near this depth is, from 0 (farthest) to 1 (still far).
        float near = float(i) / 2.0;

        // The point this depth's streaks spread from, far above the screen.
        float above = size.y * mix(10.0, 8.0, near);
        float2 from = xy - float2(size.x * 0.5 - slant * (above + size.y * 0.5), -above);
        // Across: which streak, counted by angle, so the streaks widen a little as they come down.
        // Along: how far down its streak.
        float spread = from.y / (above + size.y * 0.5);
        float at = from.x / (spread * width) + near * 7.3;
        float col = floor(at);
        // Each streak lies in the middle 0.4 of its room across, so a pixel near the room's edge
        // misses it.
        float thick = unit * 0.8 * scale * spread;
        float across = fract(at);
        if (max(0.3 - across, across - 0.7) * spread * width >= thick) {
            continue;
        }
        // Each streak falls at its own pace, so no two are in step.
        float own = hash(float2(col, near * 53.0 + 1.0));
        float y = (from.y - t * fall * (0.8 + 0.4 * own)) / gap + own * 7.0;
        float drop = floor(y);
        float part = fract(y);
        // A drop's head is at 0.8 down its room, with its short trace above it; the head is a few
        // pixels.
        float most = min(0.7, stroke * scale / gap);
        float head = unit * 2.0 / gap;
        if (part <= 0.8 - most || part >= 0.8 + head) {
            continue;
        }

        // Which drops are there: fewer at an amount of 1 than its share of 2, so a usual rain is
        // calm. A drop is there for its whole fall: the waves only dim it.
        float r = hash(float2(col * 1.7 + near * 31.0, mod(drop, 512.0)));
        float there = step(1.0 - amount * (0.4 + 0.3 * amount) * mix(0.6, 0.45, near), r);

        // Its width: a thin line, and each drop its own.
        float off = abs(across - mix(0.3, 0.7, fract(r * 3.1))) * spread * width;
        float wide = thick * mix(0.65, 1.0, fract(r * 11.3));
        // A drop that isn't there, or a pixel beside its streak: nothing of this depth.
        if (there <= 0.0 || off >= wide) {
            continue;
        }
        float line = 1.0 - smoothstep(wide * 0.35, wide, off);
        line *= line;

        // The streak: a soft tail that grows toward the head, each one its own length.
        float len = most * mix(0.7, 1.0, fract(r * 7.3));
        float tail = smoothstep(0.8 - len, 0.8 - 0.5 * len, part) * (1.0 - smoothstep(0.8, 0.8 + head, part));

        // Faint, and a little clearer in the less far depths, but never bright.
        float bright = mix(0.24, 0.32, near) * mix(0.7, 1.0, fract(r * 5.9));
        rain += tail * line * bright * (0.7 + 0.6 * sheet);
    }

    // Haze: the far rain as mist, thicker lower down and where a heavy sheet is.
    float low = smoothstep(0.15, 0.75, xy.y / size.y);
    float haze = (0.03 + 0.07 * low) * (0.55 + 0.6 * sheet);

    // In a heavy rain only (an amount over 1), far off, now and then, light swells softly in the
    // haze near the top and dies away: once in about a minute, and never bright. Only where the page
    // is dark.
    float flicker = 0.0;
    if (dark > 0.0 && amount > 1.0) {
        float turn = floor(t / 31.0);
        float age = t - turn * 31.0 - 3.0 - 20.0 * hash(float2(turn, 5.0));
        float swell = step(0.5, hash(float2(turn, 9.0))) * smoothstep(0.0, 0.6, age) * exp(-max(age, 0.0) * 1.5);
        if (swell != 0.0) {
            float2 glowAt = (xy - size * float2(0.2 + 0.6 * hash(float2(turn, 2.0)), 0.08)) / size.x;
            flicker = dark * 0.05 * smoothstep(1.0, 1.8, amount) * swell * exp(-dot(glowAt, glowAt) * 2.5) * (0.5 + 0.7 * sheet);
        }
    }

    // A finger holds the rain off, as an umbrella would: a dry round space while it is down and
    // for a moment after, with drops breaking on its upper edge.
    float held = step(0.0, touch.x) * max(pressed, 1.0 - smoothstep(0.0, 1.2, touchAge));
    float dry = 0.0;
    if (held > 0.0) {
        float2 away = xy - touch;
        float far = length(away);
        float dome = cell.y * 3.2;
        dry = held * (1.0 - smoothstep(dome * 0.85, dome * 1.1, away.y > 0.0 ? abs(away.x) : far))
            * (1.0 - smoothstep(dome * 2.0, dome * 7.0, away.y));
        float rim = held * (1.0 - smoothstep(0.0, cell.y * 0.22, abs(far - dome))) * max(0.0, -away.y / max(far, 1.0));
        if (rim > 0.0) {
            float spray = hash(float2(floor(atan(away.x, -away.y) * 14.0), floor(t * 6.0)));
            rim *= 0.35 + 0.65 * step(0.55, spray);
        }
        rain = rain * (1.0 - 0.92 * dry) + rim * 0.3 * min(amount, 1.0);
    }

    float cover = clamp(rain, 0.0, 1.0) * mix(0.9, 1.0, dark);
    cover = cover + (1.0 - cover) * clamp(haze * (1.0 - 0.6 * dry) + flicker, 0.0, 1.0);

    // Less over the edges of text.
    cover *= clear;

    float3 color = mix(float3(info.rgb), float3(fg.rgb), 0.45 * dark);
    return half4(here * (1.0 - cover) + float4(color * cover, cover));
}
