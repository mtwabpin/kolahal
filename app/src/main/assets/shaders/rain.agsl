// @name Rain
// @description A storm you stand in: mist far off, rain in between, and big soft drops that rush past close by. A touch holds it off
// @animated
// @param amount 0.0..2.0 = 1.0 Amount of rain
//
// Five depths of rain, from a far curtain of fine, slow streaks to a few near drops many times as
// wide and fast. The far rain falls straight; the nearer it is, the more its streaks spread out from
// a point above the screen, as rain does when you look up into it. Leaning the phone moves that
// point. The rain only shows where the page does, so text stays as it is.

uniform shader content;
uniform float2 resolution;
uniform float2 cell;
uniform float time;
uniform float2 touch;
uniform float touchAge;
uniform float pressed;
uniform float2 tilt;
uniform float dark;
layout(color) uniform half4 bg;
layout(color) uniform half4 surface;
layout(color) uniform half4 fg;
layout(color) uniform half4 info;
uniform float amount;

// A number from 0 to 1 that looks random for each p (Dave Hoskins' hash without sine).
float hash(float2 p) {
    float3 q = fract(float3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

// Smooth noise from 0 to 1: the hash at the corners of a square, blended.
float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + float2(1.0, 0.0)), f.x),
               mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), f.x), f.y);
}

half4 main(float2 xy) {
    float4 here = float4(content.eval(xy));
    float2 size = resolution;
    // Time, wrapped once an hour, so the fall stays smooth when the shader is on for days.
    float t = mod(time, 3600.0);
    // The finest streak's width, in pixels: about a dp.
    float unit = max(1.0, cell.y / 44.0);

    // The air: very large sheets of heavier and lighter rain that drift down and across, so it
    // comes in waves.
    float sheet = noise(float2(xy.x / size.x * 1.4 + t * 0.09, xy.y / size.y * 0.9 - t * 0.16));
    sheet = 0.5 * sheet + 0.5 * noise(float2(xy.x / size.x * 0.6 - t * 0.05, xy.y / size.y * 0.5 - t * 0.07) + 9.0);

    // The wind's slant and the phone's lean: how far the rain goes sideways for each pixel it falls.
    float slant = 0.07 + 0.45 * tilt.x;

    // What grows from one depth to the next: the width of a streak (1 to 18 in all), the room each
    // streak has across, the room between two drops down a streak, and the speed.
    float scale = 1.0;
    float width = size.x / 100.0;
    float gap = size.y * 0.05;
    float speed = size.y * 0.45;

    float rain = 0.0;
    for (int i = 0; i < 5; i++) {
        // How near this depth is, from 0 (far) to 1.
        float near = float(i) / 4.0;

        // The point this depth's streaks spread from: far above the screen for the far rain, which
        // falls straight, and close above it for the near drops. Leaning forward or back brings it
        // nearer or takes it away.
        float above = size.y * mix(9.0, 0.9, near) * (1.0 + 0.3 * tilt.y);
        float2 from = xy - float2(size.x * 0.5 - slant * (above + size.y * 0.5), -above);
        // Across: which streak, counted by angle, so the streaks widen as they come down. Along: how
        // far down its streak.
        float spread = from.y / (above + size.y * 0.5);
        float at = from.x / (spread * width) + near * 7.3;
        float col = floor(at);
        float own = hash(float2(col, near * 53.0 + 1.0));
        float y = (from.y - t * speed * (0.85 + 0.3 * own)) / gap + own * 7.0;
        float drop = floor(y);
        float part = fract(y);

        // Which drops are there: more where a heavy sheet passes, and only a few of the near ones.
        float r = hash(float2(col * 1.7 + near * 31.0, mod(drop, 512.0)));
        float there = step(1.0 - amount * (1.0 - mix(0.62 - 0.34 * sheet, 0.66, near * near)), r);

        // The streak: a head and a tail behind it, sharp far off and soft at both ends close by.
        float len = mix(0.25, 0.6, fract(r * 7.3));
        float head = mix(0.02, 0.18, near);
        float tail = smoothstep(0.8 - len, 0.8 - 0.3 * len * near, part) * (1.0 - smoothstep(0.8, 0.8 + head, part));

        // Its width: a thin line far off, a wide blur close by, out of focus.
        float off = abs(fract(at) - mix(0.25, 0.75, fract(r * 3.1))) * spread * width;
        float thick = unit * 0.9 * scale * spread;
        float line = 1.0 - smoothstep(thick * mix(0.4, 0.0, near), thick, off);
        line *= line;

        // Far rain is faint, the middle is clearest, and the near blur is faint again.
        float bright = mix(0.20, 0.42, near) * mix(1.0, 0.5, smoothstep(0.5, 1.0, near));
        rain += there * tail * line * bright * mix(0.6 + 0.8 * sheet, 1.0, near);

        // The next depth: twice as wide, with more room and more speed.
        scale *= 2.06;
        width *= 2.56;
        gap *= 2.21;
        speed *= 1.92;
    }

    // Haze: the far rain as mist, thicker lower down and where a heavy sheet is.
    float low = smoothstep(0.15, 0.75, xy.y / size.y);
    float haze = (0.03 + 0.09 * low) * (0.25 + 1.2 * sheet);

    // Far off, now and then, light swells in the haze near the top and dies away: once in about
    // twenty seconds at most, slowly, and never bright. Only where the page is dark.
    float turn = floor(t / 19.0);
    float age = t - turn * 19.0 - 3.0 - 9.0 * hash(float2(turn, 5.0));
    float swell = step(0.5, hash(float2(turn, 9.0))) * smoothstep(0.0, 0.25, age) * exp(-max(age, 0.0) * 2.2)
        * (1.0 + 0.5 * sin(age * 9.0));
    float2 glowAt = (xy - size * float2(0.2 + 0.6 * hash(float2(turn, 2.0)), 0.08)) / size.x;
    float flicker = dark * 0.07 * swell * exp(-dot(glowAt, glowAt) * 2.5) * (0.5 + 0.7 * sheet);

    // A finger holds the rain off, as an umbrella would: a dry round space while it is down and
    // for a moment after, with drops breaking on its upper edge.
    float2 away = xy - touch;
    float far = length(away);
    float held = step(0.0, touch.x) * max(pressed, 1.0 - smoothstep(0.0, 1.2, touchAge));
    float dome = cell.y * 3.2;
    float dry = held * (1.0 - smoothstep(dome * 0.85, dome * 1.1, away.y > 0.0 ? abs(away.x) : far))
        * (1.0 - smoothstep(dome * 2.0, dome * 7.0, away.y));
    float spray = hash(float2(floor(atan(away.x, -away.y) * 14.0), floor(t * 14.0)));
    float rim = held * (1.0 - smoothstep(0.0, cell.y * 0.22, abs(far - dome))) * max(0.0, -away.y / max(far, 1.0))
        * (0.35 + 0.65 * step(0.55, spray));
    rain = rain * (1.0 - 0.92 * dry) + rim * 0.38;

    float cover = clamp(rain, 0.0, 1.0) * mix(0.9, 1.0, dark);
    cover = cover + (1.0 - cover) * clamp(haze * (1.0 - 0.6 * dry) + flicker, 0.0, 1.0);

    // Not over text: a pixel that differs from the page is text or a line.
    float d = min(length(here.rgb - float3(bg.rgb) * here.a), length(here.rgb - float3(surface.rgb) * here.a));
    cover *= 1.0 - clamp(d * 5.0, 0.0, 1.0);

    float3 color = mix(float3(info.rgb), float3(fg.rgb), 0.45 * dark);
    return half4(here * (1.0 - cover) + float4(color * cover, cover));
}
