// @name Snowfall
// @description Snow falls behind the text, for Christmas
// @suits dark good, light fair, wallpaper good
// @animated
// @param amount 0.0..2.0 = 1.0 Amount of snow
// @param size 0.5..1.5 = 1.0 Size of the flakes
//
// Five layers of flakes: the near ones are bigger and fall faster. The snow only shows where the
// background does, so text stays as it is. A touch blows the flakes away for a moment, and they
// drift to the side the phone leans to.

uniform shader content;
uniform float2 resolution;
uniform float time;
uniform float2 touch;
uniform float touchAge;
uniform float2 tilt;
uniform float dark;
layout(color) uniform half4 bg;
uniform float amount;
uniform float size;

// A number from 0 to 1 that looks random for each p (Dave Hoskins' hash without sine).
float hash(float2 p) {
    float3 q = fract(float3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

half4 main(float2 xy) {
    float4 here = float4(content.eval(xy));

    // Not over text: a pixel that differs from the background is text or a line. Where it differs
    // fully, there is nothing to draw.
    // Text and pictures (icons, photos, emoji) are opaque, and Kolahal draws the page a step under
    // opaque: a pixel at full alpha is covered, whatever its color, and the scene stays behind it.
    float text = max(clamp(length(here.rgb - float3(bg.rgb) * here.a) * 5.0, 0.0, 1.0), step(0.999, here.a));
    if (text >= 1.0) {
        return half4(here);
    }

    // The flakes move out of the way of a touch, and come back within about a second.
    float2 p = xy;
    if (touch.x >= 0.0) {
        float2 away = xy - touch;
        float far = max(length(away), 1.0);
        float gust = exp(-far / 220.0) * exp(-touchAge * 1.6);
        p = xy - away / far * gust * 90.0;
    }

    float snow = 0.0;
    for (int i = 0; i < 5; i++) {
        float n = float(i);

        // Cells of this layer, in columns across the screen. Nearer layers (small n) have bigger cells.
        float2 uv = p / (resolution.x / (6.0 + n * 4.0));

        // It falls, and the wind sways the whole layer.
        uv.y -= time * (0.95 - 0.11 * n);
        uv.x += 0.45 * sin(time * 0.35 + n * 1.9) + 0.10 * sin(time * 0.9 + uv.y * 0.7 + n);

        // A lean of the phone moves it aside, the near layers most: a place, not a speed, so it glides
        // there and back with the phone.
        uv -= tilt * (1.0 - 0.15 * n);

        // One flake in each cell, and about half of them are there (an amount of 1). Its place, size and sway are its own.
        // A flake's middle is at most 0.225 of a cell above or below the cell's middle, and its
        // radius at most 0.13 of a cell times the size: a pixel farther up or down misses it. So
        // does a pixel in a cell without a flake, or above or below the flake in its own cell.
        float2 at = fract(uv);
        if (abs(at.y - 0.5) >= 0.2251 + 0.1301 * size) {
            continue;
        }
        float2 id = floor(uv);
        float r1 = hash(id + n * 17.0);
        if (r1 < 1.0 - 0.45 * amount) {
            continue;
        }
        float radius = mix(0.05, 0.13, hash(id + n * 47.0 + 9.7)) * size;
        float2 center = 0.5 + (float2(0.0, hash(id + n * 59.0 + 2.4)) - 0.5) * 0.45;
        if (abs(at.y - center.y) >= radius) {
            continue;
        }
        center.x = 0.5 + (hash(id + n * 31.0 + 5.2) - 0.5) * 0.45;
        center.x += 0.10 * sin(time * 1.2 + r1 * 6.28);

        float d = length(at - center);
        float flake = 1.0 - smoothstep(radius * 0.35, radius, d);
        snow += flake * mix(0.95, 0.45, n / 4.0);
    }
    float cover = clamp(snow, 0.0, 1.0) * 0.9;
    // Less over the edges of text.
    cover *= 1.0 - text;

    // White on a dark theme, a cold blue on a light one, where white would not show.
    float3 color = mix(float3(0.43, 0.58, 0.80), float3(0.96, 0.98, 1.0), dark);
    float4 flakes = float4(color * cover, cover);
    return half4(here * (1.0 - cover) + flakes);
}
