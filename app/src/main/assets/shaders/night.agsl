// @name Night sky
// @description Stars behind the text that twinkle slowly, a pale band across the sky, and a meteor now and then; on a light theme, an engraved star chart
// @suits dark good, light fair, wallpaper fair
// @animated
//
// Two layers of stars, each a soft dot of a few pixels, never a single one. They only show where
// the page does. As the phone leans, the near stars shift a few pixels and the far ones less.
// On a light theme, where stars can't shine, it is a star chart engraved on the page: fine circles
// and hour lines, ink stars sized by brightness, and lines that join some into constellations.

uniform shader content;
uniform float2 resolution;
uniform float2 cell;
uniform float time;
uniform float2 tilt;
uniform float dark;
layout(color) uniform half4 bg;
layout(color) uniform half4 surface;
layout(color) uniform half4 fg;
layout(color) uniform half4 dim;
layout(color) uniform half4 info;
layout(color) uniform half4 warn;

// A number from 0 to 1 that looks random for each p (Dave Hoskins' hash without sine).
float hash(float2 p) {
    float3 q = fract(float3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

// Smooth noise from 0 to 1: the hash at the corners of a square, blended.
float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + float2(1.0, 0.0)), f.x),
               mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), f.x), f.y);
}

// A star of the chart: where it is in its square (xy), and how bright (z), or 0 for none.
float3 chartStar(float2 id) {
    float r1 = hash(id + 13.0);
    float r2 = hash(id + 32.1);
    float r3 = hash(id + 50.9);
    return float3(0.5 + (float2(r2, r3) - 0.5) * 0.5, step(0.5, r1) * (0.15 + 0.85 * r1 * r2));
}

// How far p is from the line between a and b, and 0 to 1 along it.
float2 toLine(float2 p, float2 a, float2 b) {
    float2 ab = b - a;
    float along = clamp(dot(p - a, ab) / max(dot(ab, ab), 0.0001), 0.0, 1.0);
    return float2(length(p - a - ab * along), along);
}

// The line of a constellation between two stars in neighbouring squares, where both are there and
// this pair is joined. It stops short of each star. p, a and b are in squares; the result is 0 to 1.
float joined(float2 p, float2 a, float3 sa, float2 b, float3 sb, float pair, float size, float unit) {
    float2 at = toLine(p, a + sa.xy, b + sb.xy);
    float line = 1.0 - smoothstep(unit * 0.35, unit * 0.9, at.x * size);
    float clear = smoothstep(0.12, 0.2, at.y) * (1.0 - smoothstep(0.8, 0.88, at.y));
    return line * clear * step(0.001, sa.z) * step(0.001, sb.z) * step(0.52, pair);
}

// The light theme's night: a star chart engraved on the page. Circles of declination and lines of
// the hour around a pole above the screen, stars as ink dots sized by brightness, the brightest
// ringed, and thin lines that join some into constellations. The amount of ink (a) and its color.
float4 chart(float2 xy, float t) {
    float unit = max(1.0, cell.y / 40.0);
    // The whole chart shifts a little as the phone leans.
    float2 p = xy - tilt * unit * 5.0;

    // The grid: around the pole, a circle every six rows and a line every 15 degrees.
    float2 fromPole = p - float2(resolution.x * 0.28, -resolution.x * 0.55);
    float far = length(fromPole);
    float every = cell.y * 6.0;
    float circle = abs(fract(far / every) - 0.5) * every;
    float turn = atan(fromPole.x, fromPole.y) / 0.2617994;
    float hour = abs(fract(turn) - 0.5) * 0.2617994 * far;
    float grid = 1.0 - smoothstep(unit * 0.3, unit * 0.9, min(circle, hour));
    // The path of the sun: one more circle, about another center, in dashes.
    float2 fromSun = p - float2(resolution.x * 1.5, resolution.x * 0.1);
    float sunFar = length(fromSun);
    float path = (1.0 - smoothstep(unit * 0.4, unit * 1.1, abs(sunFar - resolution.x * 1.25)))
        * step(0.4, fract(atan(fromSun.x, fromSun.y) * 40.0));

    // The stars, one square each, and the four squares beside this one for the lines between them.
    float size = cell.y * 3.4;
    float2 uv = p / size;
    float2 id = floor(uv);
    float3 own = chartStar(id);
    float3 right = chartStar(id + float2(1.0, 0.0));
    float3 left = chartStar(id - float2(1.0, 0.0));
    float3 below = chartStar(id + float2(0.0, 1.0));
    float3 above = chartStar(id - float2(0.0, 1.0));
    float lines = joined(uv, id, own, id + float2(1.0, 0.0), right, hash(id + 71.0), size, unit)
        + joined(uv, id - float2(1.0, 0.0), left, id, own, hash(id - float2(1.0, 0.0) + 71.0), size, unit)
        + joined(uv, id, own, id + float2(0.0, 1.0), below, hash(id + 97.0), size, unit)
        + joined(uv, id - float2(0.0, 1.0), above, id, own, hash(id - float2(0.0, 1.0) + 97.0), size, unit);

    // The star itself: a dot, and for the brightest a ring around it that breathes slowly.
    float d = length(uv - id - own.xy) * size;
    float radius = unit * (1.9 + 3.0 * own.z * own.z);
    float star = step(0.001, own.z) * (1.0 - smoothstep(radius - unit * 0.7, radius, d));
    float ringAt = radius * (2.3 + 0.2 * sin(t * 0.7 + own.x * 40.0));
    float ring = step(0.62, own.z) * (1.0 - smoothstep(unit * 0.3, unit * 0.9, abs(d - ringAt)));

    // Ink for the stars, and a blue-grey, fainter, for the grid and the lines between stars, so a
    // line that passes between two rows of text is never taken for part of it.
    float fine = clamp(grid * 0.10 + path * 0.16 + lines * 0.30, 0.0, 0.34);
    float ink = clamp(star * 0.80 + ring * 0.55, 0.0, 0.85);
    float amount = fine * (1.0 - ink) + ink;
    float3 color = (mix(float3(dim.rgb), float3(info.rgb), 0.5) * fine * (1.0 - ink) + float3(fg.rgb) * ink) / max(amount, 0.001);
    return float4(color, amount);
}

half4 main(float2 xy) {
    float4 here = float4(content.eval(xy));

    // Time, wrapped where every twinkle repeats, so it stays exact when the shader is on for days.
    float t = mod(time, 6283.1853);

    // A light theme has the chart instead of the sky.
    if (dark < 0.5) {
        float4 ink = chart(xy, t);
        float page = min(length(here.rgb - float3(bg.rgb) * here.a), length(here.rgb - float3(surface.rgb) * here.a));
        float a = ink.a * (1.0 - clamp(page * 5.0, 0.0, 1.0));
        return half4(here * (1.0 - a) + float4(ink.rgb * a, a));
    }
    // The smallest star's radius, in pixels: more than one pixel on any screen.
    float unit = max(1.6, cell.y / 22.0);

    // The pale band: a strip across the screen from the lower left to the upper right, with clouds
    // in it. More stars are in it, too.
    float2 p = xy / resolution.x;
    float across = (p.y - 1.25 + 0.75 * p.x) * 0.8;
    float band = exp(-across * across / 0.03) * (0.45 + 0.55 * noise(p * 5.0 + 2.0));

    float stars = 0.0;
    float3 tint = float3(0.0);
    for (int i = 0; i < 2; i++) {
        float n = float(i);

        // Squares of this layer, each with at most one star, well inside it.
        float size = cell.y * (1.7 + 1.9 * n);
        // The big layer is the near one, so it shifts more when the phone leans.
        float2 uv = (xy - tilt * unit * (1.2 + 2.4 * n)) / size + n * float2(0.43, 0.71);
        float2 id = floor(uv);
        float r1 = hash(id + n * 13.0);
        float r2 = hash(id + n * 29.0 + 3.1);
        float r3 = hash(id + n * 43.0 + 7.9);

        // More squares have a star inside the band. The big layer has the brighter ones.
        float there = step(0.72 - 0.40 * band, r1);
        float radius = unit * (1.0 + 1.3 * n * r3 + 0.5 * r2);
        float2 center = 0.5 + (float2(r2, r3) - 0.5) * 0.5;
        float d = length(fract(uv) - center) * size;
        float star = 1.0 - smoothstep(radius * 0.45, radius, d);

        // Each twinkles at its own pace, never going out.
        float twinkle = 0.70 + 0.30 * sin(t * (0.6 + 1.6 * r3) + r1 * 6.28);
        float bright = there * star * twinkle * mix(0.55, 1.0, r2 * r2);
        stars += bright;
        // Most are white, some a little blue or yellow.
        tint += bright * mix(mix(float3(info.rgb), float3(warn.rgb), step(0.5, r3)), float3(fg.rgb), 0.3 + 0.7 * step(r2, 0.6));
    }

    // A meteor in the top of the sky, for the first second of every eleven: a short streak whose
    // head runs down and to the left.
    float turn = floor(t / 11.0);
    float age = fract(t / 11.0) * 11.0;
    float2 start = resolution * float2(0.35 + 0.6 * hash(float2(turn, 1.0)), 0.04 + 0.22 * hash(float2(turn, 2.0)));
    float2 way = normalize(float2(-0.80, 0.60));
    float2 rel = xy - start - way * age * resolution.x * 0.55;
    float along = -dot(rel, way);
    float aside = abs(dot(rel, float2(-way.y, way.x)));
    float tail = cell.y * 5.0;
    float meteor = step(0.0, along) * step(along, tail) * (1.0 - along / tail)
        * (1.0 - smoothstep(unit * 0.4, unit * 1.2, aside)) * (1.0 - smoothstep(0.5, 0.9, age));

    // The stars in their colors, the meteor white; the band is only a breath of color.
    float dots = clamp(stars + meteor, 0.0, 1.0) * 0.95;
    float haze = band * 0.09;
    float amount = haze * (1.0 - dots) + dots;
    float3 starColor = mix(float3(fg.rgb), tint / max(stars, 0.001), step(0.001, stars));
    float3 color = (float3(info.rgb) * haze * (1.0 - dots) + starColor * dots) / max(amount, 0.001);

    // Not over text: a pixel that differs from the page is text or a line.
    float d = min(length(here.rgb - float3(bg.rgb) * here.a), length(here.rgb - float3(surface.rgb) * here.a));
    amount *= 1.0 - clamp(d * 5.0, 0.0, 1.0);
    return half4(here * (1.0 - amount) + float4(color * amount, amount));
}
