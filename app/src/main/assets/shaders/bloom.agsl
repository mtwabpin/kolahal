// @name Bloom
// @description A soft halo around text and lines, in their own colors
//
// On a dark theme a glow, on a light one a faint shadow of the ink.

uniform shader content;
uniform float2 resolution;
uniform float2 cell;
uniform float dark;
layout(color) uniform half4 bg;

// A pixel of home, kept inside the picture.
float4 pixel(float2 p) {
    return float4(content.eval(clamp(p, float2(0.5), resolution - float2(0.5))));
}

// What a pixel differs from the background by: its ink, none where the background shows.
float3 ink(float2 p) {
    float4 c = pixel(p);
    return c.rgb - float3(bg.rgb) * c.a;
}

half4 main(float2 xy) {
    float4 here = pixel(xy);

    // Sixteen pixels around, on a spiral, the near ones counting more.
    float3 halo = float3(0.0);
    float total = 0.0;
    float reach = cell.y * 0.5;
    for (int i = 0; i < 16; i++) {
        float t = (float(i) + 0.5) / 16.0;
        float angle = 2.399963 * float(i);
        float w = 1.0 - t;
        halo += ink(xy + reach * sqrt(t) * float2(cos(angle), sin(angle))) * w;
        total += w;
    }
    halo /= total;

    // The halo keeps its direction: brighter on a dark theme, darker on a light one.
    float3 color = clamp(here.rgb + halo * mix(0.35, 0.9, dark), float3(0.0), float3(1.0));
    float alpha = clamp(max(here.a, max(color.r, max(color.g, color.b))), 0.0, 1.0);
    return half4(float4(color, alpha));
}
