// @name Dunes
// @description A long dune crest after woodblock prints, with ranges of dunes and far mesas behind it and a caravan that climbs it once an hour. It follows the hour
// @suits dark good, light good, wallpaper poor
// @param camels 0..7 = 5 Camels in the caravan
//
// Flat shapes with one soft gradient each. Every dune has a long side against the wind and a short one
// behind it; one is in the light and the other in the shade, and they change places as the sun or the moon
// crosses the sky. The scene is measured by the screen's height, so a wider screen shows more of the
// desert. The lower part of the page is the theme's own, where the newest lines are.
//
// It stands still: it has no `time`, so it is drawn again once a minute, for the date, and when something it
// shows changes. The caravan's place is the minute of the hour.

uniform shader content;
uniform float2 resolution;
uniform float4 date;
uniform float dark;
uniform float wallpaper;
uniform float camels;
layout(color) uniform half4 bg;
layout(color) uniform half4 fg;
layout(color) uniform half4 dim;

// Where the plain begins, as a part of the height.
const float PLAIN = 0.392;

// The top of the long dune: across from the middle, in heights, and down from the top.
const float2 PEAK = float2(0.075, 0.318);

// A number from 0 to 1 that looks random for each n or p (Dave Hoskins' hashes without sine).
float hash(float n) {
    float p = fract(n * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

float hash2(float2 p) {
    float3 q = fract(float3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

// Smooth noise along a line, 0 to 1.
float noise1(float x) {
    float at = floor(x);
    float f = fract(x);
    return mix(hash(at), hash(at + 1.0), f * f * (3.0 - 2.0 * f));
}

// How much of morning, day, evening and night there is at hour h.
float4 hours(float h) {
    float morning = smoothstep(5.0, 6.3, h) * (1.0 - smoothstep(9.3, 10.7, h));
    float day = smoothstep(9.3, 10.7, h) * (1.0 - smoothstep(16.2, 17.3, h));
    float evening = smoothstep(16.2, 17.3, h) * (1.0 - smoothstep(18.9, 20.0, h));
    float4 w = float4(morning, day, evening, 0.0);
    w.w = 1.0 - w.x - w.y - w.z;
    return w;
}

// The hour's color, from those of morning, day, evening and night. For most of the day one of the four counts
// alone: then it is that one, and nothing is multiplied for the pixel.
float3 pick(float4 w, float3 a, float3 b, float3 c, float3 d) {
    if (w.y >= 1.0) return b;
    if (w.w >= 1.0) return d;
    if (w.x >= 1.0) return a;
    if (w.z >= 1.0) return c;
    return a * w.x + b * w.y + c * w.z + d * w.w;
}

// The page is this shader's where it is the background, and the theme's own lower down, where the log ends. As a
// live wallpaper, with no log over it, it is this shader's all the way down.
float ground(float y) {
    return y < 0.64 ? 0.80 * clamp((y - 0.42) / 0.22, 0.0, 1.0) : 0.80 + 0.20 * clamp((y - 0.64) / 0.20, 0.0, 1.0);
}

// A dune's outline from its foot against the wind (0) over its top (at) to its foot behind it (1), 0 to 1:
// long and round on the way up, short and hollow on the way down.
float profile(float t, float at) {
    float a = t / at;
    float b = (t - at) / (1.0 - at);
    return t < at ? mix(a * a * (3.0 - 2.0 * a), a, 0.25) : (1.0 - b) * (1.0 - b);
}

// The way up a dune against the wind, from its foot (0) to its top (1): long and round.
float climb(float a) {
    return mix(a * a * (3.0 - 2.0 * a), a, 0.25);
}

// How near p is to the line from a to b.
float stroke(float2 p, float2 a, float2 b) {
    float2 ab = b - a;
    return length(p - a - ab * clamp(dot(p - a, ab) / dot(ab, ab), 0.0, 1.0));
}

// The line from a dune's top towards the viewer, which parts its two sides: how far it has swung at depth v,
// whose square root is root. n is the line's number.
float swing(float v, float root, float n) {
    float turn = 6.2832 * hash(n + 5.0);
    return sin(root * (3.2 + 2.0 * hash(n + 2.0)) + turn) * (0.35 + v) - sin(turn) * 0.35;
}

// Where a dune's top is between its two hollows (0 to 1), for dune number id of a row.
float topAt(float id, float seed) {
    return 0.52 + 0.22 * hash(id * 7.0 + seed);
}

// Where the top line of a row of dunes is at x = qx. base is the row's top line and tall its height, in parts of the
// screen's height; width is one dune's. Returns the line, the dune's number, where this place is between the
// dune's two hollows (0 to 1) and where the dune's top is.
float4 rowTop(float qx, float n, float base, float tall, float width) {
    float seed = n * 17.0;
    float x = qx / width + 3.93 * n + 40.0;
    float id = floor(x);
    float t = x - id;
    float at = topAt(id, seed);
    float high = (0.45 + 0.55 * hash(id * 3.0 + seed + 11.0)) * profile(t, at);
    return float4(base - tall * high - 0.35 * tall * (noise1(x * 0.37 + n) - 0.5), id, t, at);
}

// The sand of a row of dunes whose top line is top ([rowTop]). reach is how far down the row goes before it has
// faded into the haze; near is how much of the near colors it has, and ripples how clear the lines in its sand
// are. from is where the light is (1 from the right, -1 from the left).
float3 rowSand(float3 color, float2 q, float y, float4 top, float n, float width, float reach, float near,
    float ripples, float from, float px, float3 lit, float3 shade, float3 haze, float4 warm, float4 under) {
    float topLine = top.x;
    float cover = clamp((y - topLine) / px + 0.5, 0.0, 1.0);
    if (cover > 0.0) {
        float seed = n * 17.0;
        float id = top.y;
        float t = top.z;
        float at = top.w;
        float v = (y - topLine) / reach;
        float root = sqrt(max(v, 0.0));
        // The crest's line swings as it comes towards the viewer, and so do the lines in the two hollows.
        float crest = at + (0.10 + 0.12 * near) * swing(v, root, id + n * 31.0);
        float left = 0.12 * swing(v, root, id + n * 31.0 + 0.5);
        float right = 1.0 + 0.12 * swing(v, root, id + 1.0 + n * 31.0 + 0.5);
        // Which side this is, and how far from its hollow (0) towards its crest (1). Past a hollow's line the
        // place belongs to the next dune's side.
        float lee, toCrest;
        if (t < left) {
            float before = topAt(id - 1.0, seed) + (0.10 + 0.12 * near) * swing(v, root, id - 1.0 + n * 31.0) - 1.0;
            lee = 1.0;
            toCrest = (left - t) / max(left - before, 0.001);
        } else if (t < crest) {
            lee = 0.0;
            toCrest = (t - left) / max(crest - left, 0.001);
        } else if (t < right) {
            lee = 1.0;
            toCrest = (right - t) / max(right - crest, 0.001);
        } else {
            float after = 1.0 + topAt(id + 1.0, seed) + (0.10 + 0.12 * near) * swing(v, root, id + 1.0 + n * 31.0);
            lee = 0.0;
            toCrest = (t - right) / max(after - right, 0.001);
        }
        toCrest = clamp(toCrest, 0.0, 1.0);
        // Each side is at its own color at the crest; the two meet in the hollow and grow alike down the dune.
        float apart = toCrest * toCrest * (1.0 - smoothstep(0.30, 0.95, v));
        float bright = 0.5 + mix(-0.5, 0.5, lee) * from * (0.22 + 0.78 * apart) * (lee > 0.5 ? smoothstep(0.0, 0.05, toCrest) : 1.0);
        // The edge of the crest's line, one pixel soft.
        float edge = abs(t - crest) * width / px;
        if (edge < 1.5) bright = mix(0.5 + 0.5 * from * (t < crest ? -1.0 : 1.0), bright, 0.5 + edge / 3.0);
        if (ripples > 0.0 && v > 0.03 && v < 0.95) {
            // Lines across the wind on the side against it, near each other far off and wider apart nearby.
            float rows = 40.0 * sqrt(v + 0.02) + 1.1 * sin(q.x * 21.0 + 6.0 * v) + 0.5 * sin(q.x * 53.0 - 9.0 * v);
            float line = 0.4 - smoothstep(0.0, 0.20, abs(fract(rows) - 0.35)) + 0.6 * smoothstep(0.0, 0.30, abs(fract(rows + 0.32) - 0.35));
            float where = smoothstep(-0.6, 0.8, sin(q.x * 11.0 + 2.2 * sin(v * 9.0 + q.x * 6.0)));
            bright += line * where * ripples * smoothstep(0.03, 0.14, v) * (1.0 - smoothstep(0.55, 0.95, v)) * (1.0 - 0.8 * lee);
        }
        float3 sand = mix(mix(shade, lit, clamp(bright, 0.0, 1.15)), haze, mix(0.60, 0.34, near) * smoothstep(0.0, 1.0, v) + 0.22 * (1.0 - near));
        // A far row runs out into what is behind it. The nearest one ends in the ground's own color (under).
        float gone = smoothstep(0.60, 1.0, v);
        sand = mix(mix(sand, warm.rgb, 0.35 * warm.a * (1.0 - near)), under.rgb, under.a * gone);
        color = mix(color, sand, cover * (1.0 - gone * (1.0 - under.a)));
    }
    return color;
}

// One row of dunes far off, between y = base - tall and base + reach.
float3 row(float3 color, float2 q, float y, float n, float base, float tall, float width, float reach, float near,
    float from, float px, float3 lit, float3 shade, float3 haze, float4 warm) {
    if (y > base - tall - 0.02 && y < base + reach) {
        color = rowSand(color, q, y, rowTop(q.x, n, base, tall, width), n, width, reach, near, 0.0, from, px, lit, shade, haze, warm, float4(0.0));
    }
    return color;
}

// Mist in a long bar around y = at, from one x to another, with soft ends: where it is, from 0 to 1.
float mist(float2 q, float at, float thick, float from, float to) {
    float dy = (q.y - at) / thick;
    float sum = 0.0;
    if (abs(dy) < 1.6) {
        float ends = min(q.x - from, to - q.x) / (thick * 6.0);
        sum = exp(-dy * dy * 3.5) * smoothstep(0.0, 1.0, ends - dy * dy);
    }
    return sum;
}

// How much c, a pixel of what is drawn on the page, belongs to a picture rather than to text: 0 on the way
// from the page to the text's color or the dim text's, 1 away from both.
float picture(float3 c, float3 page, float3 ink, float3 faint) {
    float3 o = c - page;
    float3 a = ink - page;
    float3 b = faint - page;
    float off = min(length(o - a * clamp(dot(o, a) / max(dot(a, a), 0.0001), 0.0, 1.0)),
                    length(o - b * clamp(dot(o, b) / max(dot(b, b), 0.0001), 0.0, 1.0)));
    return smoothstep(0.015, 0.045, off);
}

half4 main(float2 xy) {
    // The wallpaper shows less of the scene's height, so less of its flat foot.
    float2 res = float2(resolution.x, resolution.y / mix(1.0, 0.78, wallpaper));
    float4 here = float4(content.eval(xy));
    float y = xy.y / res.y;
    if (y > 0.84 && wallpaper < 0.5) return half4(here);

    // Not over text: a pixel that differs from the background is text or a line. Faint text over the
    // scene gets more of its own contrast, up to the full text's, as the page behind it is busier now.
    float3 page = float3(bg.rgb) * here.a;
    float ink = length(here.rgb - page);
    float full = length(float3(fg.rgb) - float3(bg.rgb));
    float gain = 1.0 + (clamp(full * 0.85 / max(ink, 0.001), 1.0, 2.1) - 1.0) * (1.0 - ground(y) * (1.0 - wallpaper));
    // A picture keeps its own colors: only text, on the way from the page to its color, gets more
    // contrast. Where the gain is 1, and on the bare page, there is nothing to check.
    if (gain > 1.0 && ink > 0.008) gain = mix(gain, 1.0, picture(here.rgb, page, float3(fg.rgb) * here.a, float3(dim.rgb) * here.a));
    float3 letters = clamp(page + (here.rgb - page) * gain, 0.0, 1.0);
    // Text and pictures (icons, photos, emoji) are opaque, and Kolahal draws the page a step under
    // opaque: a pixel at full alpha is covered, whatever its color, and the scene stays behind it.
    float amount = (1.0 - clamp(ink * 5.0, 0.0, 1.0)) * (1.0 - step(0.999, here.a));
    if (amount <= 0.0) return half4(float4(letters, here.a));

    float h = date.w / 3600.0;
    float4 w = hours(h);

    // The scene is measured in heights from the middle of the screen, so a wider screen shows more of it.
    float small = min(res.x, res.y);
    float wide = res.x / res.y;
    float2 q = float2((xy.x - 0.5 * res.x) / res.y, y);
    float px = 1.0 / res.y;

    // The sun by day and the moon by night, each on its own arc, from left to right.
    bool moon = h < 5.5 || h > 19.5;
    float arc = moon ? (h > 12.0 ? h - 19.5 : h + 4.5) / 10.0 : (h - 5.5) / 14.0;
    float up = sin(3.1416 * clamp(arc, 0.0, 1.0));
    float low = moon ? 0.0 : 1.0 - smoothstep(0.25, 0.75, up);
    float r = 0.021 * mix(1.0, 1.28, low) * mix(1.0, 1.25, smoothstep(0.6, 1.6, wide));
    float span = min(0.36 * wide, 0.46);
    float2 sunAt = float2(mix(-span, span, arc), mix(0.365, 0.13, pow(up, 0.8)));
    float there = smoothstep(0.0, 0.10, up);
    float2 off = q - sunAt;
    float far = length(off);
    float halo = max(0.0, 1.0 - far / (4.5 * r));
    float shine = 0.0;
    if (y < 0.56) {
        float around = exp(-(off.x * off.x / 6.76 + off.y * off.y) / 0.0110);
        float peak = moon ? 0.16 : mix(0.40, 0.62, low);
        shine = clamp((peak * around + 0.35 * halo * halo * (moon ? 0.6 : 1.0)) * there * mix(1.0, 0.45, dark), 0.0, 1.0);
    }

    // The scene is worked out from the front: what a nearer dune hides is not drawn. First the nearest range's
    // top line, then the long dune's outline. It climbs from the left to its top and falls away behind it.
    bool nearHere = y > 0.422 && y < 0.832;
    float4 nearTop = float4(0.0);
    bool behind = false;
    if (nearHere) {
        nearTop = rowTop(q.x, 2.0, 0.532, 0.090, 0.740);
        behind = (y - nearTop.x) / px + 0.5 >= 1.0;
    }
    float dx = q.x - PEAK.x;
    float side = dx < 0.0 ? dx / 0.62 : dx / 0.33;
    float outline = PEAK.y + (dx < 0.0 ? 0.150 * (1.0 - climb(1.0 + max(side, -1.0))) : 0.132 * (1.0 - (1.0 - min(side, 1.0)) * (1.0 - min(side, 1.0))));
    float cover = clamp((y - outline) * res.y + 0.5, 0.0, 1.0);
    float shown = cover * (1.0 - smoothstep(0.78, 1.0, abs(side)));
    // Open: neither of the two hides this place, so the sky or the far dunes show here.
    bool open = !behind && shown < 1.0;

    // The hour's colors. A dark theme's hours are all dark, so its light text is readable. A light one's night
    // is a pale, moonlit one. The sky's own colors are worked out only where the sky can show.
    float3 sky = float3(0.0);
    float3 mid = float3(0.0);
    float3 horizonSky = float3(0.0);
    float3 haze, litFar, litNear, shadeFar, shadeNear;
    bool skyHere = open && y < PLAIN + 0.004;
    if (dark > 0.5) {
        if (skyHere) {
            sky = pick(w, float3(0.102, 0.141, 0.220), float3(0.086, 0.137, 0.180), float3(0.098, 0.102, 0.188), float3(0.039, 0.063, 0.137));
            mid = pick(w, float3(0.173, 0.173, 0.247), float3(0.129, 0.188, 0.220), float3(0.200, 0.149, 0.227), float3(0.086, 0.122, 0.227));
            horizonSky = pick(w, float3(0.294, 0.224, 0.239), float3(0.192, 0.227, 0.235), float3(0.318, 0.200, 0.200), float3(0.180, 0.231, 0.373));
        }
        haze = pick(w, float3(0.251, 0.227, 0.251), float3(0.204, 0.231, 0.235), float3(0.290, 0.188, 0.204), float3(0.220, 0.271, 0.404));
        litFar = pick(w, float3(0.294, 0.251, 0.251), float3(0.271, 0.255, 0.220), float3(0.345, 0.220, 0.192), float3(0.259, 0.318, 0.475));
        litNear = pick(w, float3(0.310, 0.243, 0.220), float3(0.286, 0.247, 0.204), float3(0.361, 0.220, 0.169), float3(0.235, 0.298, 0.455));
        shadeFar = pick(w, float3(0.165, 0.161, 0.212), float3(0.145, 0.173, 0.184), float3(0.188, 0.133, 0.180), float3(0.102, 0.141, 0.251));
        shadeNear = pick(w, float3(0.090, 0.094, 0.141), float3(0.075, 0.098, 0.110), float3(0.106, 0.075, 0.122), float3(0.047, 0.071, 0.141));
    } else {
        if (skyHere) {
            sky = pick(w, float3(0.722, 0.792, 0.871), float3(0.596, 0.761, 0.847), float3(0.557, 0.545, 0.718), float3(0.651, 0.706, 0.796));
            mid = pick(w, float3(0.906, 0.843, 0.859), float3(0.773, 0.867, 0.882), float3(0.863, 0.620, 0.627), float3(0.776, 0.780, 0.839));
            horizonSky = pick(w, float3(0.980, 0.851, 0.737), float3(0.945, 0.925, 0.835), float3(0.984, 0.757, 0.522), float3(0.886, 0.851, 0.847));
        }
        haze = pick(w, float3(0.980, 0.894, 0.827), float3(0.965, 0.933, 0.851), float3(0.965, 0.792, 0.675), float3(0.894, 0.863, 0.855));
        litFar = pick(w, float3(0.969, 0.847, 0.737), float3(0.953, 0.886, 0.757), float3(0.957, 0.729, 0.557), float3(0.863, 0.824, 0.804));
        litNear = pick(w, float3(0.957, 0.780, 0.596), float3(0.933, 0.820, 0.604), float3(0.922, 0.604, 0.396), float3(0.827, 0.765, 0.722));
        shadeFar = pick(w, float3(0.808, 0.741, 0.773), float3(0.855, 0.769, 0.659), float3(0.745, 0.573, 0.612), float3(0.682, 0.690, 0.757));
        shadeNear = pick(w, float3(0.612, 0.557, 0.655), float3(0.757, 0.612, 0.478), float3(0.573, 0.475, 0.612), float3(0.510, 0.533, 0.639));
    }
    float3 glow = pick(w, float3(1.000, 0.871, 0.682), float3(1.000, 0.957, 0.816), float3(1.000, 0.741, 0.463), float3(0.616, 0.706, 0.847));
    float3 disc = float3(0.0);
    if (!behind) disc = pick(w, float3(1.000, 0.949, 0.847), float3(1.000, 0.992, 0.949), float3(1.000, 0.890, 0.722), float3(0.910, 0.925, 0.957));

    // The light comes from the sun's or the moon's side: 1 from the right of a place, -1 from the left.
    float moonlight = moon ? 0.75 : 1.0;
    float from = (sunAt.x - q.x) / (abs(sunAt.x - q.x) + 0.06) * there * moonlight;
    float4 warm = float4(glow, shine);
    float3 ground1 = mix(haze, mix(shadeNear, litNear, 0.6), clamp((y - PLAIN) / 0.22, 0.0, 1.0) * 0.55);
    float3 color = haze;

    if (open) {
        // The sky: three colors from the top to the plain, and a deeper band along the very top, as prints have.
        float s = y / PLAIN;
        if (y < PLAIN + 0.002) {
            color = s < 0.55 ? mix(sky, mid, s / 0.55) : mix(mid, horizonSky, clamp((s - 0.55) / 0.45, 0.0, 1.0));
            color = mix(color, sky * mix(0.84, 0.66, dark), 0.42 * (1.0 - smoothstep(0.0, 0.16, y)) * (1.0 - smoothstep(0.0, 0.16, y)));
        }
        if (y < 0.56) color = mix(color, glow, shine);
        if (moon && dark > 0.5 && y < PLAIN) {
            // Small stars, fewer near the moon and the horizon.
            float2 cellAt = xy / (small * 0.052);
            float2 id = floor(cellAt);
            float bright = hash2(id);
            float2 star = fract(cellAt) - (0.2 + 0.6 * float2(hash2(id + 7.1), hash2(id + 3.7)));
            float dot1 = 1.0 - smoothstep(0.012, 0.036 + 0.02 * bright, length(star));
            color += disc * dot1 * step(0.62, bright) * 0.45 * (1.0 - smoothstep(0.5, 1.0, y / PLAIN)) * (1.0 - halo);
        }
        float face = clamp((r - far) * res.y + 0.5, 0.0, 1.0) * there;
        // The moon is a sickle: a part of its disc is the sky's.
        if (moon) face *= 1.0 - clamp((r * 0.92 - length(off - float2(r * 0.42, -r * 0.16))) * res.y + 0.5, 0.0, 1.0);
        color = mix(color, disc, face * mix(1.0, moon ? 0.86 : 0.66, dark));

        // Far off, mesas: flat-topped rock, pale, that only a wide screen has room for.
        if (y > 0.300 && y < PLAIN + 0.004) {
            float top = PLAIN;
            // Each: where it is, half its width at the top, how high.
            float3 rock1 = float3(-0.640, 0.105, 0.052);
            float3 rock2 = float3(-0.418, 0.020, 0.064);
            float3 rock3 = float3(0.705, 0.070, 0.040);
            float3 rock4 = float3(1.020, 0.150, 0.058);
            for (int i = 0; i < 4; i++) {
                float3 rock = i == 0 ? rock1 : i == 1 ? rock2 : i == 2 ? rock3 : rock4;
                float d = abs(q.x - rock.x) - rock.y;
                // A wall that leans a little, with an uneven top, and a slope of fallen rock at its foot.
                float wall = 1.0 - smoothstep(0.0, 0.10, d / rock.z);
                float foot = 1.0 - clamp(d / (rock.z * 2.4), 0.0, 1.0);
                float high = rock.z * max(wall * (0.94 + 0.06 * noise1(q.x * 34.0 + rock.x * 9.0)), 0.36 * foot * foot);
                top = min(top, PLAIN - high);
            }
            float rockHere = clamp((y - top) * res.y + 0.5, 0.0, 1.0);
            if (rockHere > 0.0) {
                float deep = clamp((y - top) / 0.06, 0.0, 1.0);
                float3 stone = mix(mix(horizonSky, shadeFar, 0.80), haze, 0.12 + 0.62 * deep);
                color = mix(color, mix(stone, glow, shine * 0.5), rockHere);
            }
        }

        // The plain.
        if (y > PLAIN - 0.004) color = mix(color, ground1, clamp((y - PLAIN) * res.y + 0.5, 0.0, 1.0));

        // Two ranges of dunes far off, each with bars of mist before it.
        if (y > 0.34 && y < 0.56) {
            color = row(color, q, y, 0.0, 0.401, 0.026, 0.150, 0.045, 0.12, from, px,
                mix(litFar, litNear, 0.12), mix(shadeFar, shadeNear, 0.12), haze, warm);
            float bar = mist(q, 0.4110, 0.0075, -0.56, -0.02) + mist(q, 0.4150, 0.0065, 0.18, 0.80);
            color = mix(color, mix(haze, glow, 0.25 * shine), 0.42 * clamp(bar, 0.0, 1.0));
            color = row(color, q, y, 1.0, 0.434, 0.056, 0.300, 0.110, 0.45, from, px,
                mix(litFar, litNear, 0.45), mix(shadeFar, shadeNear, 0.45), haze, warm);
            bar = mist(q, 0.4580, 0.0100, -0.06, 0.66) + mist(q, 0.4500, 0.0085, -0.98, -0.32);
            color = mix(color, mix(haze, glow, 0.25 * shine), 0.40 * clamp(bar, 0.0, 1.0));
        }

        // A caravan on its way up the long dune, against the sky: from its foot to near its top in an hour.
        float camel = 0.0062;
        if (camels > 0.5 && y < outline + 0.004 && y > outline - 0.030 && dx < 0.0) {
            float way = PEAK.x - 0.275 + fract(date.w / 3600.0) * 0.255;
            float box = (q.x - way) / camel;
            if (box < 4.0 && box > 1.2 - 5.2 * camels) {
                float n = clamp(floor(0.5 - box / 5.2), 0.0, camels - 1.0);
                float at = way - n * 5.2 * camel;
                float foot = PEAK.y + 0.150 * (1.0 - climb(1.0 + max((at - PEAK.x) / 0.62, -1.0)));
                float2 c = float2(q.x - at, foot - y) / (camel * (0.9 + 0.2 * hash(n + 4.0)));
                if (c.y > -0.5 && c.y < 2.4) {
                    // Each camel is in mid step, and in another one where the caravan is a minute later.
                    float gait = 0.22 * sin(way * 900.0 + n * 2.0);
                    float body = (length((c - float2(0.0, 1.08)) / float2(0.68, 0.36)) - 1.0) * 0.36;
                    body = min(body, (length((c - float2(-0.04, 1.42)) / float2(0.32, 0.28)) - 1.0) * 0.28);
                    body = min(body, stroke(c, float2(0.50, 1.08), float2(0.88, 1.14)) - 0.13);
                    body = min(body, stroke(c, float2(0.88, 1.14), float2(1.02, 1.70)) - 0.09);
                    body = min(body, stroke(c, float2(1.02, 1.70), float2(1.28, 1.64)) - 0.09);
                    body = min(body, stroke(c, float2(0.44, 0.95), float2(0.42 + gait, 0.0)) - 0.07);
                    body = min(body, stroke(c, float2(0.36, 0.95), float2(0.34 - gait, 0.0)) - 0.07);
                    body = min(body, stroke(c, float2(-0.46, 0.95), float2(-0.46 + gait, 0.0)) - 0.07);
                    body = min(body, stroke(c, float2(-0.54, 0.95), float2(-0.54 - gait, 0.0)) - 0.07);
                    color = mix(color, shadeNear, 0.92 * clamp(0.5 - body * camel * res.y, 0.0, 1.0));
                }
            }
        }
    }

    if (!behind) {
        // The long dune: its crest comes down from the top towards the viewer in a long bend.
        float vh = (y - PEAK.y) / 0.30;
        if (shown > 0.002) {
            // The crest: first away from the wind, then back across.
            float crest = PEAK.x - 0.20 * vh + 0.050 * sin(5.6 * sqrt(max(vh, 0.0))) * (0.3 + vh);
            float e = q.x - crest;
            float lee = smoothstep(-1.5 * px, 1.5 * px, e);
            float toSun = (sunAt.x - PEAK.x) / (abs(sunAt.x - PEAK.x) + 0.05) * there * moonlight;
            float light = clamp(0.5 + mix(-0.56, 0.56, lee) * toSun, 0.0, 1.0);
            float apart = exp(-abs(e) * mix(9.0, 4.0, clamp(vh, 0.0, 1.0))) * (1.0 - smoothstep(0.50, 1.0, vh));
            float bright = mix(0.50, light, 0.30 + 0.70 * apart);
            // Ripples against the wind: lines across it, near each other far off and wider apart nearby. Behind the
            // crest the sand has slid, and is smooth.
            float row1 = 44.0 * sqrt(vh + 0.02) + 1.1 * sin(q.x * 21.0 + 6.0 * vh) + 0.5 * sin(q.x * 53.0 - 9.0 * vh) + 4.0 * exp(-abs(e) * 16.0);
            float line = 0.4 - smoothstep(0.0, 0.20, abs(fract(row1) - 0.35)) + 0.6 * smoothstep(0.0, 0.30, abs(fract(row1 + 0.32) - 0.35));
            float where = smoothstep(-0.6, 0.8, sin(q.x * 11.0 + 2.2 * sin(vh * 9.0 + q.x * 6.0)));
            bright += line * where * 0.045 * smoothstep(0.04, 0.16, vh) * (1.0 - smoothstep(0.55, 0.95, vh)) * (1.0 - 0.8 * lee);
            float3 sand = mix(mix(mix(shadeFar, shadeNear, 0.7), mix(litFar, litNear, 0.7), clamp(bright, 0.0, 1.15)), haze, 0.62 * smoothstep(0.0, 0.9, vh));
            color = mix(color, sand, shown);
        }
    }

    // The nearest range, before the long dune's foot. It ends in the ground's own color.
    if (nearHere) {
        color = rowSand(color, q, y, nearTop, 2.0, 0.740, 0.300, 0.90, 0.07, from, px,
            mix(litFar, litNear, 0.92), mix(shadeFar, shadeNear, 0.92), haze, warm, float4(ground1, 1.0));
    }

    color = mix(color, float3(bg.rgb), ground(y) * (1.0 - wallpaper));
    // Dither, so the long gradients have no bands.
    color += (hash2(xy) - 0.5) / 255.0;

    return half4(float4(mix(letters, color, amount), mix(here.a, 1.0, amount)));
}
