// @name Pond
// @description A still pond under far hills, after woodblock prints, with rings of rain and a path of light that follows the hour
// @suits dark good, light good, wallpaper poor
// @animated
//
// Flat shapes with one soft gradient each, and their reflections. The lower part of the page is the theme's
// own, where the newest lines are.

uniform shader content;
uniform float2 resolution;
uniform float time;
uniform float4 date;
uniform float dark;
uniform float wallpaper;
layout(color) uniform half4 bg;
layout(color) uniform half4 fg;

// A number from 0 to 1 that looks random for each n or p (Dave Hoskins' hashes without sine).
float hash(float n) {
    float p = fract(n * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

float hash2(float2 p) {
    float3 q = fract(float3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

// Five octaves of value noise, 0 to 1: broad shapes with fine edges.
float noise(float x, float seed) {
    float sum = 0.0;
    float size = 0.516;
    for (int i = 0; i < 5; i++) {
        float at = floor(x);
        float f = fract(x);
        f = f * f * (3.0 - 2.0 * f);
        sum += size * mix(hash(at + seed), hash(at + 1.0 + seed), f);
        x = x * 2.0 + 7.3;
        size *= 0.5;
    }
    return sum;
}

// A slow breath: four seconds in, six out.
float breath(float t) {
    float p = mod(t, 10.0);
    return p < 4.0 ? 0.5 - 0.5 * cos(p * 0.7854) : 0.5 + 0.5 * cos((p - 4.0) * 0.5236);
}

// How much of morning, day, evening and night there is at hour h.
float4 hours(float h) {
    float morning = smoothstep(5.0, 6.3, h) * (1.0 - smoothstep(9.3, 10.7, h));
    float day = smoothstep(9.3, 10.7, h) * (1.0 - smoothstep(16.2, 17.3, h));
    float evening = smoothstep(16.2, 17.3, h) * (1.0 - smoothstep(18.9, 20.0, h));
    float4 w = float4(morning, day, evening, 0.0);
    w.w = 1.0 - w.x - w.y - w.z;
    return w;
}

// The hour's colors for the theme. A dark one keeps its light text readable: each hour is a night with
// that hour's color, darkened, in it. A light one has no dark sky: its night is a pale, moonlit one.
float4 themed(float4 w) {
    float4 deep = float4(w.xyz * 0.19, 1.0 - 0.60 * (w.x + w.y + w.z));
    float4 pale = float4(w.x + 0.50 * w.w, w.y + 0.10 * w.w, w.z + 0.32 * w.w, 0.08 * w.w);
    return dark > 0.5 ? deep : pale;
}

// A color of the scene at this hour: its morning, day, evening and night colors, weighed by w.
float3 tint(float4 w, float3 morning, float3 day, float3 evening, float3 night) {
    return morning * w.x + day * w.y + evening * w.z + night * w.w;
}

// The colors used in more than one place. Each is made only where a pixel needs it.
float3 discColor(float4 raw) {
    return tint(raw, float3(1.000, 0.953, 0.863), float3(1.000, 0.992, 0.949), float3(1.000, 0.902, 0.753), float3(0.910, 0.925, 0.957));
}

float3 glowColor(float4 raw) {
    return tint(raw, float3(1.000, 0.886, 0.722), float3(1.000, 0.965, 0.847), float3(1.000, 0.788, 0.541), float3(0.616, 0.706, 0.847));
}

float3 hazeColor(float4 w) {
    return tint(w, float3(0.980, 0.925, 0.886), float3(0.941, 0.965, 0.933), float3(0.965, 0.839, 0.769), float3(0.235, 0.314, 0.471));
}

float3 hillsColor(float4 w) {
    return tint(w, float3(0.643, 0.702, 0.800), float3(0.580, 0.722, 0.714), float3(0.651, 0.549, 0.643), float3(0.133, 0.192, 0.314));
}

// Text is dark on a light theme: the woods are paler there.
float3 woodsColor(float4 w) {
    float3 r3 = tint(w, float3(0.373, 0.502, 0.576), float3(0.353, 0.541, 0.471), float3(0.373, 0.345, 0.498), float3(0.075, 0.122, 0.212));
    return mix(r3, hazeColor(w), mix(0.38, 0.0, dark));
}

float3 nearColor(float4 w) {
    return tint(w, float3(0.278, 0.416, 0.447), float3(0.267, 0.439, 0.361), float3(0.259, 0.275, 0.404), float3(0.051, 0.090, 0.165));
}

// The far hills' height above the shore, as a part of the page's height, at x across.
float hillAt(float x) {
    return 0.03 + 0.085 * smoothstep(0.25, 0.85, noise(x * 3.4, 17.0));
}

// The woods' height, with two rows of round crowns along their top.
float woodAt(float2 xy, float x, float small, float pixel, float b) {
    float crowns = 0.0;
    for (int i = 0; i < 2; i++) {
        float n = float(i);
        float width = small * (0.026 - 0.009 * n);
        float at = xy.x / width + n * 0.5;
        float id = floor(at);
        float f = at - id;
        for (int j = -1; j <= 1; j++) {
            // A crown is at most 0.9 of a cell wide each way from its middle, which is 0.3 to 0.7 into its cell.
            if ((j < 0 && f >= 0.6) || (j > 0 && f <= 0.4)) continue;
            float c = id + float(j);
            float radius = width * (0.55 + 0.35 * hash(c + 71.0 * n));
            float dx = (at - c - 0.5 - 0.4 * (hash(c * 1.7 + 5.0) - 0.5)) * width;
            crowns = max(crowns, sqrt(max(0.0, radius * radius - dx * dx)));
        }
    }
    return (0.006 + 0.030 * smoothstep(0.3, 0.8, noise(x * 9.0, 91.0)) + crowns * pixel * 0.8) * (1.0 + 0.14 * b);
}

// The page is this shader's where it is the background, and the theme's own lower down, where the log ends. As a
// live wallpaper, with no log over it, it is this shader's all the way down.
float ground(float y) {
    return y < 0.64 ? 0.80 * clamp((y - 0.42) / 0.22, 0.0, 1.0) : 0.80 + 0.20 * clamp((y - 0.64) / 0.20, 0.0, 1.0);
}

half4 main(float2 xy) {
    // The wallpaper shows less of the scene's height, so less of its flat foot.
    float2 res = float2(resolution.x, resolution.y / mix(1.0, 0.74, wallpaper));
    float4 here = float4(content.eval(xy));
    float y = xy.y / res.y;
    if (y > 0.84 && wallpaper < 0.5) return half4(here);

    // Not over text: a pixel that differs from the background is text or a line. Faint text over the
    // scene gets more of its own contrast, up to the full text's, as the page behind it is busier now.
    float3 page = float3(bg.rgb) * here.a;
    float ink = length(here.rgb - page);
    float full = length(float3(fg.rgb) - float3(bg.rgb));
    float gain = 1.0 + (clamp(full * 0.85 / max(ink, 0.001), 1.0, 2.1) - 1.0) * (1.0 - ground(y) * (1.0 - wallpaper));
    float3 letters = clamp(page + (here.rgb - page) * gain, 0.0, 1.0);
    float amount = 1.0 - clamp(ink * 5.0, 0.0, 1.0);
    if (amount <= 0.0) return half4(float4(letters, here.a));

    float4 raw = hours(date.w / 3600.0);
    float4 w = themed(raw);
    const float SHORE = 0.33;

    // The sun by day and the moon by night, each on its own arc, from left to right.
    float h = date.w / 3600.0;
    bool moon = h < 5.5 || h > 19.5;
    float arc = moon ? (h > 12.0 ? h - 19.5 : h + 4.5) / 10.0 : (h - 5.5) / 14.0;
    float up = sin(3.1416 * clamp(arc, 0.0, 1.0));
    float low = moon ? 0.0 : 1.0 - smoothstep(0.25, 0.75, up);
    float small = min(res.x, res.y);
    float r = small * mix(0.050, 0.064, low);
    float2 sunAt = float2(mix(0.60, 0.84, arc) * res.x, mix(0.315, 0.13, pow(up, 0.8)) * res.y);
    float there = smoothstep(0.0, 0.10, up);
    float pixel = 1.0 / res.y;
    float night = dark > 0.5 ? 1.0 : 0.0;
    float b = breath(time) * 0.7;

    // The hills and the woods are needed only near the shore, for themselves and for their reflections. The
    // hills are at most 0.115 of the page tall and the woods at most woodTop, less a pixel of soft edge.
    float above = SHORE - y;
    float x = xy.x / max(res.x, 1.3 * res.y);
    float hillTop = 0.116 + pixel;
    float woodTop = (0.037 + 0.019 * small * pixel) * 1.1 + pixel;
    // Above the shore, how far up the pixel is; below it, how far up its reflection is, flipped and three
    // quarters as tall.
    float mirrored = -above / 0.75;
    float reach = y < SHORE ? above : mirrored;
    float wood = 0.0;
    if (reach < woodTop) wood = woodAt(xy, x, small, pixel, b);
    // How much the woods and the hills cover a pixel above the shore. Where either covers it all, nothing
    // behind it shows: the hills aren't needed where the woods cover them.
    float woodCover = y < SHORE ? clamp((wood - above) / pixel + 0.5, 0.0, 1.0) : 0.0;
    float hill = 0.0;
    if (reach < hillTop && woodCover < 1.0) hill = hillAt(x);
    float hillCover = clamp((hill - above) / pixel + 0.5, 0.0, 1.0);

    float3 color;
    if (y < SHORE) {
        float s = y / SHORE;
        float3 sky = tint(w, float3(0.788, 0.847, 0.902), float3(0.663, 0.796, 0.878), float3(0.604, 0.627, 0.769), float3(0.043, 0.071, 0.149));
        float3 mid = tint(w, float3(0.902, 0.875, 0.894), float3(0.812, 0.886, 0.902), float3(0.890, 0.718, 0.706), float3(0.086, 0.129, 0.239));
        float3 horizonSky = tint(w, float3(0.973, 0.863, 0.784), float3(0.933, 0.941, 0.875), float3(0.965, 0.812, 0.624), float3(0.145, 0.212, 0.353));
        color = s < 0.55 ? mix(sky, mid, s / 0.55) : mix(mid, horizonSky, clamp((s - 0.55) / 0.45, 0.0, 1.0));

        if (hillCover < 1.0 && woodCover < 1.0) {
            float2 off = xy - sunAt;
            float far = length(off);
            float wide = exp(-(off.x * off.x / 6.76 + off.y * off.y) / (res.y * res.y * 0.0110));
            float peak = moon ? 0.16 : mix(0.40, 0.62, low);
            float halo = max(0.0, 1.0 - far / (4.5 * r));
            float shine = (peak * wide + 0.35 * halo * halo * (moon ? 0.6 : 1.0)) * there * mix(1.0, 0.45, dark);
            color = mix(color, glowColor(raw), clamp(shine, 0.0, 1.0));
            if (moon && dark > 0.5) {
                // Small stars, fewer near the moon and the horizon. A cell has one only if its number is 0.62 or more.
                float2 cellAt = xy / (small * 0.052);
                float2 id = floor(cellAt);
                float s = hash2(id);
                if (s >= 0.62) {
                    float2 star = fract(cellAt) - (0.2 + 0.6 * float2(hash2(id + 7.1), hash2(id + 3.7)));
                    float dot1 = 1.0 - smoothstep(0.012, 0.036 + 0.02 * s, length(star));
                    color += discColor(raw) * dot1 * 0.45 * (1.0 - smoothstep(0.5, 1.0, y / SHORE)) * (1.0 - halo);
                }
            }
            float face = clamp(r - far + 0.5, 0.0, 1.0) * there;
            if (face > 0.0) {
                float3 facing = discColor(raw);
                if (moon) {
                    // Very faint patches.
                    float2 m = off / r;
                    float patches = smoothstep(0.62, 0.10, length((m - float2(-0.26, -0.22)) * float2(0.8, 1.2))) + smoothstep(0.40, 0.06, length((m - float2(0.12, 0.02)) * float2(1.3, 0.9)))
                        + 0.7 * smoothstep(0.40, 0.05, length((m - float2(0.34, 0.40)) * float2(0.9, 1.4)));
                    facing *= 1.0 - 0.022 * clamp(patches, 0.0, 1.0);
                }
                color = mix(color, facing, face * mix(1.0, moon ? 0.92 : 0.75, dark));
            }

            // A small flock now and then, level with the sun, flapping and gliding.
            float slot = floor(time / 46.0);
            float when = time - slot * 46.0;
            float side = hash(slot + 11.0) < 0.5 ? 1.0 : -1.0;
            float across = when / 27.0 * 1.4 - 0.2;
            float2 flock = float2((side > 0.0 ? across : 1.0 - across) * res.x,
                sunAt.y + (hash(slot + 3.0) - 0.3) * 0.06 * res.y - 0.02 * res.y * sin(across * 2.4));
            float wing = small * 0.017;
            if (hash(slot + 29.0) < 0.75 && abs(xy.x - flock.x) < wing * 11.0 && abs(xy.y - flock.y) < wing * 7.0) {
                float birds = 0.0;
                for (int i = 0; i < 5; i++) {
                    float n = float(i);
                    float own = hash(slot * 7.0 + n);
                    float2 b = (xy - flock - float2((n - 2.0) * 3.4 + own * 1.6, abs(n - 2.0) * 1.7 + own * 2.2) * wing * float2(-side, 1.0))
                        / (wing * (0.75 + 0.35 * own));
                    float a = abs(b.x);
                    float flap = smoothstep(-0.1, 0.6, sin(time * 0.9 + n * 1.3)) * sin(time * (6.0 + own) + n * 2.0);
                    float line = -(0.42 + 0.42 * flap) * (1.7 * a - 1.0 * a * a) + 0.18;
                    float thick = 0.13 * (1.0 - 0.8 * a);
                    birds = max(birds, step(a, 1.0) * (1.0 - smoothstep(thick * 0.6, thick + 0.06, abs(b.y - line))));
                }
                color = mix(color, nearColor(w), birds * 0.75);
            }
        }

        if (hillCover > 0.0) {
            color = mix(color, mix(hazeColor(w), hillsColor(w), mix(0.55, 1.0, clamp(above / max(hill, 0.001), 0.0, 1.0))), hillCover);
        }
        if (woodCover > 0.0) {
            color = mix(color, mix(hazeColor(w), woodsColor(w), mix(0.70, 1.0, clamp(above / max(wood, 0.001), 0.0, 1.0))), woodCover);
        }
    } else {
        float deep = (y - SHORE) / (1.0 - SHORE);
        float3 water1 = tint(w, float3(0.941, 0.863, 0.816), float3(0.875, 0.914, 0.875), float3(0.941, 0.804, 0.690), float3(0.133, 0.188, 0.310));
        float3 water2 = tint(w, float3(0.812, 0.859, 0.890), float3(0.725, 0.827, 0.847), float3(0.788, 0.706, 0.741), float3(0.063, 0.102, 0.188));
        float3 water3 = tint(w, float3(0.718, 0.792, 0.847), float3(0.639, 0.765, 0.800), float3(0.663, 0.639, 0.741), float3(0.047, 0.078, 0.157));
        color = deep < 0.3 ? mix(water1, water2, deep / 0.3) : mix(water2, water3, (deep - 0.3) / 0.7);

        // Reflections.
        if (mirrored < hillTop) {
            color = mix(color, hillsColor(w), 0.30 * clamp((hill - mirrored) / pixel * 0.5 + 0.5, 0.0, 1.0));
        }
        if (mirrored < woodTop) {
            color = mix(color, woodsColor(w), 0.50 * clamp((wood - mirrored) / pixel * 0.5 + 0.5, 0.0, 1.0));
        }

        // Fine streaks of light: short and packed far off, longer nearby.
        float rows = sqrt(deep) * 46.0;
        float row = floor(rows);
        float middle = (row + 0.2 + 0.6 * hash(row * 3.1)) / 46.0;
        float rowY = SHORE + middle * middle * (1.0 - SHORE);
        float reach = res.x * mix(0.03, 0.30, clamp(middle * 1.3, 0.0, 1.0));
        float line = 1.0 - smoothstep(0.4, 1.3, abs(y - rowY) / pixel);
        if (line > 0.0) {
            float streaks = 0.0;
            for (int i = 0; i < 2; i++) {
                float n = float(i);
                float mid2 = hash(row * 5.3 + n * 17.0) * res.x + 3.0 * sin(time * 0.25 + row);
                streaks = max(streaks, 1.0 - smoothstep(0.6, 1.0, abs(xy.x - mid2) / reach));
            }
            color = mix(color, float3(1.0), line * streaks * mix(0.35, 0.06, night));
        }

        // The path of light under the sun or the moon: a soft glow, and glints that twinkle and sway.
        // A glint is a short line on its row: a pixel farther from the row's middle than thick has none.
        float path = 1.0 - smoothstep(0.54, 0.66, y);
        if (path > 0.0 && there > 0.0) {
            float spread = r * (1.0 + 7.0 * deep);
            float away = (xy.x - sunAt.x) / spread;
            float shine = exp(-away * away * 0.7) * path * there;
            color = mix(color, glowColor(raw), shine * mix(0.30, 0.10, night) * (moon ? 0.7 : 1.0));
            float grow = sqrt(deep) * 34.0;
            float step1 = floor(grow);
            float at = (step1 + 0.5) / 34.0;
            float glintY = SHORE + at * at * (1.0 - SHORE);
            float thick = 1.2 + 5.0 * deep;
            if (abs(y - glintY) / pixel < thick) {
                float own = hash(step1 * 2.3 + 40.0);
                float twinkle = 0.5 + 0.5 * sin(time * 6.2832 / mix(3.5, 10.0, own) + own * 40.0);
                float sway = (1.0 + 5.0 * own) * sin(time * 0.5 + own * 20.0);
                float half1 = spread * mix(0.25, 0.85, hash(step1 * 7.7 + 2.0));
                float2 g = float2(max(0.0, abs(xy.x - sunAt.x - sway - (hash(step1 * 4.1) - 0.5) * spread * 0.9) - half1), (y - glintY) / pixel);
                float glint = 1.0 - smoothstep(thick * 0.6, thick, length(g));
                color = mix(color, discColor(raw), glint * twinkle * exp(-away * away * 0.5) * path * there * mix(0.85, 0.45, night) * (1.0 - 0.5 * deep));
            }
        }

        // Rings of rain, in perspective. A drop falls no lower than 0.632 of the page, and its rings reach at most
        // 0.052 of the page's smaller side above and below it. A drop is tested first for its row, then for
        // its age, then for its place across.
        if (y < 0.64 + 0.052 * small / res.y) {
            float rings = 0.0;
            for (int i = 0; i < 5; i++) {
                float id = floor(time / 0.82) - float(i);
                float e = mod(id, 4096.0);
                float dropY = SHORE + 0.012 + (0.62 - SHORE) * pow(hash(e + 9.0), 1.4);
                float dropDeep = (dropY - SHORE) / (1.0 - SHORE);
                float flat1 = 0.16 + 0.30 * dropDeep;
                float2 q = float2(0.0, (y - dropY) * res.y);
                q.y /= flat1;
                if (abs(q.y) >= small * mix(0.035, 0.13, dropDeep + 0.3) * 1.1) continue;
                float age = time - (id + 0.8 * hash(e + 5.0)) * 0.82;
                if (age <= 0.0 || age >= 3.72) continue;
                float most = small * mix(0.035, 0.13, dropDeep + 0.3 * hash(e + 33.0));
                q.x = xy.x - hash(e + 21.0) * res.x;
                float l = length(q);
                if (l < most * 1.1) {
                    for (int j = 0; j < 3; j++) {
                        float a = age - 0.26 * float(j);
                        if (a > 0.0 && a < 3.2) {
                            float thin = mix(1.0, flat1, abs(q.y) / max(l, 1.0));
                            rings += (1.0 - smoothstep(0.5, 1.5, abs(l - most * sqrt(a / 3.2)) * thin)) * (1.0 - a / 3.2) * (1.0 - 0.25 * float(j));
                        }
                    }
                }
            }
            if (rings > 0.0) {
                color = mix(color, night > 0.5 ? float3(0.66, 0.75, 0.92) : nearColor(w), clamp(rings, 0.0, 1.0) * mix(0.30, 0.38, night));
            }
        }

        // The hairline of light along the shore.
        color = mix(color, float3(1.0), (1.0 - smoothstep(0.5, 1.8, (y - SHORE) / pixel)) * mix(0.45, 0.08, night));
    }

    // The foot: the theme's color over the log, and a quiet one of the scene's own in the wallpaper.
    // In the wallpaper the upper half of the screen has none of it.
    float under = mix(ground(y), mix(0.70, 0.80, dark) * smoothstep(0.50, 1.0, xy.y / resolution.y), wallpaper);
    if (under > 0.0) {
        float3 foot = float3(bg.rgb);
        if (wallpaper > 0.0) {
            foot = mix(foot, mix(mix(hazeColor(w), float3(0.94, 0.92, 0.89), 0.4), mix(float3(0.059, 0.086, 0.149), nearColor(w), 0.55), dark), wallpaper);
        }
        color = mix(color, foot, under);
    }
    // Dither, so the long gradients have no bands.
    color += (hash2(xy) - 0.5) / 255.0;

    return half4(float4(mix(letters, color, amount), mix(here.a, 1.0, amount)));
}
