<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. To the cloud, settings (shared prefs) are backed up; the databases are
    not: kolahal.db holds the terminal log (which can contain other apps' notification text), script
    key-value data, the notification mirror and the log's marks; feeds.db is just a re-fetchable cache.
    The "logs" prefs held those marks before 0.5.8, and a backup from before still brings them. A transfer from your old phone to your new one, over a cable or
    Wi-Fi, carries those too: your scripts, todos, notes, reminders and feeds are in them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="kolahal.db" />
        <exclude domain="database" path="kolahal.db-journal" />
        <exclude domain="database" path="kolahal.db-wal" />
        <exclude domain="database" path="kolahal.db-shm" />
        <exclude domain="database" path="feeds.db" />
        <exclude domain="database" path="feeds.db-journal" />
        <exclude domain="database" path="feeds.db-wal" />
        <exclude domain="database" path="feeds.db-shm" />
        <!-- The scripts' work queue: a waiting @on notification run holds that notification's text. -->
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-journal" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="sharedpref" path="logs.xml" />
        <!-- Which apps you open and when, and how often you unlock: not for the cloud. -->
        <exclude domain="sharedpref" path="app_usage.xml" />
        <exclude domain="sharedpref" path="unlocks.xml" />
        <!-- The Play build's picked contacts: names and numbers stay on the phone. -->
        <exclude domain="sharedpref" path="picked_contacts.xml" />
        <!-- wallpaper match's wallpaper id: another phone's same number is someone's own wallpaper. -->
        <exclude domain="sharedpref" path="wallpaper_match.xml" />
        <!-- Saved notification icons: their names are the apps that notify you. -->
        <exclude domain="file" path="notif-icons/" />
        <!-- Crash reports belong to this phone. -->
        <exclude domain="file" path="crash/" />
        <exclude domain="sharedpref" path="crash.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- The scripts' work queue: a waiting @on notification run holds that notification's text. -->
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-journal" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <!-- wallpaper match's wallpaper id: another phone's same number is someone's own wallpaper. -->
        <exclude domain="sharedpref" path="wallpaper_match.xml" />
        <!-- Crash reports belong to this phone. -->
        <exclude domain="file" path="crash/" />
        <exclude domain="sharedpref" path="crash.xml" />
    </device-transfer>
</data-extraction-rules>
