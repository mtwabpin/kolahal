<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- call / sms / contacts commands (optional; asked for on first use). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- agenda command (optional; asked for on first use). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- calls in the log and the calls command (optional; asked for on first use). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- timer / alarm commands hand off to the clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- remind: on-time reminders (user-revocable on Android 12+; falls back to inexact) and re-arming after reboot. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- A script's daily time runs in the foreground for its few seconds (a short service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- update install: hands a new release to Android's installer. Not in the Play build. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Swipe down on the header opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Lets the default launcher see the Android 15+ private space profile. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <!-- Device controls: dnd / ring silent (user grants DND access), Wi-Fi state for 'toggles'. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- `wallpaper theme`: only once asked, only the home screen's, and only while it's the one Kolahal set. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- brightness / rotate / screen-timeout (user allows "Modify system settings"). -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- A one-off shader over the app in front (user allows "Display over other apps"). Not in the Play build. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Lets the home screen show an accurate unlock count (user grants it in Settings). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Widget providers (the picker lists every installed one). -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- Other home apps: usage counts their time, and can name them. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kolahal"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|assetsPaths"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The text editor, for any text file on the phone. It is not a screen of the launcher's
             task, which is cleared on Home and kept out of Recents: a file open there would be lost.
             - taskAffinity: a task of its own.
             - documentLaunchMode: each file is its own task, named after the file in Recents.
               Opening a file that is open already brings its task back as it was (intoExisting).
             - Other apps reach it through "Open with", for a text file they share as a content: address.
             It needs no storage permission: it reads and writes only the file that the file picker
             or the sharing app gave it. -->
        <activity
            android:name=".ui.TextEditorActivity"
            android:exported="true"
            android:label="@string/editor_name"
            android:taskAffinity="${applicationId}.editor"
            android:documentLaunchMode="intoExisting"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|assetsPaths"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-javascript" />
                <data android:mimeType="application/x-lua" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/toml" />
                <data android:mimeType="application/sql" />
            </intent-filter>
        </activity>

        <!-- A shader as the live wallpaper (Android 13 and newer), in a process of its own: one that crashes doesn't take home along. -->
        <service
            android:name=".ui.wallpaper.ShaderWallpaper"
            android:enabled="@bool/shader_wallpaper"
            android:exported="true"
            android:label="@string/shader_wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER"
            android:process=":wallpaper">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/shader_wallpaper" />
        </service>

        <!-- Scripts (Lua / QuickJS) run here so a native crash can never take down the home screen. -->
        <service
            android:name="androidx.work.multiprocess.RemoteWorkerService"
            android:exported="false"
            android:process=":script" />

        <!-- Optional notification feed (user grants access in system settings). -->
        <service
            android:name=".notifications.KolahalNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Optional: double-tap to lock (performGlobalAction only; reads nothing). -->
        <service
            android:name=".gesture.LockService"
            android:exported="false"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>

        <!-- remind: fires a reminder (only our own AlarmManager PendingIntents reach it). -->
        <receiver
            android:name=".productivity.ReminderReceiver"
            android:exported="false" />

        <!-- The reminder notification's Snooze and Done buttons. -->
        <receiver
            android:name=".productivity.ReminderActionReceiver"
            android:exported="false" />

        <!-- remind and scripts' daily times: re-arms their alarms after a reboot or update, and when
             exact alarms are allowed. -->
        <receiver
            android:name=".productivity.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- A script's daily time (only our own AlarmManager PendingIntents reach it). -->
        <receiver
            android:name=".script.ScriptAlarmReceiver"
            android:exported="false" />
        <!-- Remove cached update APKs after the new version is installed. -->
        <receiver
            android:name=".terminal.UpdateCleanupReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A script's run at its daily time, in the foreground for its few seconds: Android lets a
             launcher pause the work profile only in front. In :script, with the other runs. -->
        <service
            android:name=".script.ScriptRunService"
            android:exported="false"
            android:foregroundServiceType="shortService"
            android:process=":script" />

        <!-- A script's own screen (tty.screen): home binds it to pass the taps and frames of a screen that
             runs in :script, where the script runs. Only this app can bind it. -->
        <service
            android:name=".script.ScriptScreenService"
            android:exported="false"
            android:process=":script" />

        <!-- WorkManager is initialised manually via Configuration.Provider (multi-process setup). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- Shares downloaded update APKs with Android's package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
